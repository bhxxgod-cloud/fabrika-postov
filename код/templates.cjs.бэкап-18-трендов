  'img-bmw-photo': { kind: 'art', frame2: 'art', frame4source: 'frame2', phone: false, hooks: 'neutral', tags: 'beauty', family: 'bmw-photo' },
  'img-pilot-girl': { kind: 'art', frame2: 'art', frame4source: 'frame2', phone: false, hooks: 'neutral', tags: 'beauty', family: 'pilot-girl' },
  // Средневековая фотосессия: костюм и локация меняются, лицо нет.
  'img-medieval-photo': { kind: 'art', frame2: 'art', frame4source: 'frame2', phone: false, hooks: 'neutral', tags: 'beauty', family: 'medieval-photo' },
  // «Попала под дождь» витрины и наш локальный rain-avatar это один и тот же кадр, семья общая.
  'img-rain-look': { kind: 'art', frame2: 'art', frame4source: 'frame2', phone: false, hooks: 'neutral', tags: 'beauty', family: 'rain-avatar' },
  // Деловой портрет и примерка одежды: съёмка РОВНЫМ СТУДИЙНЫМ СВЕТОМ против уличного селфи в
  // исходнике. Это ровно случай img-new-forms: без studioLook валидатор бракует годные посты за
  // «не то же лицо», хотя это тот же человек в другом свете.
  'img-business-portrait': { kind: 'art', frame2: 'art', frame4source: 'frame2', phone: false, hooks: 'neutral', tags: 'beauty', family: 'business-portrait', studioLook: true },
  'img-tryon': { kind: 'art', frame2: 'art', frame4source: 'frame2', phone: false, hooks: 'neutral', tags: 'beauty', family: 'tryon', studioLook: true },
  // Реставрация старого фото: единственный шаблон добора, который работает по ЧУЖОМУ исходнику
  // (скан старого снимка). В ленте модели он идёт как обычный фильтр на своё фото.
  'img-photo-restore': { kind: 'art', frame2: 'art', frame4source: 'frame2', phone: false, hooks: 'neutral', tags: 'beauty', family: 'photo-restore' },
};

// ═══ СЛОВО-МАРКЕР НА ЧЕТВЁРТОМ КАДРЕ ════════════════════════════════════════════════════════
// Приказ начальника 09.08 дословно: «теперь у нас всегда там надпись «нейронка про промпты». Были
// шаблоны, но шаблоны будут искать юзеры тиктока, а промпты инстаграма, чтобы отслеживать трафик».
//
// ЗАЧЕМ ЭТО ПРАВИЛО И ПОЧЕМУ ЕГО НЕЛЬЗЯ СРЕЗАТЬ КАК КОСМЕТИКУ. Ссылку в био мы не ставим (за неё
// инстаграм режет акк), поэтому слово в кадре это ЕДИНСТВЕННЫЙ дешёвый способ понять, с какой
// площадки пришёл человек: он ищет нас ровно тем словом, которое увидел, и запрос виден на сайте.
// Одинаковое слово в обоих вариантах убивает всю аналитику источников.
//
// Из одного поста рендерятся ДВА четвёртых кадра: фотопост уезжает в тикток, рилс в инстаграм.
const FRAME4_CTA = {
  tiktok: 'шаблоны',   // четыре кадра фотопостом
  reels: 'промпты',    // смонтированный рилс
};
const frame4Platforms = () => Object.keys(FRAME4_CTA);
/** Слово-маркер под площадку. Незнакомая площадка это ошибка вызывающего, а не повод угадать. */
function frame4Marker(platform) {
  const m = FRAME4_CTA[String(platform || '').toLowerCase()];
  if (!m) {
    throw new Error(`templates: неизвестная площадка «${platform}» для четвёртого кадра, `
      + `знаю: ${frame4Platforms().join(', ')}`);
  }
  return m;
}

// ═══ ЗАПАСНОЕ ОПОЗНАНИЕ ПО СЛОВАМ В НАЗВАНИИ ════════════════════════════════════════════════
// Нужно РОВНО для неописанных шаблонов: на сайте их больше, чем мы успели завести, а мягкие
// признаки validatepost («это стилизация», «тут двое», «это студия») лучше угадать по названию,
// чем потерять и забраковать годный пост. Для ОПИСАННЫХ шаблонов слова не смотрим: правда в карте.
const GUESS_STYLIZED = /winx|fairy|anime|gta|pixar|plush|action-figure|fantasy|popart|sketch|watercolor|minecraft|cyberpunk|double-exposure/i;
const GUESS_MULTI = /boyfriend|match-partner|couple/i;
const GUESS_STUDIO = /new-forms|tryon|magazine-cover|business-portrait|bw-editorial/i;

const warned = new Set();
/** Правила шаблона. Для неописанного шаблона: безопасный режим + known:false + один крик в лог. */
function get(template) {
  const key = String(template == null ? '' : template).trim();
  const row = TEMPLATES[key];
  if (row) return { template: key, known: true, ...UNKNOWN, ...row };
  if (!warned.has(key)) {
    warned.add(key);
    // ПУСТОЕ ИМЯ ЭТО НЕ НЕИЗВЕСТНЫЙ ШАБЛОН, А ОШИБКА ВЫЗЫВАЮЩЕГО (09.08). Ровно так пряталась
    // дыра в validatepost: он читал шаблон из базы, печатал его в шапку и звал проверку БЕЗ опций,
    // а контракт получал пустую строку и молча уходил в безопасный режим. Снаружи это читалось
    // как «контракт не знает наших шаблонов», хотя шаблон был описан. Разные сообщения на эти два
    // случая экономят час поиска.
    console.log(key
      ? `  ⚠ ШАБЛОН НЕ ОПИСАН В КОНТРАКТЕ: «${key}» — работаю в безопасном режиме `
        + '(не сердечки, телефон запрещён, хуки нейтральные). Опиши его в templates.cjs.'
      : '  ⚠ ИМЯ ШАБЛОНА ПРИШЛО ПУСТЫМ — это ошибка вызывающего, а не неизвестный шаблон: '
        + 'шаблон надо передать из meta->>\'template\'. Правила шаблона сейчас НЕ применяются.');
  }
  return {
    template: key, known: false, ...UNKNOWN,
    stylized: GUESS_STYLIZED.test(key), multiPerson: GUESS_MULTI.test(key), studioLook: GUESS_STUDIO.test(key),
  };
}

const isCard = (t) => get(t).kind === 'card';
const isHearts = (t) => get(t).kind === 'hearts';
const isArt = (t) => get(t).kind === 'art';
const phoneOk = (t) => get(t).phone === true;
const frame2Kind = (t) => get(t).frame2;
const frame4Source = (t) => get(t).frame4source;
const hooksKey = (t) => get(t).hooks;
const tagsKey = (t) => get(t).tags;
const hasFactoryGuide = (t) => get(t).factoryGuide === true;
const isStylized = (t) => get(t).stylized === true;
const isMultiPerson = (t) => get(t).multiPerson === true;
const isStudioLook = (t) => get(t).studioLook === true;
const isKnown = (t) => get(t).known === true;
const kindOf = (t) => get(t).kind;
// ВЫКЛЮЧЕН ПРИКАЗОМ. Флаг ставится в контракте (magazine-cover 12.08, action-figure 13.08), а
// читать его ОБЯЗАН каждый раздатчик работы: до 13.08 его не читал никто, и «выключенный» шаблон
// продолжал ротироваться в genposts. Описание шаблона при этом остаётся, чтобы уже собранные
// посты не падали в UNKNOWN.
const isDisabled = (t) => get(t).disabled === true;
/** Человеческое имя типа для логов и листов проверки. */
const kindRu = (t) => ({ card: 'карточка', hearts: 'сердечки', art: 'арт' })[get(t).kind] || 'арт';

/**
 * Пул текстов из объекта, ключованного по шаблону.
 * Порядок поиска: точный шаблон → любой шаблон ТОЙ ЖЕ СЕМЬИ → ключ по умолчанию.
 * Именно шаг «семья» лечит старый баг: пул тренда в tgblast лежит под 'img-heart-hair', и посту
 * с шаблоном 'hearts-trend' раньше выдавался общий пул '*' вместо текстов про волосы.
 */
function textPool(map, template, fallbackKey = '*') {
  if (!map) return undefined;
  const key = String(template == null ? '' : template).trim();
  if (map[key]) return map[key];
  const fam = get(key).family;
  if (fam) for (const [k, v] of Object.entries(TEMPLATES)) if (v.family === fam && map[k]) return map[k];
  return map[fallbackKey];
}

/** Все описанные шаблоны (для отчётов и проверок). */
const list = () => Object.keys(TEMPLATES);

module.exports = {
  TEMPLATES, get, list, textPool, FRAME4_CTA, frame4Marker, frame4Platforms,
  isCard, isHearts, isArt, phoneOk, frame2Kind, frame4Source, hooksKey, tagsKey,
  hasFactoryGuide, isStylized, isMultiPerson, isStudioLook, isKnown, isDisabled, kindOf, kindRu,
};
