// СБОРКА ФОТОПОСТА В РИЛС. Решение владельца 03.08: карусель из фото в ленте обрезается
// (IG даёт максимум 4:5, а плашки-инфографика высокие — низ и верх срезает), а рилс идёт 9:16
// и вмещает картинку целиком. Плюс рилсы получают охват, которого у постов нет.
//
// Что делаем: три кадра карусели склеиваем в вертикальное видео 1080×1920. Кадр вписываем
// ЦЕЛИКОМ (contain, ничего не режем), пустоту по бокам заполняем размытой копией самого кадра —
// так видео выглядит цельным, а не «картинка на белом листе».
//
// Тайминги: первый кадр («до») держим дольше — это хук, на нём принимают решение смотреть дальше;
// плашку держим дольше всех, её читают; финал («после») тоже подольше, он собирает реакции.
//
// Запуск: node reelbuild.cjs <out.mp4> <кадр1> <кадр2> [кадр3…]
'use strict';
const fs = require('node:fs');
const { spawn, execFileSync } = require('node:child_process');

// ФОРМАТ ХОЛСТА (09.08). По умолчанию 9:16, но кадры у нас 4:5, и в 9:16 сверху и снизу остаётся
// размытая пустота: начальник это увидел и справедливо назвал бредом. REEL_ASPECT=4:5 собирает
// рилс 1080×1350, кадр ложится один в один, пустоты нет вообще, а лента показывает такой рилс
// целиком. Instagram принимает рилсы от 1.91:1 до 9:16, 4:5 внутри разрешённого.
const ASPECT = String(process.env.REEL_ASPECT || '9:16');
const [W, H] = ASPECT === '4:5' ? [1080, 1350] : [1080, 1920];
// БЕЗОПАСНАЯ ЗОНА (размеры выверены 03.08 по гайдам Meta и замерам наших кадров).
// Рилс 9:16 нигде не виден целиком:
//   • ЛЕНТА кропает его до 4:5 по центру — видны строки y 285…1635;
//   • ПОЛНЫЙ ЭКРАН показывает всё, но низ ~420 px закрыт ником, подписью и аудио-плашкой,
//     а справа ниже середины лежит колонка лайк/коммент/шер;
//   • СЕТКА ПРОФИЛЯ с 2025 года режет по 3:4.
// Рабочая зона — пересечение всего этого: 960×1170, начиная с y=300. Она СМЕЩЕНА ВВЕРХ от центра
// холста, потому что снизу отъедают и лента, и интерфейс. Раньше кадр центрировался по холсту,
// и нижняя строка с брендом «нейронка про» не попадала ни в ленту, ни в чистую зону фулскрина.
// Считаем от КРОПА ЛЕНТЫ (y 285…1635, высота 1350) — именно там пост смотрят. Кадры фабрики 3:4,
// поэтому берём максимум, что влезает в эту высоту: 1012×1350. По бокам остаётся всего по 34 px,
// то есть картинка идёт практически во всю ширину — раньше зона была уже (960×1170) и по краям
// зияли широкие поля, на что владелец и указал.
// Подобрано глазами 03.08 по кадру из ленты. Компромисс между двумя крайностями:
//   • 960×1170 — всё видно, но по бокам зияли широкие поля («края не очень»);
//   • 1080×1440 (во всю ширину) — полей нет, но лента срезала заголовок плашки.
// 1040×1386 от y=267: поля всего по 20 px (глазу незаметно), а срез сверху и снизу попадает
// в пустые отступы макета, поэтому и заголовок, и нижняя строка читаются целиком.
// В формате 4:5 безопасная зона это ВЕСЬ холст: кадр 4:5 совпадает с ним по пропорциям.
// КАДР ВО ВСЮ ШИРИНУ (11.08, приказ начальника «попробовать 9:16 во всю ширину и заново проверить,
// режет ли заголовок, теперь у нас плашка другая»).
// БЫЛО: 1040 на 1386 с отступом 267, то есть по 20 пикселей размытых полей по бокам. Полная ширина
// была отклонена 3 августа, потому что лента срезала заголовок плашки. С тех пор плашка поднялась.
// ЗАМЕР 11.08 на собранном рилсе, распознаванием текста по холсту 1080 на 1920:
//   · при полной ширине и отступе 80 самая нижняя строка плашки стоит на высоте 1221;
//   · при старом отступе 267 она стоит на 1321;
//   · зона интерфейса рилсов (подпись, кнопки, звук) начинается примерно с 1440.
// То есть запас 219 пикселей против 119, и ничего не срезается. Боковых полей больше нет: кадр 4:5
// занимает всю ширину холста, а размытая копия остаётся только сверху и снизу.
const SAFE_W = Number(process.env.REEL_SAFE_W || (ASPECT === '4:5' ? 1080 : 1080));
const SAFE_H = Number(process.env.REEL_SAFE_H || (ASPECT === '4:5' ? 1350 : 1440));
const SAFE_Y = Number(process.env.REEL_SAFE_Y || (ASPECT === '4:5' ? 0 : 80));
// Сколько секунд держим каждый кадр: хук, плашка(и), финал.
// ТАЙМИНГИ ПОД ОХВАТ (06.08, разведка по сигналам Instagram):
//   • официальная метрика это skip rate первых 3 секунд, поэтому первый кадр держим коротко,
//     зритель должен сразу увидеть готовый результат, а не заход;
//   • лучший охват у роликов 30-60 секунд (140 тыс. рилсов, замер январь-июнь 2026), а средний
//     просмотр по платформе 8,5 секунды: значит боремся за секунды удержания на длинном полотне,
//     а не за полный досмотр. Прошлые 14 секунд это худшее из двух миров: и не луп, и не длинный;
//   • watch time считает и повторы, поэтому длинное полотно с сильными кадрами выгоднее.
// ПЕРЕСМОТР 08.08 (приказ начальника, он посмотрел готовый рилс): «почему длится 30 секунд,
// кадры медленно меняются». Прошлая ставка на 30-60 секунд была теорией про watch time, а на
// практике на четырёх статичных кадрах это выглядит как зависшая презентация: зрителю нечего
// смотреть 11 секунд на одной картинке, он уходит на первом же кадре.
// Новый расчёт: смена кадра каждые 2-3 секунды, весь рилс около 11 секунд, то есть он ещё и
// лупится, а повторный просмотр Instagram считает в watch time.
// Итог на 4 кадрах: 2 + 2,6 + 2,6 + 3,4 = 10,6 секунды.
// ДЛИНА ПО ЧИСЛУ КАДРОВ (09.08, цифры начальника): три кадра это 10 секунд, четыре это 12.
// Раскладка внутри: первый кадр короче (на нём решают, смотреть ли дальше), последний длиннее
// (на нём фирменный блок и призыв). Значения ниже подобраны так, чтобы сумма попадала ровно.
// ДЛИНА ТЕПЕРЬ ПЛАВАЕТ 9-13 СЕКУНД (приказ 11.08). Одинаковая длина у всей фермы это признак
// сетки и мешает замерить, какая длительность лучше досматривается. Длину выбираем ДЕТЕРМИНИРОВАННО
// от seedKey поста: один пост всегда даёт ту же длину (пересборка не плодит разные версии), но
// между постами разброс честный.
const REEL_MIN = Number(process.env.REEL_MIN_SEC || 9);
const REEL_MAX = Number(process.env.REEL_MAX_SEC || 13);
let ДЛИНА_ПОСТА = null;   // ставится в build() по seedKey
const TOTAL_BY_FRAMES = { 3: Number(process.env.REEL_TOTAL_3 || 10), 4: Number(process.env.REEL_TOTAL_4 || 12) };
const SHARE = { first: 0.22, middle: 0.25, last: 0.30 };  // доли, нормируются под нужную сумму

function holdFor(i, n) {
  const total = ДЛИНА_ПОСТА || TOTAL_BY_FRAMES[n] || (n * 3);
  // Считаем веса: первый и последний свои, середина делит остаток.
  const w = [];
  for (let k = 0; k < n; k++) w.push(k === 0 ? SHARE.first : k === n - 1 ? SHARE.last : SHARE.middle);
  const sum = w.reduce((a, b) => a + b, 0);
  // ОСТАТОК ОКРУГЛЕНИЯ ЗАБИРАЕТ ПОСЛЕДНИЙ КАДР (12.08). Каждая доля округлялась до десятой
  // ОТДЕЛЬНО, и сумма недобирала до заданной длины: при цели 9 сек выходило 8.90, а гейт требует
  // коридор 9-13 и браковал здоровые ролики. В одном прогоне так потерялось 14 рилсов, ещё 10 в
  // соседнем. Это не про монтаж, а про арифметику: доли (0.22 + 0.25 + 0.25 + 0.30) дают 1.02, и
  // после округления каждого куска сумма уезжает вниз. Теперь последний кадр = длина минус всё
  // остальное, поэтому сумма СХОДИТСЯ ТОЧНО и коридор не нарушается ни разу.
  const доля = (k) => Math.round((total * w[k] / sum) * 10) / 10;
  if (i < n - 1) return доля(i);
  let прочие = 0;
  for (let k = 0; k < n - 1; k++) прочие += доля(k);
  return Math.round((total - прочие) * 10) / 10;
}

// Треки лежат в audio/ рядом со скриптом. Класть туда можно что угодно: mp3/m4a/wav.
const AUDIO_DIR = process.env.REEL_AUDIO_DIR || require('node:path').join(__dirname, 'audio');
function tracks() {
  try {
    const all = fs.readdirSync(AUDIO_DIR).filter((f) => /\.(mp3|m4a|aac|wav)$/i.test(f)).sort();
    // ПРИОРИТЕТ БОДРЫМ (08.08, начальник послушал рилс: «у нас уебская музыка»). Старый пул это
    // бесплатный chill и lofi, он звучит как фон в лифте. Треки с приставкой beat_ скачаны
    // отдельно под ленты, и если они есть, берём ТОЛЬКО их; остальное лежит как запас.
    const beats = all.filter((f) => /^beat_/i.test(f));
    return (beats.length ? beats : all).map((f) => require('node:path').join(AUDIO_DIR, f));
  } catch { return []; }
}
// Простой стабильный хэш строки → число. Нужен, чтобы выбор трека не менялся между прогонами.
function hash(s) {
  let h = 0;
  for (const ch of String(s || '')) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
  return h;
}
// Трек на пост. ВАЖНО: IG склеивает аккаунты в сетку не только по картинке, но и по ОТПЕЧАТКУ
// ЗВУКА. Пять файлов на всю ферму = пять аудио-кластеров, в каждом сидят все наши акки, и это
// готовый признак сети. Поэтому пул треков держим широким и предупреждаем, когда он мал.
function pickTrack(seedKey) {
  if (process.env.REEL_NO_AUDIO === '1') return null;
  const list = tracks();
  if (!list.length) return null;
  if (list.length < 12) {
    console.log(`  ⚠ в пуле всего ${list.length} треков — IG склеивает акки по отпечатку звука, добавь ещё в audio/`);
  }
  return list[hash(seedKey) % list.length];
}
// С какой секунды играть: одинаковый старт у всех рилсов выглядит штампом. Держим сдвиг
// МАЛЕНЬКИМ (0-8 сек): треки бывают по 30 секунд, и старт за их концом давал пустое аудио,
// а `-shortest` обрезал по нему всё видео в ноль (03.08, рилс собрался на 261 байт).
function startFor(seedKey) { return hash(`s:${seedKey}`) % 8; }

// ПРИПЕВ, А НЕ ИНТРО (09.08, приказ начальника: «найди там припев и наложи»). Полные треки на
// три-четыре минуты начинаются с тихого вступления, и на десятисекундном рилсе зритель слышал
// именно его. Ищем САМОЕ ГРОМКОЕ окно: режем трек на куски нужной длины, считаем средний уровень
// каждого через volumedetect и берём начало самого громкого. Это и есть припев или дроп.
// Результат кэшируем рядом с треком: замер идёт секунды, а сборок много.
// ДВА ОТРЫВКА С КАЖДОГО ТРЕКА (09.08, приказ начальника: «вырежи с каждого трека по 2 момента,
// а не 1, те что с высокими нотами или громкостью, но отличаются друг от друга»).
// Зачем: Instagram склеивает аккаунты в сетку по отпечатку звука. Один припев на трек означал,
// что двенадцать наших рилсов звучат идентично. Берём ДВА самых громких окна, разнесённых между
// собой минимум на полторы длины рилса, и раздаём их постам по хэшу. С семи треков получается
// четырнадцать разных звуковых отрывков.
// Замер: режем трек на окна длиной в рилс, считаем средний уровень (volumedetect) и максимум пика.
// Результат кэшируем рядом с треком, потому что сборок много, а замер идёт секунды.
function chorusPoints(track, need) {
  // РУЧНОЙ ВЫБОР НАЧАЛЬНИКА (09.08). Если рядом с треком лежит файл <трек>.points со списком
  // секунд, берём только их: он послушал отрывки и отобрал живые, автозамер тут не спорит.
  try {
    const manual = JSON.parse(fs.readFileSync(track + '.points', 'utf8'));
    if (Array.isArray(manual) && manual.length) return manual;
  } catch {}
  const cache = track + '.chorus2';
  try {
    const c = JSON.parse(fs.readFileSync(cache, 'utf8'));
    if (c && c.need === need && Array.isArray(c.points) && c.points.length) return c.points;
  } catch {}
  const FFB = require('ffmpeg-static');
  // ВАЖНО: volumedetect пишет уровень в stderr, а код выхода 0. Читаем stderr всегда.
  const probe = (args) => String(require('node:child_process').spawnSync(FFB, args, { encoding: 'utf8' }).stderr || '');
  const info = probe(['-hide_banner', '-i', track]);
  const m = info.match(/Duration: (\d+):(\d+):(\d+(?:\.\d+)?)/);
  const dur = m ? (+m[1]) * 3600 + (+m[2]) * 60 + parseFloat(m[3]) : 0;
  if (!dur || dur < need + 4) return [0];
  const step = Math.max(3, Math.round(need / 2));
  const wins = [];
  for (let t = 0; t + need <= dur - 1; t += step) {
    const out = probe(['-hide_banner', '-ss', String(t), '-t', String(need), '-i', track,
      '-af', 'volumedetect', '-f', 'null', '-']);
    const mean = out.match(/mean_volume:\s*(-?\d+(?:\.\d+)?) dB/);
    const peak = out.match(/max_volume:\s*(-?\d+(?:\.\d+)?) dB/);
    if (mean) wins.push({ t: Math.round(t), db: parseFloat(mean[1]), peak: peak ? parseFloat(peak[1]) : -99 });
  }
  if (!wins.length) return [0];
  // Сортируем по громкости с добавкой за пик: высокие ноты дают пик выше при том же среднем.
  wins.sort((a, b) => (b.db + b.peak / 8) - (a.db + a.peak / 8));
  const points = [wins[0].t];
  const far = Math.round(need * 1.5);
  for (const w of wins.slice(1)) {
    if (Math.abs(w.t - points[0]) >= far) { points.push(w.t); break; }
  }
  if (points.length === 1) {
    // Трек короткий: берём второй отрывок с другого конца, лишь бы отличался.
    const alt = wins.find((w) => Math.abs(w.t - points[0]) >= need);
    if (alt) points.push(alt.t);
  }
  try { fs.writeFileSync(cache, JSON.stringify({ need, points, dur: Math.round(dur) })); } catch {}
  return points;
}

function run(bin, args, timeoutMs = 180000) {
  return new Promise((resolve, reject) => {
    const p = spawn(bin, args, { stdio: ['ignore', 'ignore', 'pipe'] });
    let err = '';
    p.stderr.on('data', (d) => { err += d; });
    const to = setTimeout(() => { try { p.kill('SIGKILL'); } catch {} reject(new Error('ffmpeg таймаут')); }, timeoutMs);
    p.on('close', (c) => { clearTimeout(to); c === 0 ? resolve() : reject(new Error(`ffmpeg код ${c}: ${err.slice(-300)}`)); });
    p.on('error', (e) => { clearTimeout(to); reject(e); });
  });
}

/**
 * Собирает вертикальный рилс из кадров карусели.
 * @param {{files:string[], out:string}} o
 * @returns {Promise<{path:string,size:number,duration:number}>}
 */
async function buildReel({ files, out, ...opts }) {
  const bin = require('ffmpeg-static');
  if (!bin || !fs.existsSync(bin)) throw new Error('ffmpeg-static не найден');
  const list = (files || []).filter((f) => f && fs.existsSync(f));
  if (!list.length) throw new Error('нет кадров для рилса');

  // ДЛИНА РИЛСА ПЛАВАЕТ 9-13 СЕКУНД. Берём от сида поста, чтобы пересборка давала ту же длину,
  // а разные посты честно разбегались. Шаг 0.5 секунды: мельче зритель не различит, а нам хватает
  // девяти разных длительностей на ферму.
  {
    const шагов = Math.round((REEL_MAX - REEL_MIN) * 2) + 1;
    ДЛИНА_ПОСТА = REEL_MIN + (hash(`len:${opts.seedKey || out}`) % шагов) / 2;
  }

  // Все входы объявляем ДО фильтров: звуковую дорожку тоже, иначе ffmpeg не разбирает -f lavfi,
  // поставленный после -filter_complex (он относит его к предыдущему входу).
  const args = ['-y'];
  for (const [i, f] of list.entries()) args.push('-loop', '1', '-t', String(holdFor(i, list.length)), '-i', f);

  // МУЗЫКА ОБЯЗАТЕЛЬНА. Рилс без звука алгоритм IG почти не раздаёт — охват падает в ноль
  // (правило владельца 03.08). Берём трек из папки audio/, выбор детерминированный от сида,
  // чтобы у разных постов была разная музыка, а повторная сборка давала тот же результат.
  // Точку старта тоже сдвигаем: два рилса подряд не должны звучать одинаково.
  // ЯВНЫЙ ТРЕК (09.08): magosreels раздаёт треки по кругу, чтобы внутри одной пачки не было
  // двух рилсов с одинаковым звуком. Без него выбор шёл по хэшу и совпадения случались.
  const track = (process.env.REEL_TRACK && fs.existsSync(process.env.REEL_TRACK))
    ? process.env.REEL_TRACK : pickTrack(opts.seedKey);
  if (track) {
    // -stream_loop: если трек короче рилса, он повторится, а не оборвёт видео по -shortest.
    // Старт аудио: припев (самое громкое окно длиной во весь рилс), а не интро.
    const need = Math.ceil(list.reduce((a, _, i) => a + holdFor(i, list.length), 0)) || 11;
    // РАЗНЫЕ ОТРЫВКИ У КАЖДОГО РИЛСА (09.08, идея начальника: «чтобы инст не понял»). Instagram
    // склеивает аккаунты в сетку по отпечатку звука, а одинаковый старт у пятидесяти роликов это
    // готовый признак сети. Поэтому от найденного припева отступаем на свой сдвиг, свой у каждого
    // поста и стабильный между сборками: от минус 4 до плюс 2 секунды. Припев при этом не теряем.
    let at = opts.audioStart;
    // ЯВНАЯ СЕКУНДА СТАРТА (10.08). Замер по собранным рилсам: из пяти новых ТРОЕ звучали
    // одинаково, а у 31 старого отпечаток звука вообще один на всех. Треков в работе семь, и
    // случайная раздача по хэшу на таком узком пуле обязана давать совпадения. Поэтому сборщик
    // пачки теперь сам считает, какой (трек, секунда) достанется каждому рилсу, и передаёт секунду
    // сюда. Отпечаток звука это ПАРА трек плюс секунда, значит на семи треках с отобранными
    // секундами получается двадцать разных отпечатков вместо семи.
    // Приказ про проверенные отрывки не нарушается: раздаются РОВНО те секунды, что отобраны на слух.
    if (at === undefined && process.env.REEL_AT !== undefined && process.env.REEL_AT !== '') {
      const forced = Number(process.env.REEL_AT);
      if (Number.isFinite(forced) && forced >= 0) at = Math.round(forced);
    }
    if (at === undefined) {
      if (process.env.REEL_NO_CHORUS === '1') at = startFor(opts.seedKey);
      else {
        // ПРОВЕРЕННЫЙ ОТРЫВОК ИДЁТ ТОЧНО (09.08): если начальник закрепил секунды файлом .points,
        // никакого сдвига не добавляем, иначе рилс уезжает мимо утверждённого места (было 21 вместо 24).
        const manualFile = track + '.points';
        if (fs.existsSync(manualFile)) {
          try {
            const pts0 = JSON.parse(fs.readFileSync(manualFile, 'utf8'));
            at = Math.max(0, pts0[hash(`p:${opts.seedKey}`) % pts0.length]);
          } catch { at = 0; }
        }
        const pts = chorusPoints(track, need);
        if (at === undefined) {
          const base = pts[hash(`p:${opts.seedKey}`) % pts.length] - 1;  // вход в припев звучит лучше
          const jitter = (hash(`j:${opts.seedKey}`) % 5) - 2;            // -2..+2 внутри отрывка
          at = Math.max(0, base + jitter);
        }
      }
    }
    console.log(`  ♪ трек: ${require('node:path').basename(track)}, играем с ${at} сек (припев)`);
    args.push('-stream_loop', '-1', '-ss', String(at), '-i', track);
  } else {
    console.log('  ⚠ в папке audio/ нет треков — рилс уйдёт БЕЗ музыки, охват будет ниже');
    args.push('-f', 'lavfi', '-i', 'anullsrc=channel_layout=stereo:sample_rate=44100');
  }

  // ФОТО ЗАПОЛНЯЮТ ЭКРАН ЦЕЛИКОМ, БЕЗ КРАЁВ (приказ 11.08). Раньше кадр вписывался в безопасную
  // зону, а остаток закрывался размытой копией: формат был верный, но сверху и снизу оставались
  // мутные поля, и рилс читался как коллаж, а не как съёмка. Теперь фото режем по принципу
  // «залить экран»: масштаб по высоте, лишнее по бокам уходит. Замер на живой обложке 1080x1350:
  // теряется 21 процент ширины с каждой стороны поровну, хук по центру остаётся целым (проверено
  // глазами на кадре с надписью «хотела исправить нос»).
  // ИСКЛЮЧЕНИЕ: КАРТОЧКА ФАБРИКИ (второй кадр, индекс 1). У неё текст идёт от края до края, и
  // заливка экрана срезала бы блоки с оценками. Её по-прежнему вписываем целиком в безопасную
  // зону на размытом фоне.
  // ФИНАЛЬНЫЙ КАДР ТОЖЕ ВПИСЫВАЕМ. На нём наша плашка «нейронка про промпты» с адресом идёт почти
  // от края до края, и заливка экрана срезала её с обеих сторон: проверено глазами на первой сборке,
  // слева пропало начало строки, справа адрес. Значит фулскрин это кадры 1 и 3 (чистые фото), а
  // кадр с карточкой и кадр с плашкой вписываются целиком.
  const КАРТОЧКИ = new Set(String(process.env.REEL_CARDS || '1').split(',').map(Number));
  // ЗАПРЕТ ЗУМА ОТВЯЗАН ОТ ВПИСЫВАНИЯ (13.08, живой брак: «второй кадр с карточкой отдаляется, а
  // приказ был чтобы он был неподвижным»).
  //
  // ЧТО СЛОМАЛОСЬ. Множество КАРТОЧКИ отвечало СРАЗУ ЗА ДВЕ РАЗНЫЕ ВЕЩИ: за вписывание кадра
  // целиком и за запрет наезда. В режиме 9:16 карточка приходит уже готового размера, вписывать
  // её не надо, и magosreels выставляет REEL_CARDS='-1' (заведомо пустое множество). Вместе с
  // вписыванием отключался и запрет зума, и карточка начинала ездить.
  //
  // ПОЧЕМУ ОТДЕЛЬНЫМ СПИСКОМ. «Вписать» и «не двигать» это независимые решения: карточка 9:16
  // не вписывается, но двигаться ей всё равно нельзя, иначе наезд срезает края, где живёт текст
  // разбора. Список задаётся своей переменной и по умолчанию совпадает со старым поведением.
  const БЕЗ_ЗУМА = new Set(String(process.env.REEL_STATIC || '1').split(',').map(Number));
  const ЗАЛИВАТЬ = process.env.REEL_FILL !== '0';
  const ВПИСАТЬ_ФИНАЛ = process.env.REEL_FIT_LAST !== '0';
  // ДВИЖЕНИЕ В КАДРЕ (приказ 11.08). Четыре статичные картинки читаются как презентация, зритель
  // уходит на первом же кадре. Даём медленный наезд или отъезд: за время показа кадр меняет масштаб
  // примерно на 6 процентов. Это незаметно как «эффект», но глаз держится за движение.
  // Направление чередуем (чётный кадр наезд, нечётный отъезд), чтобы не укачивало в одну сторону.
  //
  // ГРАБЛИ, ПОЙМАННЫЕ 11.08 ГЛАЗАМИ НАЧАЛЬНИКА: первая версия использовала zoompan с d равным числу
  // кадров отрезка, и рилс обрывался чёрным после первого кадра. Причина: параметр d у zoompan это
  // сколько кадров выдать НА КАЖДЫЙ ВХОДНОЙ кадр, а вход у нас зациклённая картинка длиной в секунды,
  // то есть уже сотня кадров. Отрезок раздувался в сотни раз, уходил в затемнение, и общая длина
  // резала всё остальное. Правильно d=1: один выходной кадр на входной, а зум ведём по счётчику
  // выходных кадров on. Масштабируем ВВЕРХ до расчёта зума (иначе видны пиксельные скачки), потом
  // ужимаем обратно.
  // ЗАТЕМНЕНИЕ НА СТЫКЕ: короткий уход в чёрное 0.18 сек в конце каждого кадра, кроме последнего.
  // Это прячет резкую склейку и читается как монтаж, а не как смена слайда.
  const ДВИГАТЬ = process.env.REEL_MOTION !== '0';
  const ЗУМ_СИЛА = Number(process.env.REEL_ZOOM || 0.06);
  const ЗАТЕМНЕНИЕ = Number(process.env.REEL_DIP || 0.18);
  // КАДРЫ С ТЕКСТОМ НЕ ЗУМИМ (приказ 11.08, начальник: «текст не влазит, а фото ещё и двигается»).
  // Наезд zoompan увеличивает картинку и срезает края, ровно там, где живёт текст: хук на кадре 1,
  // карточка на кадре 2, плашка с адресом на финале. Поэтому зум оставляем ТОЛЬКО на чистых фото
  // без надписей (обычно кадр 3), а текстовые кадры двигаться не должны: у них только затемнение
  // на стыке. Так текст гарантированно цел при любой длине хука.
  const текстовыйКадр = (i) => i === 0 || БЕЗ_ЗУМА.has(i) || КАРТОЧКИ.has(i) || i === list.length - 1;
  const движение = (i, вход) => {
    const сек0 = holdFor(i, list.length);
    // Затемнение на стыке нужно всем кадрам, кроме последнего, даже если кадр не зумится.
    const затемнЛюбой = (i < list.length - 1 && ЗАТЕМНЕНИЕ > 0)
      ? `,fade=t=out:st=${Math.max(0, сек0 - ЗАТЕМНЕНИЕ).toFixed(2)}:d=${ЗАТЕМНЕНИЕ}:color=black` : '';
    if (!ДВИГАТЬ || текстовыйКадр(i)) return `${вход},fps=30${затемнЛюбой},setsar=1`;
    const сек = сек0;
    const кадров = Math.max(2, Math.round(сек * 30));
    const наезд = i % 2 === 0;
    // z идёт от 1 до 1+сила (наезд) или от 1+сила до 1 (отъезд)
    const z = наезд
      ? `min(1+${ЗУМ_СИЛА}*on/${кадров},${1 + ЗУМ_СИЛА})`
      : `max(${1 + ЗУМ_СИЛА}-${ЗУМ_СИЛА}*on/${кадров},1)`;
    // ГЛАВНЫЙ ПОДВОХ zoompan (пойман гейтом reelgate 11.08): у фильтра СВОЯ выходная частота кадров,
    // по умолчанию 25, независимо от входных 30. Отрезок 2.76 сек на выходе становился 3.32 сек
    // (растяжка 30/25 = 1.2), fade уводил кадр в чёрное, а хвост держал пустоту, и на каждом стыке
    // стояло 0.6 сек черноты. Лечится параметром fps=30 ВНУТРИ zoompan, входного fps перед ним мало.
    // d=1: строго один выходной кадр на входной, никакого размножения.
    const зум = `fps=30,scale=${W * 2}:${H * 2},`
      + `zoompan=z='${z}':d=1:x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':s=${W}x${H}:fps=30`;
    // Уход в чёрное в самом конце кадра (кроме последнего).
    const затемн = (i < list.length - 1 && ЗАТЕМНЕНИЕ > 0)
      ? `,fade=t=out:st=${Math.max(0, сек - ЗАТЕМНЕНИЕ).toFixed(2)}:d=${ЗАТЕМНЕНИЕ}:color=black`
      : '';
    return `${вход},${зум}${затемн},setsar=1`;
  };
  const parts = [];
  for (let i = 0; i < list.length; i++) {
    const вписать = КАРТОЧКИ.has(i) || (ВПИСАТЬ_ФИНАЛ && i === list.length - 1);
    if (ЗАЛИВАТЬ && !вписать) {
      parts.push(
        `[${i}:v]${движение(i, `scale=${W}:${H}:force_original_aspect_ratio=increase,crop=${W}:${H}`)}[v${i}]`,
      );
      continue;
    }
    parts.push(
      `[${i}:v]scale=${W}:${H}:force_original_aspect_ratio=increase,crop=${W}:${H},boxblur=28:2,eq=brightness=-0.06[bg${i}]`,
      `[${i}:v]scale=${SAFE_W}:${SAFE_H}:force_original_aspect_ratio=decrease:force_divisible_by=2[fg${i}]`,
      // Смещения держим ЧЁТНЫМИ: при yuv420p нечётный сдвиг даёт замыленную цветность.
      `[bg${i}][fg${i}]overlay=x=trunc((W-w)/4)*2:y=${SAFE_Y}+trunc((${SAFE_H}-h)/4)*2${движение(i, 'null').replace(/^null,?/, ',').replace(/^,+/, ',')}[v${i}]`,
    );
  }
  parts.push(`${list.map((_, i) => `[v${i}]`).join('')}concat=n=${list.length}:v=1:a=0[v]`);

  // ЗВУК. Три вещи, без которых Instagram глушил дорожку (03.08, «слышно только первую секунду»):
  //   • СТЕРЕО. Моно-дорожку веб-загрузчик обрабатывает криво, звук пропадает после первых кадров.
  //   • ЯВНАЯ ДЛИТЕЛЬНОСТЬ вместо `-shortest`: аудио получалось на доли секунды короче видео,
  //     и IG обрезал по нему весь трек.
  //   • МЯГКИЕ КРАЯ: резкий обрыв музыки в конце звучит как брак.
  const dur = list.reduce((s, _, i) => s + holdFor(i, list.length), 0);
  // Громкость выравниваем к -14 LUFS — это уровень, к которому соцсети приводят звук сами.
  // Без нормализации тихие треки уходили на -25 dB и в ленте их было не слышно.
  // ЛИЧНАЯ ПОДПИСЬ ДОРОЖКИ (11.08). Пара «трек плюс секунда» даёт всего 20 разных отпечатков, а
  // рилсов в заливе 165: 145 роликов вынуждены делить звук, и для инстаграма это готовый признак
  // сетки. Новую музыку взять негде, поэтому разводим САМ ЗВУК: у каждого рилса свой темп в пределах
  // двух процентов, свой наклон тембра и своя громкость на четверть децибела. На слух это тот же
  // отобранный отрывок (2 процента темпа человек не слышит), а волна получается своя у каждого
  // ролика, и совпадающих дорожек больше нет.
  // Значения берём от сида поста, значит повторная сборка того же поста даёт тот же звук.
  const темп = (100 + ((hash(`tempo:${opts.seedKey}`) % 41) - 20) / 10) / 100;   // 0.980 .. 1.020
  const тембр = ((hash(`eq:${opts.seedKey}`) % 25) - 12) / 10;                   // -1.2 .. +1.2 дБ
  const частота = 1200 + (hash(`eqf:${opts.seedKey}`) % 9) * 300;                // 1200 .. 3600 Гц
  const громче = ((hash(`vol:${opts.seedKey}`) % 9) - 4) / 16;                    // -0.25 .. +0.25 дБ
  parts.push(`[${list.length}:a]atrim=0:${(dur * 1.05).toFixed(2)},asetpts=N/SR/TB,`
    + `atempo=${темп.toFixed(4)},`
    + `equalizer=f=${частота}:t=q:w=1.4:g=${тембр.toFixed(1)},`
    + `volume=${громче.toFixed(2)}dB,`
    + `atrim=0:${dur.toFixed(2)},asetpts=N/SR/TB,`
    + `loudnorm=I=-14:TP=-1.5:LRA=11,`
    + `afade=t=in:st=0:d=0.4,afade=t=out:st=${Math.max(0, dur - 0.8).toFixed(2)}:d=0.8,`
    + `aformat=sample_fmts=fltp:sample_rates=44100:channel_layouts=stereo[amus]`);

  // ЗВУК НА СТЫКАХ (приказ 11.08). В момент склейки кадров зритель чаще всего свайпает: там пауза
  // и в картинке, и в звуке. Кладём короткий воздушный вздох, он синтезируется прямо тут, файлы
  // тянуть не надо: белый шум, задавленный полосовым фильтром и резкой огибающей, звучит как «пшш».
  // Громкость держим низкой (-22 дБ): это подложка под музыку, а не эффект из нарезки.
  const СТЫКИ = process.env.REEL_WHOOSH !== '0';
  let звук = '[amus]';
  if (СТЫКИ && list.length > 1) {
    const метки = [];
    let t = 0;
    for (let i = 0; i < list.length - 1; i++) {
      t += holdFor(i, list.length);
      // вздох начинается чуть раньше склейки, чтобы вести в неё, а не догонять
      метки.push(Math.max(0, t - 0.22));
    }
    метки.forEach((ms, k) => {
      parts.push(`anoisesrc=d=0.45:c=pink:a=0.9:r=44100,`
        + `bandpass=f=${1800 + k * 250}:width_type=h:w=1400,`
        + `afade=t=in:st=0:d=0.12,afade=t=out:st=0.18:d=0.27,`
        + `volume=-22dB,adelay=${Math.round(ms * 1000)}|${Math.round(ms * 1000)},`
        + `aformat=sample_fmts=fltp:sample_rates=44100:channel_layouts=stereo[w${k}]`);
    });
    parts.push(`[amus]${метки.map((_, k) => `[w${k}]`).join('')}`
      + `amix=inputs=${метки.length + 1}:duration=first:dropout_transition=0:normalize=0[a]`);
    звук = '[a]';
  } else {
    parts.push(`[amus]anull[a]`);
    звук = '[a]';
  }

  args.push('-filter_complex', parts.join(';'), '-map', '[v]', '-map', звук, '-t', dur.toFixed(2),
    '-c:v', 'libx264', '-preset', 'medium', '-crf', '20', '-pix_fmt', 'yuv420p',
    '-c:a', 'aac', '-b:a', '128k', '-ar', '44100', '-ac', '2', '-movflags', '+faststart', out);

  await run(bin, args);
  if (!fs.existsSync(out) || !fs.statSync(out).size) throw new Error('ffmpeg отдал пустой рилс');
  const duration = list.reduce((s, _, i) => s + holdFor(i, list.length), 0);
  return { path: out, size: fs.statSync(out).size, duration };
}

module.exports = { buildReel };

if (require.main === module) {
  (async () => {
    const [out, ...files] = process.argv.slice(2);
    if (!out || !files.length) { console.log('usage: node reelbuild.cjs <out.mp4> <кадр1> <кадр2> …'); process.exit(1); }
    // КЛЮЧ ПОСТА ОБЯЗАТЕЛЕН (09.08, начальник поймал на живых рилсах: «на них только legacy и трек
    // с одного места»). Без ключа hash считался от undefined, одинаково для всех, поэтому и трек, и
    // старт отрывка выходили одни и те же у всей пачки. Берём ключ из REEL_SEED, а если его нет,
    // из имени файла: два рилса с разными именами больше никогда не совпадут по звуку.
    const seedKey = process.env.REEL_SEED || require('node:path').basename(out);
    const r = await buildReel({ files, out, seedKey });
    console.log(`✓ рилс собран: ${r.path} (${(r.size / 1048576).toFixed(1)} МБ, ${r.duration.toFixed(1)} сек, ${W}×${H})`);
  })().catch((e) => { console.error('ОШИБКА:', e.message); process.exit(1); });
}
