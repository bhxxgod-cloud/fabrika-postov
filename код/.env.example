# --- GoLogin (облачный браузер) ---
# Один токен из Personal Area -> API Token. Единственный секрет для браузеров.
GOLOGIN_API_TOKEN=your_gologin_api_token

# --- База ---
# Railway подставит это сам при добавлении плагина Postgres.
DATABASE_URL=postgres://user:pass@host:5432/neironka_poster

# --- Вход в панель ---
DASHBOARD_PASSWORD=pick_a_strong_password
SESSION_SECRET=long_random_string

# --- Генерация текста и картинок ---
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-opus-4-8
# Эндпоинт вашего продукта neironka.pro для генерации картинок/видео (внутренний).
NEIRONKA_MEDIA_API=https://neironka.pro/api/internal/generate
NEIRONKA_MEDIA_API_KEY=internal_service_key

# --- Атрибуция ---
# База ссылок с трекинг-кодом персоны: https://neironka.pro/go/<tracking_code>
TRACKING_BASE_URL=https://neironka.pro/go

PORT=3000
