'use strict';
// ГЕЙТ ГОТОВОГО РИЛСА. Не пускает в публикацию mp4, который собрался с браком.
//
// ЗАЧЕМ ЭТОТ ФАЙЛ. 11.08 начальник поймал ГЛАЗАМИ два брака подряд на уже собранных рилсах, и оба
// раза их ловил человек, а не код. Так это работать не может: рилсов в заливе полторы сотни, глазами
// столько не пересмотреть, и каждый пропущенный уезжает на живой аккаунт.
//   1. ХУК ОБРЕЗАН ПО БОКАМ. Кадр рисуется в 4:5 (1080x1350), а в рилс заливается на весь экран 9:16:
//      масштаб идёт по высоте (1920/1350 = 1.42), ширина раздувается до 1536, и crop до 1080 срезает
//      по 228 px с каждой стороны, то есть видно ровно центральные 70.3 процента ширины. Длинный хук
//      теряет края, в ленту уехало «вший лайкнул через год молчан» вместо целой фразы.
//   2. РИЛС ОБРЫВАЛСЯ ЧЁРНЫМ ПОСЛЕ ПЕРВОГО КАДРА. Параметр d у zoompan размножал кадры (см. разбор
//      в reelbuild.cjs), отрезок раздувался в сотни раз и уходил в затемнение, а остальные кадры
//      просто не попадали в общую длину. Файл при этом был нормального размера и открывался: ни
//      код возврата ffmpeg, ни вес файла такой брак НЕ ВИДЯТ.
//
// ЧТО ИЗ ЭТОГО СЛЕДУЕТ ДЛЯ ПРОВЕРОК. Оба брака видны только на ПИКСЕЛЯХ готового mp4, поэтому гейт
// смотрит именно их: яркость по времени (чёрные провалы), распознанный текст с координатами (поля по
// краям), отпечатки кадров из середины каждого отрезка (склейка жива), длительность и звук.
//
// ЧТО ПЕРЕИСПОЛЬЗУЕМ, А НЕ ПИШЕМ ЗАНОВО:
//   • textguard.cjs — чтение надписей через easyocr (для гейта в него добавлены координаты «лево»
//     и «право»: вопрос «упирается ли строка в край» решается только по ним);
//   • coverguard.cjs — перцептивный отпечаток hashImage и расстояние hamming, тот же алгоритм, что
//     у гейта обложек и у framegate.cjs;
//   • node_modules/ffmpeg-static/ffmpeg — все замеры по видео, отдельный ffprobe в проекте не стоит.
//
// Запуск: node reelgate.cjs файл.mp4 [ожидаемаяДлина] [кадров]
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const FF = require('ffmpeg-static');
const { hashImage, hamming } = require('./coverguard.cjs');
const { замерить } = require('./textguard.cjs');

// ПОРОГИ. Вынесены сюда, чтобы их правили в одном месте, а не подкручивали по копии в сборщиках.
const П = {
  разбегДлины: 0.5,     // на сколько секунд готовый рилс может разойтись с расчётом сборщика
  минДлина: 9,          // приказ 11.08: длина рилса плавает 9-13 секунд
  максДлина: 13,
  чернаяЯркость: 22,    // средняя яркость кадра (0-255), ниже которой кадр считаем чёрным
  чернаяДлина: 0.4,     // сколько секунд подряд черноты уже брак
  шагЗамера: 0.1,       // как часто меряем яркость: см. пояснение в яркостьПоВремени
  полеТекста: 40,       // минимальный запас от строки до края холста, px
  зонаКрая: 90,         // в этой полосе у края слова разглядываем отдельно, на обрубленность
  тишина: -40,          // средний уровень дорожки ниже этого это тишина, dB
  отличиеКадров: 10,    // ниже этого расхождения отпечатков соседние отрезки считаем одинаковыми
};

// ДОЛИ ВРЕМЕНИ КАДРОВ — те же, что в reelbuild.cjs (SHARE): первый кадр короче, последний длиннее.
// Нужны, чтобы попасть замером в СЕРЕДИНУ каждого отрезка, а не на стык, где идёт затемнение.
const ДОЛИ = { первый: 0.22, средний: 0.25, последний: 0.30 };

/** ffmpeg на файл, stderr строкой. Замеры ffmpeg пишет именно в stderr, а код выхода при этом 0. */
function фф(args) {
  const r = spawnSync(FF, ['-hide_banner', '-nostdin', ...args],
    { encoding: 'utf8', maxBuffer: 1 << 26 });
  return String(r.stderr || '') + String(r.stdout || '');
}

/** Общие сведения о файле: длительность, размер картинки, есть ли звуковая дорожка. */
function сведения(файл) {
  const t = фф(['-i', файл]);
  const d = t.match(/Duration:\s*(\d+):(\d+):(\d+(?:\.\d+)?)/);
  const v = t.match(/Stream #\d+:\d+.*?Video:.*?,\s(\d{2,5})x(\d{2,5})/);
  return {
    длина: d ? (+d[1]) * 3600 + (+d[2]) * 60 + parseFloat(d[3]) : 0,
    ширина: v ? +v[1] : 0,
    высота: v ? +v[2] : 0,
    естьЗвук: /Stream #\d+:\d+.*?Audio:/.test(t),
  };
}

/**
 * ЯРКОСТЬ ПО ВРЕМЕНИ. Раскадровываем рилс и на каждом снимке берём среднюю яркость (signalstats
 * YAVG). Мерим не раз в секунду, а каждые 0.1 секунды НАРОЧНО: на стыках кадров сборщик кладёт
 * короткий уход в чёрное на 0.18 секунды, и при редком замере одна такая точка растягивалась бы в
 * полсекунды черноты, то есть гейт браковал бы здоровый монтаж. Шаг 0.1 отделяет затемнение стыка
 * (одна-две точки) от настоящего провала (четыре и больше).
 * @returns {{время:number, яркость:number}[]}
 */
function яркостьПоВремени(файл) {
  const fps = Math.round(1 / П.шагЗамера);
  const t = фф(['-i', файл, '-vf',
    `fps=${fps},scale=160:-2,signalstats,metadata=print:key=lavfi.signalstats.YAVG`,
    '-an', '-f', 'null', '-']);
  const точки = [];
  let время = null;
  for (const строка of t.split('\n')) {
    const p = строка.match(/pts_time:(\d+(?:\.\d+)?)/);
    if (p) { время = parseFloat(p[1]); continue; }
    const y = строка.match(/lavfi\.signalstats\.YAVG=(\d+(?:\.\d+)?)/);
    if (y && время !== null) { точки.push({ время, яркость: parseFloat(y[1]) }); время = null; }
  }
  return точки;
}

/** Чёрные отрезки: подряд идущие точки темнее порога. */
function черныеОтрезки(точки) {
  const отрезки = [];
  let старт = null, прошлое = null;
  for (const т of точки) {
    if (т.яркость < П.чернаяЯркость) {
      if (старт === null) старт = т.время;
      прошлое = т.время;
    } else if (старт !== null) {
      отрезки.push({ с: старт, по: прошлое + П.шагЗамера, длина: прошлое + П.шагЗамера - старт });
      старт = null;
    }
  }
  if (старт !== null) отрезки.push({ с: старт, по: прошлое + П.шагЗамера, длина: прошлое + П.шагЗамера - старт });
  return отрезки;
}

/** Снять кадр рилса на заданной секунде в png. */
function снятьКадр(файл, сек, куда) {
  spawnSync(FF, ['-hide_banner', '-nostdin', '-y', '-ss', String(сек), '-i', файл,
    '-frames:v', '1', '-q:v', '2', куда], { encoding: 'utf8' });
  return fs.existsSync(куда) && fs.statSync(куда).size > 0 ? куда : null;
}

/** Середины отрезков каждого кадра по тем же долям, что раскладывает сборщик. */
function серединыОтрезков(длина, кадров) {
  const веса = [];
  for (let k = 0; k < кадров; k++) {
    веса.push(k === 0 ? ДОЛИ.первый : k === кадров - 1 ? ДОЛИ.последний : ДОЛИ.средний);
  }
  const сумма = веса.reduce((a, b) => a + b, 0);
  const точки = [];
  let t = 0;
  for (const в of веса) {
    const шаг = длина * в / сумма;
    точки.push(+(t + шаг / 2).toFixed(2));
    t += шаг;
  }
  return точки;
}

// ВЫГЛЯДИТ ЛИ СЛОВО ОБРУБЛЕННЫМ. Проверка нужна для случая, когда край строки формально в кадре, но
// начало слова уже срезано: живой пример «вший лайкнул через год молчан» вместо «кто-то бывший
// лайкнул сторис через год молчания». Судим по строению слова, а не по словарю:
//   • в слове вообще нет гласной («вш», «нкл») — так русских слов не бывает;
//   • слово начинается с сочетания согласных, которого в начале русского слова не встречается («вш»).
// Список допустимых начал взят с запасом: лучше пропустить сомнительное слово, чем забраковать
// здоровый рилс из-за того, что распознавание перепутало букву.
const НАЧАЛА = new Set(('ст сп ск см сн сл св сх сц сб сд сг сж сз шк шт шп шв шл шн шр шм тр тв тк тм пр пл пс пт '
  + 'кр кл кв кн кт гр гл гн др дв дн бр бл вр вл вз вс вд вн вт вк фр фл хр хл хв зв зн зл зд зр мн мл чт чр щр '
  + 'жд жр жг цв ткн стр спр скр вкл взг встр здр сдв').split(/\s+/));
const ГЛАСНЫЕ = 'аеёиоуыэюя';
function обрублено(слово) {
  const с = String(слово).toLowerCase().replace(/[^а-яё]/g, '');
  if (с.length < 2) return false;                       // одна буква это чаще всего мусор чтения
  if (![...с].some((б) => ГЛАСНЫЕ.includes(б))) return true;
  const начало = с.slice(0, 2);
  if (ГЛАСНЫЕ.includes(с[0]) || ГЛАСНЫЕ.includes(с[1])) return false;  // согласная + гласная это норма
  return !НАЧАЛА.has(начало) && !НАЧАЛА.has(с.slice(0, 3));
}

/**
 * ПРОВЕРКА ГОТОВОГО РИЛСА.
 * @param {string} путь mp4
 * @param {object} o
 * @param {number} [o.ожидаемаяДлина] длина, которую насчитал сборщик (buildReel вернул duration)
 * @param {number} [o.кадров] сколько кадров склеено, по умолчанию 4
 * @param {string} [o.хук] текст хука, который сборщик нарисовал на первом кадре. Не обязателен, но
 *        сильно усиливает проверку обрезки: см. разбор в самой проверке
 * @returns {{ок:boolean, проблемы:string[], числа:object}}
 */
function проверитьРилс(путь, { ожидаемаяДлина, кадров = 4, хук = '' } = {}) {
  const проблемы = [];
  const числа = { файл: path.basename(путь) };
  if (!путь || !fs.existsSync(путь)) return { ок: false, проблемы: [`нет файла рилса: ${путь}`], числа };
  числа.вес_мб = +(fs.statSync(путь).size / 1048576).toFixed(2);

  const инфо = сведения(путь);
  числа.длина = +инфо.длина.toFixed(2);
  числа.холст = `${инфо.ширина}x${инфо.высота}`;
  if (!инфо.длина) return { ок: false, проблемы: ['ffmpeg не прочитал длительность: файл битый'], числа };

  // 1. ДЛИТЕЛЬНОСТЬ. Два разных вопроса: совпала ли она с расчётом сборщика (если разошлась, значит
  // фильтр съел или размножил кадры, ровно как в браке с zoompan) и попадает ли она в приказанный
  // коридор 9-13 секунд.
  if (Number.isFinite(ожидаемаяДлина) && ожидаемаяДлина > 0) {
    числа.ожидалось = +Number(ожидаемаяДлина).toFixed(2);
    const разбег = Math.abs(инфо.длина - ожидаемаяДлина);
    числа.разбег = +разбег.toFixed(2);
    if (разбег > П.разбегДлины) {
      проблемы.push(`длина ${инфо.длина.toFixed(2)} сек вместо ожидаемых ${Number(ожидаемаяДлина).toFixed(2)} `
        + `(разбег ${разбег.toFixed(2)} сек, допуск ${П.разбегДлины}): сборка потеряла или размножила кадры`);
    }
  }
  if (инфо.длина < П.минДлина || инфо.длина > П.максДлина) {
    проблемы.push(`длина ${инфо.длина.toFixed(2)} сек вне коридора ${П.минДлина}-${П.максДлина} секунд`);
  }

  // 2. ЧЁРНЫЕ ПРОВАЛЫ. Тот самый брак с обрывом после первого кадра. Затемнения на стыках короткие
  // и разрешены, всё, что тянется дольше 0.4 секунды, это дыра в монтаже.
  //
  // ЧТО ЭТА ПРОВЕРКА НАШЛА В ПЕРВОМ ЖЕ ПРОГОНЕ (11.08). На УЖЕ ИСПРАВЛЕННОМ рилсе
  // reel_01_gen01_улица.mp4 нашлись три дыры по 0.6 секунды ровно на стыках кадров, хотя затемнение
  // сборщик просит на 0.18. Причина не в fade: у фильтра zoompan своя выходная частота кадров, по
  // умолчанию 25, а на вход ему идут 30 кадров в секунду. Отрезок из 84 кадров растягивается с 2.76
  // до 3.32 секунды (замерено ffmpeg на той же цепочке фильтров), fade успевает увести картинку в
  // чёрное, и остаток отрезка держит пустоту. Общая длина при этом раздувается в 1.2 раза и режется
  // ключом -t, то есть последний кадр вдобавок теряет хвост. Лечится одним словом: zoompan=...:fps=30.
  // Гейт эту дыру видит и не пускает такой рилс дальше, даже когда его уже объявили починенным.
  const точки = яркостьПоВремени(путь);
  числа.замеров_яркости = точки.length;
  if (!точки.length) {
    проблемы.push('не вышло замерить яркость по времени: без этого чёрный провал не поймать');
  } else {
    числа.средняя_яркость = +(точки.reduce((s, т) => s + т.яркость, 0) / точки.length).toFixed(1);
    const чёрное = черныеОтрезки(точки);
    числа.черноты_секунд = +чёрное.reduce((s, о) => s + о.длина, 0).toFixed(2);
    for (const о of чёрное) {
      if (о.длина > П.чернаяДлина) {
        проблемы.push(`ЧЁРНЫЙ ПРОВАЛ ${о.длина.toFixed(2)} сек с ${о.с.toFixed(1)} по ${о.по.toFixed(1)} секунду `
          + `(разрешены только затемнения на стыках до ${П.чернаяДлина} сек): в этом месте рилс показывает пустоту`);
      }
    }
  }

  const времянка = fs.mkdtempSync(path.join(os.tmpdir(), 'reelgate-'));
  try {
    // 3. ТЕКСТ НЕ ОБРЕЗАН. Смотрим кадр на первой секунде: там стоит хук, и именно он страдает от
    // заливки 4:5 в 9:16. Требуем запас от края: если строка начинается в первых 40 px холста,
    // значит слева от неё что-то уже уехало за границу.
    const кадрХука = снятьКадр(путь, 1.0, path.join(времянка, 'hook.png'));
    if (!кадрХука) {
      проблемы.push('не вышло снять кадр на первой секунде: проверить хук на обрезку нечем');
    } else {
      let z = null;
      try { [z] = замерить([кадрХука]); } catch (e) { z = { ошибка: e.message }; }
      if (!z || z.ошибка) {
        // Нет питона или модели это НЕ повод рушить конвейер, но и молчать нельзя: пишем в числа,
        // чтобы дежурный видел, что проверка хука в этот раз не отработала.
        числа.текст_проверка = `не проверено: ${(z && z.ошибка) || 'замер не вышел'}`;
      } else {
        const W = z.ширина || инфо.ширина || 1080;
        числа.строк_на_обложке = z.всего;
        числа.текст = (z.строки || []).map((с) => с.текст).slice(0, 4).join(' / ');
        // ДЫРА, ЗАКРЫТАЯ 11.08 (пойман брак на рилсе Дарьи). Если сборщик передал текст хука, а на
        // обложке OCR не распознал НИ ОДНОЙ строки, это не «чистая картинка», а обрезанный или
        // нечитаемый хук: сильно срезанный текст распознавалка просто не собирает в строку, и файл
        // проходил гейт как чистый. Правило: есть hook_text, а строк ноль это брак по определению.
        const естьХук = String(хук || '').replace(/\s+/g, '').length >= 4;
        if (естьХук && (z.всего || 0) === 0 && !(z.клочья || []).length) {
          проблемы.push('ХУК НЕ ЧИТАЕТСЯ: у поста есть текст хука, а на обложке распознано ноль строк. '
            + 'Так проходил обрезанный хук «...друга ... я са» (текст срезан по краям, OCR не собрал строку)');
        }
        // КЛОЧЬЯ У КРАЯ (12.08, рилс Дарьи). Сильно обрезанный текст easyocr читает с уверенностью
        // ниже порога 0.45 (у Дарьи 0.29), «строк 0», и проверка полей молчала. Теперь textguard
        // отдаёт недоуверенные находки отдельным списком, и обрывок, КАСАЮЩИЙСЯ края кадра, это
        // брак без разговоров: настоящий текстовый мусор из текстур в край не упирается, а
        // срезанная заливкой строка упирается всегда.
        for (const к of z.клочья || []) {
          const слева = к.лево, справа = W - к.право;
          if (слева === undefined) continue;
          if (слева < П.полеТекста || справа < П.полеТекста) {
            проблемы.push(`ТЕКСТ УПИРАЕТСЯ В КРАЙ (обрывок, уверенность ${к.увер}): «${к.текст}» `
              + `от ${слева} px слева и ${справа} px справа. Обрезанную строку OCR читает плохо, `
              + 'поэтому раньше этот брак проходил как «строк 0»');
          }
        }
        // ХУК В ЗОНЕ ИНТЕРФЕЙСА. ПОРОГ ПОДНЯТ С 78% ДО 85% (14.08, приказ владельца «да ниже
        // писать, пересмотри правило что текст должен быть высоко»).
        //
        // ЧЕСТНО ПРО ПРОИСХОЖДЕНИЕ ПРЕЖНЕГО ЧИСЛА. 78% появилось 12.08 из обмера ДВУХ «финальных»
        // рилсов. Двух файлов мало, чтобы отсекать по ним 40% работы, и цена ошибки вылезла
        // сразу: чтобы уложиться в 78%, хук подняли до 73%, и он поехал НА ЛИЦО — замер детектором
        // лиц дал 6 обложек из 14. То есть строгий порог не защищал качество, а перегонял один
        // брак в другой, причём второй не ловился ничем.
        //
        // ОТКУДА 85%. Проверить по чужим рилсам не вышло: ссылки на обложки в радаре подписаны
        // Instagram коротким сроком и мертвы. Владелец выбрал положение по трём отрисованным
        // вариантам одного кадра — он смотрит ленту с телефона каждый день. Хук теперь кончается
        // на 82%, порог 85% даёт три пункта запаса на разброс OCR.
        //
        // ЭТО НЕ «ОТКЛЮЧИЛИ ПРОВЕРКУ». Старое положение 96px давало 87-91%, оно по-прежнему брак.
        // ═══ ПОТОЛОК СНЯТ (15.08, решение владельца) ═════════════════════════════════════════
        //
        // Он пересмотрел всю концепцию брака по подписи и сказал дословно: «хук под подписью —
        // фулл валид, переводим, всё ок, это не брак; хук на лице — тоже валид». И задал правило
        // целиком: «у нас надпись в нижней части экрана, 20-25 процентов снизу от экрана, и чтобы
        // в ширину влазила — больше ниче не надо».
        //
        // ЦЕНА ПРЕЖНЕГО ПРАВИЛА, ЧИСЛОМ. Порог 85% отправил в брак 323 рилса «хук под подписью» и
        // 289 «хук на лице» — 612 штук, две трети всего отсева. Владелец посмотрел их кадрами и
        // принял все. Он смотрит ленту с телефона каждый день, у него данные, которых нет у гейта:
        // гейт знает, где интерфейс инстаграма МОЖЕТ накрыть текст, а владелец видит, накрывает ли
        // на самом деле.
        //
        // ЧТО ОСТАЛОСЬ. Проверка ширины ниже — она и есть «чтобы в ширину влазила», и её он не
        // отменял: обрезанный по краю хук нечитаем при любом положении. А вертикальный потолок
        // снят: REELGATE_LOW по умолчанию 1.0, то есть браком считается только текст, физически
        // ушедший за нижнюю кромку кадра. Прежнюю строгость можно вернуть одной переменной:
        // REELGATE_LOW=0.85.
        const H916 = z.высота || инфо.высота || 1920;
        const ПОРОГ_НИЗА = Number(process.env.REELGATE_LOW || 1.0);
        for (const с of [...(z.строки || []), ...(z.клочья || [])]) {
          if (с.низ_px === undefined || с.центр < 0.5) continue;
          if (с.низ_px / H916 > ПОРОГ_НИЗА) {
            проблемы.push(`ТЕКСТ УШЁЛ ЗА КРОМКУ: строка «${с.текст}» кончается на `
              + `${Math.round((с.низ_px / H916) * 100)}% высоты при пороге `
              + `${Math.round(ПОРОГ_НИЗА * 100)}%`);
            break;
          }
        }
        for (const с of z.строки || []) {
          const слева = с.лево, справа = W - с.право;
          if (слева === undefined) continue;
          if (слева < П.полеТекста || справа < П.полеТекста) {
            проблемы.push(`ТЕКСТ УПИРАЕТСЯ В КРАЙ: строка «${с.текст}» стоит от ${слева} px слева и `
              + `${справа} px справа при запасе ${П.полеТекста} px. Так и уехал в ленту обрезанный хук `
              + '«вший лайкнул через год молчан»');
            continue;
          }
          // Слово у самого края разглядываем отдельно: бывает, что рамка строки формально в кадре,
          // а первое слово уже без начала. За пределами краевой полосы этот разбор не ведём, иначе
          // ошибки распознавания в середине кадра дают ложный брак.
          const слова = String(с.текст).split(/\s+/).filter(Boolean);
          const пары = [[слова[0], слева, 'первое'], [слова[слова.length - 1], справа, 'последнее']];
          for (const [слово, запас, где] of пары) {
            if (!слово || запас > П.зонаКрая) continue;
            if (обрублено(слово)) {
              проблемы.push(`ТЕКСТ ОБРУБЛЕН: ${где} слово строки «${с.текст}» это «${слово}», а до края `
                + `всего ${запас} px: начало или конец фразы срезано заливкой кадра в 9:16`);
            }
          }
        }
        // КРАЙНИЕ СЛОВА ХУКА ОБЯЗАНЫ ДОЖИТЬ ДО ЭКРАНА. Проверка по полям ловит строку, которая
        // упёрлась в край, но у неё есть слепое пятно: при сильной обрезке кусок строки перестаёт
        // читаться ВООБЩЕ, и в распознанном тексте её просто нет, а поля у оставшихся строк в
        // порядке. Замер это подтвердил: та же обложка, обрезанная до 70 процентов ширины, дала
        // «самом деле Цветотип» (слово «на» пропало), а при более грубой обрезке нижняя строка
        // исчезла из чтения целиком. Поэтому, когда сборщик передал сам текст хука, сверяем
        // ПЕРВОЕ и ПОСЛЕДНЕЕ его слово: именно они уезжают за край первыми. Середину не сверяем,
        // распознавание там путает буквы, и точное совпадение требовать нельзя.
        if (хук) {
          const норм = (s) => String(s).toLowerCase().replace(/[^а-яёa-z0-9 ]+/gi, ' ').replace(/\s+/g, ' ').trim();
          const прочитано = норм((z.строки || []).map((с) => с.текст).join(' '));
          const слова = норм(хук).split(' ').filter((w) => w.length >= 3);
          const края = [слова[0], слова[слова.length - 1]].filter(Boolean);
          const пропали = [...new Set(края)].filter((w) => прочитано && !прочитано.includes(w));
          // ОДНО НЕПРОЧИТАННОЕ КРАЙНЕЕ СЛОВО — ЭТО ШУМ РАСПОЗНАВАНИЯ, А НЕ ОБРЕЗКА (14.08).
          //
          // ЧТО ИЗМЕНИЛОСЬ. После того как хук опустили до 82% и сузили блок до полей 200px, кегль
          // на длинных фразах падает до 28px, и OCR начал промахиваться на отдельных словах. Брак
          // по этому правилу подскочил с 7-13% до 44%: каждый второй готовый рилс шёл в мусор.
          //
          // ПОЧЕМУ ЭТО ИМЕННО ШУМ, А НЕ БРАК. Независимый скан (reelscan.cjs) меряет края текста
          // ГЕОМЕТРИЧЕСКИ, по пикселям, и на тех же файлах даёт поля в норме — 94 из 94 чисто. То
          // есть слово физически в кадре, просто не распозналось. Комментарий выше это косвенно и
          // признаёт: «середину не сверяем, распознавание там путает буквы» — края подвержены тому
          // же, просто чуть меньше.
          //
          // ЧТО ОСТАЛОСЬ ЗАЩИЩЁННЫМ. Настоящая обрезка уносит НАЧАЛО И КОНЕЦ разом (заливка в 9:16
          // режет обе стороны симметрично), поэтому два пропавших слова по-прежнему брак. Плюс
          // никуда не делись прямые геометрические правила выше: «ТЕКСТ УПИРАЕТСЯ В КРАЙ» и «ТЕКСТ
          // ОБРУБЛЕН» меряют пиксели, а не буквы, и ловят обрезку без участия распознавания.
          //
          // Порог вынесен в REELGATE_WORDS на случай, если владелец захочет прежнюю строгость.
          const НАДО_ПРОПАВШИХ = Number(process.env.REELGATE_WORDS || 2);
          if (прочитано && пропали.length && пропали.length < НАДО_ПРОПАВШИХ) {
            console.log(`  · ${path.basename(путь)}: не прочитано слово «${пропали[0]}» из хука — `
              + 'считаю шумом распознавания, геометрия краёв в норме');
          }
          if (прочитано && пропали.length >= НАДО_ПРОПАВШИХ) {
            проблемы.push(`ХУК ПРОЧИТАН НЕ ЦЕЛИКОМ: на кадре нет слов «${пропали.join('», «')}» из хука `
              + `«${хук}». На экране видно «${прочитано.slice(0, 80)}»: край фразы срезан заливкой в 9:16`);
          }
        }
      }
    }

    // 4. ЗВУК. Рилс без музыки алгоритм почти не раздаёт (правило владельца 03.08), а тихая дорожка
    // это тот же ноль: слышно её не будет. Мерим средний уровень, а не просто наличие дорожки, потому
    // что при обрыве трека ffmpeg честно кладёт в файл тишину, и по составу потоков всё выглядит цело.
    числа.дорожка = инфо.естьЗвук;
    if (!инфо.естьЗвук) {
      проблемы.push('в рилсе НЕТ звуковой дорожки: без музыки охват падает почти в ноль');
    } else {
      const t = фф(['-i', путь, '-vn', '-af', 'volumedetect', '-f', 'null', '-']);
      const m = t.match(/mean_volume:\s*(-?\d+(?:\.\d+)?) dB/);
      const p = t.match(/max_volume:\s*(-?\d+(?:\.\d+)?) dB/);
      числа.звук_средний_db = m ? parseFloat(m[1]) : null;
      числа.звук_пик_db = p ? parseFloat(p[1]) : null;
      if (числа.звук_средний_db === null) проблемы.push('не вышло замерить громкость дорожки');
      else if (числа.звук_средний_db < П.тишина) {
        проблемы.push(`дорожка почти тишина: средний уровень ${числа.звук_средний_db} dB при пороге ${П.тишина} dB`);
      }
    }

    // 5. ВСЕ КАДРЫ РАЗНЫЕ. Берём снимок из СЕРЕДИНЫ каждого отрезка (на стыке идёт затемнение, там
    // любые два кадра похожи) и сравниваем отпечатки соседей. Одинаковые соседи значат, что склейка
    // сломалась: либо один кадр показан дважды, либо всё после первого ушло в черноту.
    const середины = серединыОтрезков(инфо.длина, кадров);
    числа.секунды_замера = середины.join(', ');
    const отпечатки = середины.map((сек, i) => {
      const f = снятьКадр(путь, сек, path.join(времянка, `f${i + 1}.png`));
      try { return f ? hashImage(f) : null; } catch { return null; }
    });
    числа.расхождения = {};
    for (let i = 1; i < отпечатки.length; i++) {
      if (!отпечатки[i] || !отпечатки[i - 1]) {
        проблемы.push(`не вышло снять кадр отрезка ${отпечатки[i] ? i : i + 1}: сравнить кадры нечем`);
        continue;
      }
      const d = hamming(отпечатки[i - 1], отпечатки[i]);
      числа.расхождения[`${i}-${i + 1}`] = d;
      if (d < П.отличиеКадров) {
        проблемы.push(`кадры ${i} и ${i + 1} на ${середины[i - 1]} и ${середины[i]} секунде практически одинаковые `
          + `(расхождение ${d} бит, нужно от ${П.отличиеКадров}): склейка сломалась, отрезок показывает не свой кадр`);
      }
    }
  } finally {
    try { fs.rmSync(времянка, { recursive: true, force: true }); } catch {}
  }

  return { ок: проблемы.length === 0, проблемы, числа };
}

module.exports = { проверитьРилс, П, обрублено, яркостьПоВремени, черныеОтрезки, серединыОтрезков };

if (require.main === module) {
  const [файл, длина, кадров] = process.argv.slice(2);
  if (!файл) { console.log('usage: node reelgate.cjs файл.mp4 [ожидаемаяДлина] [кадров]'); process.exit(1); }
  const r = проверитьРилс(файл, {
    ожидаемаяДлина: длина ? Number(длина) : undefined,
    кадров: кадров ? Number(кадров) : 4,
    хук: process.env.HOOK || '',   // сверка крайних слов хука включается, когда его текст известен
  });
  console.log(JSON.stringify(r.числа, null, 1));
  console.log(r.ок ? 'ГЕЙТ РИЛСА: чисто' : 'ГЕЙТ РИЛСА: брак\n - ' + r.проблемы.join('\n - '));
  process.exit(r.ок ? 0 : 2);
}
