// ХОЛОДНЫЙ ВАРИАНТ. Начальник просил «чуть заваленный баланс белого в тёплую ИЛИ холодную сторону»,
// поэтому уход по цвету задаётся отдельным ключом и его можно перевернуть, не заводя третий пресет.
const ТЕМПЕРАТУРЫ = { тепло: -1, холод: 1, нейтрально: 0 };

/**
 * Множитель силы: 0 это исходник, 1 это пресет как записан, 2 это вдвое громче.
 * Не всё тянется линейно, и два ограничителя тут стоят по итогам осмотра:
 *   · ЦВЕТ. Уход по балансу белого выше 0.5 микса на силе 1.4 и дальше давал апельсиновое лицо,
 *     это уже не «телефон в тёплой комнате», а фильтр. Микс упёрт в 0.5.
 *   · ВИНЬЕТКА. На силе 1.4 кадр темнел по всему периметру и читался как ретро-обработка. Угол
 *     виньетки упёрт, дальше растёт только зерно, мыло и сжатие.
 */
function масштаб(п, сила, куда = 'тепло') {
  const k = Math.max(0, сила);
  const знак = ТЕМПЕРАТУРЫ[куда] ?? -1;
  // Температуру считаем как отход от нейтральных 6500К: тепло вниз, холод вверх.
  const дельта = Math.abs(6500 - п.температура) * k;
  return {
    ...п,
    зерно: п.зерно * k,
    зерноКрупное: (п.зерноКрупное || 0) * k,
    зерноХрома: п.зерноХрома * k,
    мягкость: п.мягкость * k,
    подрезка: п.подрезка * Math.min(1, k),   // подрезку выше пресета не гоним: пойдут ореолы
    хромаМыло: п.хромаМыло * k,
    сдвигЦвета: Math.round(п.сдвигЦвета * k),
    температура: Math.round(6500 + знак * дельта),
    темпМикс: Math.min(0.5, п.темпМикс * k),
    углы: п.углы * k,
    виньетка: Math.min(1.0, п.виньетка * k),
    контраст: 1 - (1 - п.контраст) * k,
    подъёмТени: п.подъёмТени * k,
    гало: Math.min(0.5, (п.гало || 0) * k),
    пересвет: (п.пересвет || 0) * Math.min(1.6, k),
    шумодав: (п.шумодав || 0) * Math.min(1.6, k),
    доляСвета: п.доляСвета || 0.25,
    ступеньки: п.ступеньки || 0,
    // Сжатие тянем от 2 (почти чисто) к значению пресета: при силе 0 артефактов быть не должно.
    jpeg: Math.max(2, Math.min(12, Math.round(2 + (п.jpeg - 2) * k))),
  };
}

// ═══ ЛИЦО ═══════════════════════════════════════════════════════════════════════════════════════
// Тот же детектор, каким проект уже мерит лица (yunet.onnx, как в ttkit.cjs и sharpmeter.cjs).
// Нужен ровно для одного: вырезать лицо из маски углового мыла. Детектор недоступен, работаем без
// вырезки: маска и так держит центр резким, просто без страховки на смещённый портрет.
const PY_ЛИЦО = `
import sys, json, cv2
img = cv2.imread(sys.argv[1])
h, w = img.shape[:2]
d = cv2.FaceDetectorYN_create(sys.argv[2], '', (w, h), 0.5, 0.3, 200)
d.setInputSize((w, h))
_, f = d.detect(img)
out = []
if f is not None:
    for r in f:
        out.append([float(r[0]), float(r[1]), float(r[2]), float(r[3])])
out.sort(key=lambda t: -t[2] * t[3])
print(json.dumps({'w': w, 'h': h, 'faces': out}))
`;

function лицоКадра(файл) {
  if (!fs.existsSync(YUNET)) return null;
  try {
    const r = spawnSync('python3', ['-c', PY_ЛИЦО, файл, YUNET], { encoding: 'utf8', maxBuffer: 1 << 22 });
    const стр = String(r.stdout || '').trim().split('\n').filter((s) => s.startsWith('{')).pop();
    if (!стр) return null;
    const j = JSON.parse(стр);
    if (!j.faces || !j.faces.length) return null;
    const [x, y, w, h] = j.faces[0];
    return { cx: x + w / 2, cy: y + h / 2, r: Math.max(w, h) / 2, кадр: { w: j.w, h: j.h } };
  } catch { return null; }
}

// ═══ МАСКА УГЛОВ ════════════════════════════════════════════════════════════════════════════════
// Белое там, где ставим мыло, чёрное там, где оставляем как есть. Радиус нормируем на половину
// кадра, так что в углу нормированный радиус равен примерно 1.41.
//
// Запятые внутри выражения geq обязаны быть экранированы: в filter_complex запятая разделяет
// фильтры. Поэтому вместо hypot(a,b) стоит sqrt(a*a+b*b), а вместо max(0,t) стоит (t+abs(t))/2:
// так выражение обходится без запятых совсем и не зависит от экранирования.
function маскаУглов(нач, лицо) {
  const r = 'sqrt(((X-W/2)/(W/2))*((X-W/2)/(W/2))+((Y-H/2)/(H/2))*((Y-H/2)/(H/2)))';
  const t = `((${r})-${нач.toFixed(3)})/${(1.42 - нач).toFixed(3)}`;   // 0 в центре, 1 в углу
  const t0 = `((${t})+abs(${t}))/2`;                                    // отрицательное в ноль
  let выр = `255*(${t0})*(${t0})`;                                      // квадрат: плавный вход
  if (лицо) {
    // ВЫРЕЗКА ЛИЦА. Внутри 1.3 радиуса лица маска ноль, дальше плавно набирает до единицы к 2.2
    // радиуса. Портрет бывает смещён к краю кадра, и без этой вырезки угловое мыло съедало бы
    // щёку, а с ней и сходство персоны.
    const rf = `sqrt((X-${Math.round(лицо.cx)})*(X-${Math.round(лицо.cx)})+(Y-${Math.round(лицо.cy)})*(Y-${Math.round(лицо.cy)}))`;
    const вн = Math.round(лицо.r * 1.3), нар = Math.round(лицо.r * 2.2);
    const f = `((${rf})-${вн})/${Math.max(1, нар - вн)}`;
    const f0 = `((${f})+abs(${f}))/2`;
    выр = `(${выр})*min(1\\,${f0})`;   // min с запятой, поэтому экранируем её
  }
  return выр;
}

// ═══ ЦЕПОЧКА ФИЛЬТРОВ ═══════════════════════════════════════════════════════════════════════════
function цепочка(п, лицо) {
  // ГАЛО ВОКРУГ СВЕТА (добавлено 11.08 после замечания «там свет, снимок студийный»). Это ответ
  // ровно на свет, а не на зерно: у телефона объектив дешёвый, и вокруг лампы, гирлянды и окна свет
  // ПОДТЕКАЕТ на соседние пиксели. У генерации лампа горит с идеально резкой границей, и именно это
  // читается как студийный кадр или как рендер.
  // Как сделано: копия кадра, в которой всё темнее 200 обнулено, размывается и подмешивается
  // экраном. Свойство «само себя выключает»: если ярких пятен в кадре нет, копия чёрная, а экран с
  // чёрным ничего не меняет, поэтому дневной кадр без источников света не трогается вообще.
  // Считаем в gbrp, а не в yuv: в yuv экранное смешивание тащит за собой цветность и кадр уходит в
  // серый или в сирень (проверено, оба брака видел глазами).
  const гало = п.гало > 0.02
    ? 'format=gbrp,split=2[о][г];'
      + `[г]lutrgb=r='if(gt(val\\,200)\\,val\\,0)':g='if(gt(val\\,200)\\,val\\,0)':b='if(gt(val\\,200)\\,val\\,0)',`
      + `gblur=sigma=26[г2];[о][г2]blend=all_mode=screen:all_opacity=${Math.min(0.5, п.гало).toFixed(3)}`
    : null;
  const общие = [
    гало,
    'format=yuv444p',
    // 1. Баланс белого уводим в сторону: студийная нейтральность это первый признак генерации.
    п.темпМикс > 0.01 ? `colortemperature=temperature=${п.температура}:mix=${п.темпМикс.toFixed(3)}` : null,
    // 2. Контраст и тени: дешёвая матрица не держит диапазон, чёрное не бывает чёрным.
    п.контраст < 0.999 ? `eq=contrast=${п.контраст.toFixed(3)}:brightness=${п.подъёмТени.toFixed(3)}` : null,
    // 3. Общая мягкость слабая, сразу с подрезкой: вместе они дают телефонный «перешарпленный
    //    поверх мыла» вид и почти не снимают резкость с лица (проверено замером sharpmeter).
    п.мягкость > 0.02 ? `gblur=sigma=${п.мягкость.toFixed(3)}` : null,
    п.подрезка > 0.02 ? `unsharp=5:5:${п.подрезка.toFixed(2)}:5:5:0` : null,
    // 4. Хроматическая грязь: цвет мылим сильнее яркости (planes=6 это только Cb и Cr) и разводим
    //    красный с синим на пиксель. Ровно этого не хватает чистым генерациям на границах.
    п.хромаМыло > 0.05 ? `gblur=sigma=${п.хромаМыло.toFixed(2)}:planes=6` : null,
    // СДВИГ ЦВЕТА ТОЛЬКО ПО ЧИСТОМУ КАДРУ. На кадре с уже впечатанной плашкой этот сдвиг даёт
    // красно-синюю кайму на БУКВАХ, и надпись читается как битая печать, а не как снимок телефона
    // (видно на осмотре строки «нейронка про шаблоны» в углу). Поэтому при плашка=true он выключен.
    п.сдвигЦвета >= 1 && !п.надПлашкой
      ? `rgbashift=rh=${п.сдвигЦвета}:bh=${-п.сдвигЦвета}:rv=${Math.round(п.сдвигЦвета / 2)}` : null,
    // 5. Виньетка: у телефона она есть всегда, у генерации её нет.
    п.виньетка > 0.03 ? `vignette=angle=${(Math.PI / 12 * Math.min(3, п.виньетка)).toFixed(4)}` : null,
  ].filter(Boolean).join(',');

  // 6. Падение резкости к углам. Мылим копию целиком и подмешиваем её по радиальной маске.
  const углы = п.углы > 0.1
    ? `split=3[осн][мыл][мск];[мыл]gblur=sigma=${п.углы.toFixed(2)}[мыл2];`
      + `[мск]geq=lum='${маскаУглов(п.угловНачало, лицо)}':cb=128:cr=128[мск2];`
      + `[осн][мыл2][мск2]maskedmerge`
    : null;

  // ═══ ПРИЗНАКИ СЕНСОРА, А НЕ ЦВЕТОКОРРЕКЦИЯ ══════════════════════════════════════════════════
  // Переделано 11.08 по приказу начальника: «не глуши фильтрами насыщенность фото, это не то что
  // даёт ему ощущение снимка на айфон, поресерчь и найди другие фильтры». Гашение цвета убрано
  // совсем (см. подВайб), а телефонность набирается четырьмя признаками, которых у рендера НЕТ ни
  // одного. Каждый разобран на месте, чтобы через месяц не гадать, зачем он тут.

  // 7. ПЕРЕСВЕТ СО СРЕЗОМ. У телефона динамический диапазон маленький: лампа, окно и блик на коже
  //    уходят в белое и там ТЕРЯЮТ детали, причём переход к белому мягкий, а не резкий. У модели
  //    света всегда аккуратно выдержаны, ни одного выбитого пикселя, и это выдаёт рендер сразу.
  //    Кривая тянет верхнюю треть вверх и подпирает её к единице, тени не трогает вообще.
  const пересвет = п.пересвет > 0.02
    ? `curves=all='0/0 0.5/0.5 ${(0.75).toFixed(2)}/${(0.75 + 0.09 * п.пересвет).toFixed(3)} `
      + `0.9/${Math.min(0.999, 0.9 + 0.09 * п.пересвет).toFixed(3)} 1/1'`
    : null;

  // 8. МЫЛО ШУМОДАВА НА ОДНОТОННОМ, КРАЙ РЕЗКИЙ. Самый узнаваемый признак телефона и самый
  //    незаметный по цифрам: шумодав в телефоне давит шум там, где нет деталей (стена, кожа, небо),
  //    и не лезет на контуры, чтобы не мазать. Получается ровная «пластилиновая» стена при резком
  //    контуре головы. У модели наоборот: ровный микрорельеф по всему полю.
  //    smartblur ровно про это: положительный порог означает «мылить только плавные участки».
  const шумодав = п.шумодав > 0.02
    ? `smartblur=luma_radius=${(1.4 + п.шумодав).toFixed(2)}:luma_strength=${Math.min(1, 0.55 * п.шумодав).toFixed(2)}:luma_threshold=18`
    : null;

  // 9. ЗЕРНО ЖИВЁТ В ТЕНЯХ. Главная правка после приговора «зерна нет»: ровное зерно по всему кадру
  //    это плёнка, а не сенсор. У сенсора шум там, где мало света: в тенях и полутенях его видно, в
  //    светах он тонет. Поэтому зерно кладём НЕ на весь кадр, а по маске теней, и вместе с ним
  //    в тени уходят цветные пятна (пункт 10). В светах остаётся слабый ровный след (доляСвета),
  //    иначе света выглядят «вырезанными» и это тоже читается как рендер.
  //    Маска: копия кадра, где яркость перевёрнута и растянута, то есть белое в тенях и полутенях,
  //    чёрное в светах. ПОРОГ 205, А НЕ 150, и это правка по замеру: с порогом 150 щека выпадала из
  //    маски целиком (зерно на ней 0.76 до и 0.72 после, то есть ноль), а начальник одобрил вид
  //    именно с зерном на коже. Физике это не противоречит: шум пропадает не на светлой коже, а в
  //    настоящих светах, где сигнал упёрся в потолок.
  //    ИТОГОВАЯ МАСКА: полная сила до яркости 150, дальше плавный спад до нуля к 235. По замеру это
  //    даёт на щеке около 70 процентов силы (было 30 при первом варианте и 0 при пороге 150), на
  //    тёмной стене полную, на выбитой лампе почти ноль. Тем самым кожа держит одобренный уровень
  //    зерна, а света остаются чистыми, как у сенсора.
  const зернаЕсть = п.зерно > 0.5 || п.зерноКрупное > 0.5;
  const слоиЗерна = [
    // крупное зерно: половинное разрешение, потому что пиксельное в ленте усредняется и пропадает
    п.зерноКрупное > 0.5
      ? `split=2[чист][ш];[ш]lutyuv=y=128:u=128:v=128,scale=iw/2:ih/2,noise=c0s=${Math.round(п.зерноКрупное)}:c0f=u,`
        + 'scale=iw*2:ih*2:flags=bilinear[ш2];[чист][ш2]blend=all_mode=grainmerge:all_opacity=1'
      : null,
    п.зерно > 0.5 ? `noise=c0s=${Math.round(п.зерно)}:c0f=u` : null,
    // 10. ЦВЕТНЫЕ ПЯТНА В ТЕНЯХ. У мелкой матрицы шум не только яркостный: в тёмных участках
    //     появляются пятна по цвету, зелёные и лиловые. Делаем шумом по цветовым плоскостям с
    //     последующим слабым размытием ТОЛЬКО цвета (planes=6): точки слипаются в пятна, как в жизни.
    //     Это добавляет цвета, а не отнимает, то есть работает в ту сторону, в которую просил
    //     начальник.
    п.зерноХрома > 0.5
      ? `noise=c1s=${Math.round(п.зерноХрома)}:c1f=u:c2s=${Math.round(п.зерноХрома)}:c2f=u,gblur=sigma=1.1:planes=6`
      : null,
  ].filter(Boolean).join(',');
  const тени = зернаЕсть
    ? `split=3[бсв][бш][бмск];[бш]${слоиЗерна}[бш2];`
      + `[бмск]lutyuv=y='clip((235-val)*3.2\\,0\\,255)':u=128:v=128[бмск2];`
      + '[бсв][бш2][бмск2]maskedmerge'
    : null;
  // Слабый ровный след по всему кадру, включая света: примерно четверть силы теневого зерна.
  const светаСлед = зернаЕсть && п.доляСвета > 0.01
    ? `noise=c0s=${Math.max(1, Math.round(п.зерно * п.доляСвета))}:c0f=u`
    : null;

  // 11. СТУПЕНЬКИ В ТЕМНОТЕ. Восемь бит плюс шумодав дают в тёмных плавных переходах видимые
  //     полосы. У модели переход идеально гладкий. Квантуем яркость ТОЛЬКО ниже 90, чтобы не
  //     тронуть кожу и света.
  const ступеньки = п.ступеньки > 0.5
    ? `lutyuv=y='if(lt(val\\,90)\\,floor(val/${Math.round(п.ступеньки)})*${Math.round(п.ступеньки)}\\,val)'`
    : null;

  return [общие, пересвет, шумодав, углы, ступеньки, тени, светаСлед, 'format=yuvj420p']
    .filter(Boolean).join(',');
}

/**
 * Сделать из готового кадра снимок телефона.
 * @param {string} вход путь к готовому кадру
 * @param {string} выход куда положить (jpeg)
 * @param {{пресет?:string, сила?:number, уход?:string, лицо?:object|null}} o
 * @returns {{выход:string, пресет:string, сила:number, jpeg:number}}
 */
function телефонный(вход, выход, o = {}) {
  if (!FF || !fs.existsSync(FF)) throw new Error('ffmpeg-static не найден');
  if (!fs.existsSync(вход)) throw new Error(`нет кадра: ${вход}`);
  const имяП = String(o.пресет || process.env.PHONE_PRESET || '11');
  const база = ПРЕСЕТЫ[имяП];
  if (!база) throw new Error(`нет пресета «${имяП}», есть: ${Object.keys(ПРЕСЕТЫ).join(', ')}`);
  const сила = o.сила != null ? Number(o.сила) : Number(process.env.PHONE_FORCE || 1);
  const п = масштаб(база, сила, o.уход || 'тепло');
  // Кадр уже с надписью от нас (пакетная прогонка готовых постов): щадящий режим по буквам.
  п.надПлашкой = !!o.надПлашкой;
  // Лицо ищем один раз и его можно передать снаружи: в пакетной прогонке одного кадра в четырёх
  // силах детектор незачем звать четыре раза.
  const лицо = o.лицо !== undefined ? o.лицо : лицоКадра(вход);

  const args = ['-y', '-hide_banner', '-loglevel', 'error', '-i', вход,
    '-filter_complex', цепочка(п, лицо),
    '-frames:v', '1', '-c:v', 'mjpeg', '-q:v', String(п.jpeg), выход];
  const r = spawnSync(FF, args, { encoding: 'utf8', maxBuffer: 1 << 24 });
  if (r.status !== 0 || !fs.existsSync(выход) || !fs.statSync(выход).size) {
    throw new Error(`ffmpeg код ${r.status}: ${String(r.stderr || '').slice(-400)}`);
  }
  return { выход, пресет: имяП, сила, jpeg: п.jpeg, лицоНайдено: !!лицо };
}

/**
 * Обработать кадр НА МЕСТЕ, для встройки в конвейер. Никогда не роняет вызывающего: телефонная
 * плёнка это косметика, и если ffmpeg почему-то не сработал, пост обязан уйти с исходным кадром,
 * а не упасть целиком.
 * @param {string} файл кадр, который перезапишется обработанным
 * @param {object} o те же параметры, что у телефонный()
 * @returns {boolean} применилось или нет
 */
function телефонныйНаМесте(файл, o = {}) {
  if (process.env.PHONE_LOOK === '0') return false;
  try {
    const врем = `${файл}.phone.jpg`;
    телефонный(файл, врем, o);
    fs.renameSync(врем, файл);
    return true;
  } catch (e) {
    console.log(`  ⚠ телефонная плёнка не легла на ${path.basename(файл)}: ${String(e.message).slice(0, 90)}`);
    return false;
  }
}

/** Разложить один кадр в несколько сил рядом, для осмотра глазами. */
function лесенка(вход, кудаПапка, { пресет = '11', силы = [0.6, 1, 1.4, 1.8], уход = 'тепло' } = {}) {
  fs.mkdirSync(кудаПапка, { recursive: true });
  const л = лицоКадра(вход);
  const имя = path.basename(вход).replace(/\.[a-z]+$/i, '');
  const из = [];
  for (const с of силы) {
    const o = path.join(кудаПапка, `${имя}__${пресет}_x${String(с).replace('.', '_')}.jpg`);
    телефонный(вход, o, { пресет, сила: с, уход, лицо: л });
    из.push({ сила: с, файл: o });
  }
  return из;
}

// ═══ ВАЙБ ИСХОДНИКА ═════════════════════════════════════════════════════════════════════════════
// РАЗВИТИЕ ЗАДАЧИ ОТ НАЧАЛЬНИКА 11.08, дословно: «кадр 1 если с пинтереста, смысл его трогать?
// может можем считывать качество фото или вайб обработки 1 кадра чтобы делать 3 и 4 такого же
// качества». Мысль верная и она снимает главную слабость пресетов: силу зерна больше не надо
// выдумывать на вкус. Кадр 1 это ЖИВАЯ фотография с пинтереста, снятая настоящим телефоном, значит
// она сама и есть эталон. Мерим её численно и подгоняем кадры 3 и 4 под ту же камеру.
//
// ЧТО МЕРИМ И ПОЧЕМУ ИМЕННО ЭТО (девять чисел, все считаются по кадру в размере доставки 1080,
// потому что сравнивать надо в том виде, в котором кадр увидят):
//   · зерно      разброс верхних частот по САМЫМ РОВНЫМ участкам кадра. Ровные участки берём
//                нижними по локальной дисперсии: на них нет деталей, и всё, что там шумит, это шум
//                матрицы. Мерить шум по всему кадру нельзя, там его не отличить от текстуры свитера.
//   · резкость   дисперсия лапласиана на сетке 256, как в sharpmeter.cjs: цифра не должна зависеть
//                от размера файла.
//   · лицо       та же дисперсия, но по боксу лица. Отдельно, потому что именно её нам нельзя
//                уронить, и именно она отвечает за сходство персоны.
//   · контраст   стандартное отклонение яркости плюс размах между 2 и 98 процентилями.
//   · тепло/зелень отношения средних каналов R/G и B/G. Это и есть баланс белого «как снял телефон».
//   · насыщенность средняя S в HSV.
//   · виньетка   отношение средней яркости угловой рамки к центру. У телефона меньше единицы, у
//                генерации около единицы.
//   · блочность  скачок яркости на границах сетки 8 на 8 против скачка внутри блоков. Это прямой
//                след жадного jpeg, у чистой генерации он около нуля.
const PY_ПРОФИЛЬ = String.raw`
import sys, json, numpy as np, cv2

YUNET, ДОСТАВКА = sys.argv[1], 1080

def лицо(bgr):
    H, W = bgr.shape[:2]
    try:
        d = cv2.FaceDetectorYN.create(YUNET, "", (W, H), 0.6, 0.3, 5000)
        d.setInputSize((W, H)); _, f = d.detect(bgr)
    except Exception:
        return None
    if f is None or len(f) == 0: return None
    f = sorted(f, key=lambda r: r[2] * r[3])[-1]
    return [float(v) for v in f[:4]]

def лап(g, сетка=256):
    if g is None or g.size == 0 or min(g.shape[:2]) < 3: return 0.0
    return float(cv2.Laplacian(cv2.resize(g, (сетка, сетка), interpolation=cv2.INTER_AREA), cv2.CV_64F).var())

def зерно(g):
    """Шум по РОВНЫМ участкам. Кадр режем на клетки 24px, в каждой считаем разброс верхних частот
    (клетка минус её размытие) и отдельно «деталистость» (разброс самой клетки). Берём медиану
    верхних частот по четверти самых ровных клеток: там деталей нет, и остаётся только шум."""
    f = g.astype(np.float32)
    вч = f - cv2.GaussianBlur(f, (0, 0), 1.1)
    H, W = g.shape[:2]; b = 24
    ш, д = [], []
    for y in range(0, H - b, b):
        for x in range(0, W - b, b):
            ш.append(float(np.std(вч[y:y+b, x:x+b]))); д.append(float(np.std(f[y:y+b, x:x+b])))
    if not ш: return 0.0
    ш = np.array(ш); д = np.array(д)
    порог = np.percentile(д, 25)
    ровные = ш[д <= порог]
    return float(np.median(ровные if ровные.size else ш))

def блочность(g):
    """След жадного jpeg: перепад на границах сетки 8 против перепада внутри блоков."""
    f = g.astype(np.float32)
    d = np.abs(np.diff(f, axis=1))
    гр = d[:, 7::8].mean() if d.shape[1] > 8 else 0.0
    вн = np.delete(d, np.s_[7::8], axis=1).mean() if d.shape[1] > 8 else 1.0
    return float(гр / вн) if вн else 1.0

def виньетка(g):
    H, W = g.shape[:2]
    центр = float(g[int(H*0.35):int(H*0.65), int(W*0.35):int(W*0.65)].mean())
    рамка = float(np.mean([g[:int(H*0.10), :].mean(), g[int(H*0.90):, :].mean(),
                           g[:, :int(W*0.10)].mean(), g[:, int(W*0.90):].mean()]))
    return round(рамка / центр, 4) if центр else 1.0

out = []
for путь in sys.argv[2:]:
    bgr = cv2.imread(путь, cv2.IMREAD_COLOR)
    if bgr is None:
        out.append({"файл": путь, "ошибка": "не декодируется"}); continue
    H, W = bgr.shape[:2]
    k = min(1.0, float(ДОСТАВКА) / float(max(W, H)))
    if k < 1.0: bgr = cv2.resize(bgr, (int(W*k), int(H*k)), interpolation=cv2.INTER_AREA)
    g = cv2.cvtColor(bgr, cv2.COLOR_BGR2GRAY)
    hsv = cv2.cvtColor(bgr, cv2.COLOR_BGR2HSV)
    b, зел, r = [float(bgr[:, :, i].mean()) + 1e-6 for i in range(3)]
    p2, p98 = np.percentile(g, [2, 98])
    л = лицо(bgr)
    r_ = {
      "файл": путь, "ш": bgr.shape[1], "в": bgr.shape[0],
      "зерно": round(зерно(g), 3),
      "резкость": round(лап(g), 1),
      "лицо": None, "лицо_найдено": л is not None,
      "контраст": round(float(np.std(g)), 2), "размах": round(float(p98 - p2), 1),
      "тепло": round(r / зел, 4), "зелень": round(b / зел, 4),
      "насыщенность": round(float(hsv[:, :, 1].mean()), 2),
      "виньетка": виньетка(g),
      # ДОЛЯ СВЕТЛЫХ И ТЁМНЫХ ПИКСЕЛЕЙ. Средняя яркость одна врёт: вечерний кадр с большой лампой и
      # серый уличный день дают похожее среднее. Доля светлого ловит небо, снег и окно днём, доля
      # тёмного ловит вечер и неон.
      "светлые": round(float((g > 190).mean()), 4),
      "тёмные": round(float((g < 60).mean()), 4),
      "блочность": round(блочность(g), 4),
      "яркость": round(float(g.mean()), 2),
    }
    if л:
        x, y, w, h = л
        x0, y0 = max(0, int(x)), max(0, int(y))
        r_["лицо"] = round(лап(g[y0:int(y+h), x0:int(x+w)]), 1)
        r_["лицо_бокс"] = [round(v, 1) for v in л]
    out.append(r_)
print(json.dumps(out, ensure_ascii=False))
`;

/**
 * Профиль вайба одного или нескольких кадров.
 * @param {string[]} файлы
 * @returns {object[]} по записи на кадр, поля описаны выше
 */
function профиль(файлы) {
  const r = spawnSync('python3', ['-c', PY_ПРОФИЛЬ, YUNET, ...файлы],
    { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 });
  if (r.status !== 0) throw new Error(`профиль не снялся: ${String(r.stderr || r.stdout).slice(0, 500)}`);
  const j = JSON.parse(r.stdout);
  return файлы.length === 1 ? j[0] : j;
}

// ═══ ПОДГОНКА ПОД ВАЙБ ══════════════════════════════════════════════════════════════════════════
// ЧТО ТЯНЕМ ДО КОНЦА, А ЧТО ТОЛЬКО ЧАСТИЧНО. Это главное решение здесь, и оно не косметическое.
// Кадр 1 и кадр 4 это РАЗНЫЕ СЦЕНЫ: разная комната, разная одежда, разный свет. Поэтому свойства
// делятся на два сорта:
//   · СВОЙСТВА КАМЕРЫ (зерно, падение резкости, виньетка, артефакты сжатия) от сцены не зависят.
//     Их тянем до эталона целиком: это ровно то, чего генерации не хватает.
//   · СВОЙСТВА СЦЕНЫ (баланс белого, насыщенность, контраст) зависят от того, что в кадре. Тянуть
//     их до конца нельзя: подгонишь тёплую прихожую под холодный уличный кадр 1 и получишь синее
//     лицо. Их тянем только частично, ДОЛЯ ниже, и с жёстким ограничителем.
// ДОЛЯ ПОДНЯТА С 0.55 ДО 0.85 (приказ 11.08: «если профиль кадра 1 говорит про сильный шум и
// мягкость, применяй ПОЛНОСТЬЮ, не половину»). До конца, то есть до 1.0, всё равно не тянем, и это
// не осторожность ради осторожности: кадр 1 и кадр 4 это разные сцены, и полное совпадение средних
// по кадру означало бы перекрасить зимнюю улицу в тёплую прихожую. Ограничители ниже оставлены,
// они держат лицо в человеческом цвете.
const ДОЛЯ_СЦЕНЫ = 0.85;

// ПОЛ ТЕЛЕФОННОЙ ФАКТУРЫ. Одна честная оговорка к «повтори вайб кадра 1», без неё подгонка выйдет
// пустой: кадр 1 с пинтереста тоже прошёл через сжатие и уменьшение, и своё зерно он по дороге
// ПОТЕРЯЛ. Замер по пяти эталонным постам: зерно кадра 1 от 0.34 до 1.85, то есть у трёх из пяти
// оно ниже, чем нам нужно, чтобы кадр перестал читаться как рендер. Живым его делает не только
// зерно, а ещё цвет, свет и объектив, и вот их подгонка берёт с кадра 1 честно.
// Поэтому: цвет, насыщенность, контраст и сжатие идут ПО ЗАМЕРУ кадра 1, а фактура камеры (зерно и
// падение резкости к углам) не опускается ниже этого пола, даже если эталон стерильный.
// Значения пола подобраны осмотром лесенки: зерно 7 видно на коже вплотную и не видно как «грязь»,
// углы 1.1 читаются как малая глубина резкости, а не как ошибка фокуса.
// БАЗА ФАКТУРЫ. Уровень выбран глазами начальника по лестнице кропов и менялся трижды, каждый раз
// с причиной, поэтому история важнее самих цифр:
//   · зерно 7, только пиксельное: приговор «зерна вообще нет, 0 просто», в ленте не видно;
//   · ступень x1 старой лестницы (15 и 26) при РОВНОМ зерне по кадру: одобрено;
//   · первый ряд новой лестницы (9 и 16): после переноса зерна в тени та же сила читается сильнее,
//     «давай по 1 ряду все делать»;
//   · и наконец 5 и 8: «3 кадр очень сильное зерно, там где освещение норм. На улице не надо, разве
//     что немного ночью можно логику сделать». То есть домашнюю тёмную ступень ещё вдвое вниз.
// Это БАЗА ДЛЯ ТЁМНОГО ПОМЕЩЕНИЯ. Светлый кадр получает ноль, ночная улица долю (см. сценаЗерна).
const ПОЛ = { зерно: 5, зерноКрупное: 8, углы: 1.1, jpeg: 4 };

// ═══ ТРИ РЕЖИМА ЗЕРНА ПО ОСВЕЩЁННОСТИ ══════════════════════════════════════════════════════════
// Правило начальника 11.08, в двух заходах. Сначала: «если фото на улице или в хорошем осввещении то
// крупицы чуть меньше». Потом жёстче: «3 кадр очень сильное зерно, там где освещение норм. На улице
// не надо, разве что немного ночью можно логику сделать». Итого три режима, а не два:
//
//   1. СВЕТЛО (улица днём, светлая комната, окно днём, снег) → ЗЕРНА НЕТ СОВСЕМ. Физика на его
//      стороне: короткая выдержка и низкая чувствительность, шуметь матрице нечем. Остальные
//      признаки телефона (срез светов, гало, падение резкости к углам, сжатие) остаются.
//   2. НОЧНАЯ УЛИЦА → 0.6 базы, «немного». Фонари и витрины дают света, чувствительность средняя.
//   3. ТЁМНОЕ ПОМЕЩЕНИЕ → полная база (5 и 8). Только здесь шум уместен, и он же лечит жалобу
//      «слишком хорошее качество» на вечерних кадрах.
//
// КАК ОПРЕДЕЛЯЕМ, ЧТО КАДР СВЕТЛЫЙ. Пороги сняты замером по 16 нашим кадрам (обложки и генерации),
// а не выдуманы: уличные дневные и светлые комнатные сидят на яркости 100…149 с долей светлого
// 0.10…0.32 (зимняя улица 140.9, спальня у окна 149.5, дневная улица с графити 119.0, переход метро
// 110.4), вечерние комнатные на 81…89 с долей 0.05…0.09, ночные на 35…67.
//
// ПОЧЕМУ ОДНОГО ЗАМЕРА НЕ ХВАТИЛО. Дневная улица бывает пасмурной и по яркости попадает в вечернюю
// комнату (узкая улица днём 82.9, двор днём 85.5), а ночную улицу от тёмной комнаты по пикселям
// вообще не отличить (ночная кофейня: светлого 0.033, размах 229; тёмная прихожая: 0.029 и 197).
// Поэтому конвейер ПЕРЕДАЁТ ТЕКСТ ЛОКАЦИИ, он у него и так есть (loc3 и loc4, из них же слаги в
// meta), и по нему видно и место, и время суток. Замер остаётся страховкой, когда локации нет.
const СВЕТ = { светло: 100, доляСветлого: 0.10, ночьУлица: 0.7 };
const УЛИЦА_СЛОВА = ['улиц', 'бульвар', 'набережн', 'двор', 'москва-сити', 'москва сити', 'парк',
  'тротуар', 'асфальт', 'сквер', 'площад', 'переулок', 'мост', 'снег на', 'на снегу', 'фасад'];
const ДЕНЬ_СЛОВА = ['днём', 'днем', 'утром', 'полдень', 'светлым днём'];
const НОЧЬ_СЛОВА = ['вечер', 'ночь', 'ночью', 'закат', 'сумерк', 'неон'];

/**
 * Режим зерна по кадру и, если она известна, по локации.
 * @param {object} проф профиль кадра (яркость, светлые)
 * @param {string} [место] текст локации кадра из конвейера, например «на бульваре в центре Москвы днём»
 * @returns {{множитель:number, класс:string}}
 */
function сценаЗерна(проф, место) {
  const м = String(место || '').toLowerCase();
  const улица = УЛИЦА_СЛОВА.some((w) => м.includes(w));
  const день = ДЕНЬ_СЛОВА.some((w) => м.includes(w));
  const ночь = НОЧЬ_СЛОВА.some((w) => м.includes(w));
  const светлоПоЗамеру = проф.яркость >= СВЕТ.светло || (проф.светлые || 0) >= СВЕТ.доляСветлого;

  if (светлоПоЗамеру || (улица && день) || (день && !ночь && проф.яркость >= 78)) {
    return { множитель: 0, класс: 'светло, зерна нет' };
  }
  if (улица) return { множитель: СВЕТ.ночьУлица, класс: 'ночная улица, зерно вполсилы' };
  // Локации нет: точки света в тёмном кадре это чаще всего фонари и витрины, то есть улица.
  if (!м && (проф.светлые || 0) >= 0.05) {
    return { множитель: СВЕТ.ночьУлица, класс: 'тёмный кадр с огнями, считаю улицей' };
  }
  return { множитель: 1, класс: 'тёмное помещение, полная база' };
}

/**
 * Подогнать кадр под вайб эталонного кадра.
 * @param {string} вход кадр 3 или 4
 * @param {string} выход куда положить
 * @param {{эталон:string, профЭталона?:object, надПлашкой?:boolean, потолокЗерна?:number}} o
 * @returns {object} что применили и что получилось по числам
 */
function подВайб(вход, выход, o = {}) {
  if (!FF || !fs.existsSync(FF)) throw new Error('ffmpeg-static не найден');
  const цель = o.профЭталона || профиль([o.эталон]);
  const свой = профиль([вход]);
  if (цель.ошибка || свой.ошибка) throw new Error(`профиль не снялся: ${цель.ошибка || свой.ошибка}`);

  // ЗЕРНО. Шум складывается по квадратам, поэтому добавить надо не разницу, а корень из разницы
  // квадратов. Коэффициент 5.3 это перевод из нашей меры в параметр noise ffmpeg, и он СНЯТ
  // ЗАМЕРОМ, а не выведен на бумаге: на кадре P13 при noise 8 мера дала 0.81, при 14 дала 2.06,
  // при 20 дала 3.09, то есть мера растёт примерно на 0.19 на единицу noise. Разница с наивной
  // единицей берётся из двух мест: цветовая подвыборка jpeg и то, что мера снимает верхние частоты
  // гауссом с сигмой 1.1, а он пиксельный шум частично усредняет.
  const нехватка = Math.sqrt(Math.max(0, цель.зерно ** 2 - свой.зерно ** 2));
  const потолок = o.потолокЗерна != null ? o.потолокЗерна : 26;
  let зерно = Math.min(потолок, Math.max(ПОЛ.зерно, Math.round(нехватка * 5.3)));
  // КРУПНОЕ ЗЕРНО ведём отдельным числом и от того же недобора. Коэффициент 9 снят замером: серый
  // слой с шумом 24, растянутый с половинного размера, поднял меру на 1.93 (0.306 → 2.239), то есть
  // примерно 0.08 на единицу. Оно и есть то зерно, которое видно без прищуривания.
  let крупное = Math.min(44, Math.max(ПОЛ.зерноКрупное, Math.round(нехватка * 9)));
  // ОСВЕЩЁННОСТЬ КАДРА РЕШАЕТ, сколько зерна он получит. Считаем по САМОМУ КАДРУ, а не по эталону:
  // шумит та камера, которая снимала эту сцену, а сцены у кадра 1 и кадра 4 разные.
  const сцена = сценаЗерна(свой, o.место);
  зерно = сцена.множитель ? Math.max(1, Math.round(зерно * сцена.множитель)) : 0;
  крупное = сцена.множитель ? Math.max(1, Math.round(крупное * сцена.множитель)) : 0;
  // ПОТОЛОК ПОЛТОРЫ БАЗЫ. Замер эталона может требовать больше (кадр 1 сам бывает шумный, у P13 его
  // зерно 1.85), и тогда расчёт выдавал 9 и 14 вместо 4 и 6, то есть вдвое выше уровня, который
  // начальник только что назвал слишком сильным. Уровень теперь назначается ГЛАЗАМИ, поэтому замер
  // эталона может лишь слегка подвинуть силу вверх, а не переписать её.
  const потолокСцены = { з: Math.round(ПОЛ.зерно * сцена.множитель * 1.5),
    к: Math.round(ПОЛ.зерноКрупное * сцена.множитель * 1.5) };
  зерно = Math.min(зерно, потолокСцены.з);
  крупное = Math.min(крупное, потолокСцены.к);
  // МНОЖИТЕЛЬ ЗЕРНА нужен для лестницы силы: тот же расчёт, но громче или тише в заданное число раз.
  // Он же выключает замкнутую петлю у вызывающего (итераций 0), иначе петля вернёт лестницу к цели
  // и все ступени выйдут одинаковыми.
  if (o.множительЗерна) {
    зерно = Math.min(потолок, Math.round(зерно * o.множительЗерна));
    крупное = Math.min(60, Math.round(крупное * o.множительЗерна));
  }

  // РЕЗКОСТЬ. Если генерация резче эталона, разницу отдаём в углы (радиальная маска, лицо вырезано)
  // и лишь чуть в общую мягкость. Если генерация мягче эталона, ничего не мылим совсем.
  const отн = свой.резкость / Math.max(1, цель.резкость);
  const углы = Math.max(ПОЛ.углы, отн > 1.05 ? Math.min(3.0, (отн - 1) * 1.6 + 0.6) : 0);
  const мягкость = отн > 1.25 ? Math.min(0.6, (отн - 1.25) * 0.5) : 0;

  // ВИНЬЕТКА. Тянем к эталонному отношению рамка к центру, но не глубже разумного.
  // Потолок 0.6, а не 1.0, и вот почему: гейт карусели требует, чтобы кадр был ОБРЕЗКОЙ БЕЗ ПОЛЕЙ,
  // и глубокая виньетка это лишний повод однажды прочитаться как тёмные поля по краям. Мера
  // виньетки к тому же шумная (на P30 кадр 1 дал 2.9 просто из-за светлой стены в углах), так что
  // тянуть её до упора смысла нет.
  const нужнаяВинь = Math.max(0, свой.виньетка - цель.виньетка);
  const виньетка = Math.min(0.6, нужнаяВинь * 4.5);

  // СЖАТИЕ. Блочность эталона переводим в qscale. Пинтерест отдаёт уже пережатые кадры, и это
  // ровно та фактура, которой не хватает нашим.
  const jpeg = Math.max(ПОЛ.jpeg, Math.min(9, Math.round(4 + (цель.блочность - свой.блочность) * 26)));

  // ЦВЕТ НЕ ТРОГАЕМ. Это прямой приказ начальника 11.08: «не глуши фильтрами насыщенность фото,
  // это не то что даёт ему ощущение снимка на айфон». Первая версия тянула насыщенность и баланс
  // белого к кадру 1 и на замере опускала цвет на 20 процентов: кадр становился серее, а «телефона»
  // в нём не появлялось, потому что телефонность живёт не в цвете, а в поведении сенсора (тени,
  // шумодав, срез светов, ступеньки). Поэтому:
  //   · баланс белого не сдвигаем совсем, цвет остаётся как у модели;
  //   · насыщенность разрешено только ПОДНЯТЬ, и только если кадр 1 сам насыщеннее нашего кадра;
  //   · контраст тоже только вверх, вниз не заваливаем.
  const нас = Math.min(1.15, Math.max(1, 1 + (цель.насыщенность / свой.насыщенность - 1) * ДОЛЯ_СЦЕНЫ));
  // Контраст упёрт в 1.06, а не в 1.12: при 1.12 средняя яркость кадра падала на десятую часть
  // (88.9 против 78.9 на P28), кадр темнел, а телефонности от этого не прибавлялось.
  const контр = Math.min(1.06, Math.max(1, 1 + (цель.контраст / свой.контраст - 1) * ДОЛЯ_СЦЕНЫ));

  // ЛИЦО ДЛЯ МАСКИ БЕРЁМ ОТДЕЛЬНЫМ ЗАМЕРОМ, а не из профиля. В профиле бокс снят на кадре,
  // приведённом к 1080 (там так надо для сравнимости чисел), а мылим мы кадр в ЕГО СОБСТВЕННОМ
  // размере. Пересчитывать коэффициентом это лишний повод однажды промахнуться маской по лицу,
  // а лишний вызов детектора стоит меньше секунды.
  const лицоМаски = o.лицо !== undefined ? o.лицо : лицоКадра(вход);

  const п = {
    зерно, зерноКрупное: крупное, зерноХрома: Math.round(зерно * 0.2), мягкость,
    // Подрезку держим слабой: она нужна, чтобы общая мягкость не съела лицо, а не для «резкости».
    подрезка: мягкость > 0.05 ? 0.6 : 0.25,
    хромаМыло: Math.min(1.8, зерно * 0.08 + 0.5),
    сдвигЦвета: 0, надПлашкой: true,
    температура: 6500, темпМикс: 0,      // цвет правим не температурой, а точными усилениями каналов
    углы, угловНачало: 0.5, виньетка,
    контраст: 1, подъёмТени: 0,
    // Гало держим умеренным и одинаковым: замерить «подтекание света» одним числом по кадру
    // честно не выходит (оно зависит от того, есть ли в кадре лампа), а 0.3 на осмотре читается
    // как живой свет и не поднимает тени.
    гало: 0.3,
    // Признаки сенсора на рабочей силе. Цифры взяты с пресета «5с», потому что начальник просил
    // целиться в него: он шумит и срезает света заметно.
    // ШУМОДАВ ТОЖЕ ИДЁТ ЗА ОСВЕЩЁННОСТЬЮ. Замер поймал брак: на светлом уличном кадре зерно режется
    // вдвое, а мыло шумодава оставалось полным, и кадр выходил ГЛАЖЕ исходника (мера зерна на фоне
    // 1.105 до и 0.387 после). Телефон днём шумодав почти не включает, ему нечего давить, поэтому
    // мыло масштабируется тем же множителем сцены.
    // Коэффициент мыла 0.55, а не 0.9: на ночной улице зерно теперь всего 4 и 6, и при мыле 0.54
    // кадр выходил ГЛАЖЕ исходника (мера зерна на фоне 0.249 до и 0.164 после), то есть шумодав
    // съедал больше, чем зерно добавляло. Полное мыло остаётся только для тёмного помещения.
    // ПЕРЕСВЕТ ВЫКЛЮЧЕН ЗДЕСЬ, В ЖИВОМ ПУТИ (11.08, вторая попытка). Первый раз я поставил ноль в
    // пресете '5c', и это НЕ СРАБОТАЛО: конвейер идёт через onepost → подогнатьПоЭталону → подВайб,
    // а пресеты в этом пути не участвуют вообще. Отдел качества это поймал и доказал числом: он
    // применил живую кривую к забракованному кадру нов234 и выбитое на лице выросло с 1.88 до 12
    // процентов, п95 упёрся в 254. То есть партию спас переписанный промпт, а фильтр остался
    // заряженным ружьём и выстрелил бы на первом светлом дневном кадре.
    // Приказ начальника дословно: «без пересвета». Ноль до отдельного решения.
    пересвет: 0, шумодав: +(0.55 * сцена.множитель).toFixed(2), доляСвета: 0.25, ступеньки: 6,
    jpeg,
  };
  // Точный цвет и насыщенность отдельной вставкой перед остальной цепочкой.
  const цвет = (нас > 1.01 || контр > 1.01)
    ? `eq=saturation=${нас.toFixed(3)}:contrast=${контр.toFixed(3)}` : '';

  const рисовать = () => {
    п.зерно = зерно;
    п.зерноКрупное = крупное;
    // Шум по цвету впятеро слабее яркостного: цветные точки на коже читаются как грязь, а не как
    // сенсорный шум, и вдобавок тянут вверх насыщенность, которую мы только что опустили.
    п.зерноХрома = Math.round(зерно * 0.2);
    п.хромаМыло = Math.min(1.8, зерно * 0.08 + 0.5);
    const граф = [цвет, цепочка(п, лицоМаски)].filter(Boolean).join(',');
    const args = ['-y', '-hide_banner', '-loglevel', 'error', '-i', вход, '-filter_complex', граф,
      '-frames:v', '1', '-c:v', 'mjpeg', '-q:v', String(jpeg), выход];
    const r = spawnSync(FF, args, { encoding: 'utf8', maxBuffer: 1 << 24 });
    if (r.status !== 0 || !fs.existsSync(выход) || !fs.statSync(выход).size) {
      throw new Error(`ffmpeg код ${r.status}: ${String(r.stderr || '').slice(-400)}`);
    }
  };
  рисовать();

  // ЗАМКНУТАЯ ПЕТЛЯ ПО ЗЕРНУ. Открытый расчёт всегда недосыпает, и это не мелочь: после зерна в
  // цепочке идут размытие цвета, угловое мыло и jpeg, и они часть шума СЪЕДАЮТ. Замер: на P13 при
  // расчётном зерне 10 мера дала 0.84 вместо целевых 1.85, то есть недобор больше чем вдвое.
  // Поэтому кадр после отрисовки меряется заново и зерно поднимается по факту, а не по теории.
  // Итераций одна: она закрывает недобор почти целиком, а каждая следующая стоит ещё две секунды.
  // ПОЧЕМУ ШАГ ПРИТУПЛЁН СТЕПЕНЬЮ 0.7, А НЕ ПРЯМОЙ ПРОПОРЦИЕЙ. Прямая пропорция перелетает: шум
  // складывается с уже имеющимся по квадратам, и крупная амплитуда лучше переживает jpeg, поэтому
  // мера растёт быстрее, чем параметр. На P13 прямой шаг с 10 на 22 дал 3.32 вместо целевых 1.85.
  // Притупление плюс три попытки садятся в вилку от 0.8 до 1.25 цели, а лучший из промахов
  // отрисовывается заново в конце, чтобы на диске остался он, а не последняя попытка.
  const цельЗ = Math.max(цель.зерно, ПОЛ.зерно / 5.3);
  // ПЕТЛЯ РАБОТАЕТ ТОЛЬКО КОГДА ЭТАЛОН ТРЕБУЕТ БОЛЬШЕ ПОЛА. Пол это уровень, ВЫБРАННЫЙ ГЛАЗАМИ
  // начальника по лестнице кропов (ступень x1), и догонять им какую-то цифру нельзя: после того как
  // зерно ушло в тени, средняя мера по кадру честно падает, и петля начинала задирать зерно до 22 и
  // 38, то есть выше одобренного. Поэтому если сила задана полом, петлю не запускаем совсем.
  // ПЕТЛЯ ПО УМОЛЧАНИЮ ВЫКЛЮЧЕНА. Она нужна была, пока силу зерна назначал замер эталона. Теперь
  // силу назначают глаза начальника (база плюс режим освещённости), и догонять ею цифру нельзя:
  // после переноса зерна в тени средняя мера по кадру честно ниже, и петля начинала задирать
  // уровень выше одобренного. Оставлена доступной через o.итераций для исследований.
  const попыток = o.итераций != null ? o.итераций : 0;
  let стало = null, лучшее = null;
  for (let и = 0; и <= попыток; и++) {
    стало = профиль([выход]);
    if (стало.ошибка || !стало.зерно) break;
    const откл = Math.abs(Math.log(стало.зерно / цельЗ));
    if (!лучшее || откл < лучшее.откл) лучшее = { зерно, крупное, откл, стало };
    if (стало.зерно >= цельЗ * 0.8 && стало.зерно <= цельЗ * 1.25) break;
    if (и === попыток) break;
    const k = Math.max(0.4, Math.min(2.2, (цельЗ / стало.зерно) ** 0.7));
    const новое = Math.max(1, Math.min(потолок, Math.round(зерно * k)));
    const новоеКр = Math.max(1, Math.min(44, Math.round(крупное * k)));
    if (новое === зерно && новоеКр === крупное) break;
    зерно = новое; крупное = новоеКр;
    рисовать();
  }
  if (лучшее && (лучшее.зерно !== зерно || лучшее.крупное !== крупное)) {
    зерно = лучшее.зерно; крупное = лучшее.крупное; рисовать(); стало = лучшее.стало;
  }

  return {
    выход,
    примененo: { зерно, крупное, мягкость: +мягкость.toFixed(2), углы: +углы.toFixed(2),
      виньетка: +виньетка.toFixed(2), jpeg, насыщенность: +нас.toFixed(3), контраст: +контр.toFixed(3),
      пересвет: п.пересвет, шумодав: п.шумодав, ступеньки: п.ступеньки,
      сцена: сцена.класс, множительСцены: сцена.множитель, яркость: свой.яркость, светлые: свой.светлые },
    было: свой, эталон: цель, стало,
  };
}

/**
 * Подогнать пачку кадров под вайб эталона НА МЕСТЕ. Это точка встройки в конвейер: эталон это
 * кадр 1 (живое фото с пинтереста), кадры это 3 и 4. Не роняет вызывающего никогда: плёнка это
 * косметика, и лучше отдать пост с исходными кадрами, чем не отдать совсем.
 * @param {{эталон:string, кадры:string[]}} o
 * @returns {object[]} отчёт по каждому кадру
 */
function подогнатьПоЭталону({ эталон, кадры, места }) {
  if (process.env.PHONE_LOOK === '0') return [];
  const итог = [];
  let цель = null;
  try { цель = профиль([эталон]); } catch (e) {
    console.log(`  ⚠ вайб кадра 1 не снялся (${String(e.message).slice(0, 80)}), плёнку не кладу`);
    return итог;
  }
  for (const ф of [...new Set((кадры || []).filter((f) => f && fs.existsSync(f)))]) {
    try {
      const врем = `${ф}.vibe.jpg`;
      const r = подВайб(ф, врем, { эталон, профЭталона: цель, надПлашкой: true,
        место: места ? места[ф] : undefined });
      fs.renameSync(врем, ф);
      console.log(`  → вайб кадра 1 наложен на ${path.basename(ф)}: ${r.примененo.сцена}, `
        + `зерно ${r.примененo.зерно}/${r.примененo.крупное}, углы ${r.примененo.углы}, jpeg q${r.примененo.jpeg}`);
      итог.push({ файл: ф, ...r.примененo });
    } catch (e) {
      console.log(`  ⚠ вайб не наложился на ${path.basename(ф)}: ${String(e.message).slice(0, 90)}`);
    }
  }
  return итог;
}

module.exports = { телефонный, телефонныйНаМесте, лесенка, ПРЕСЕТЫ, лицоКадра,
  профиль, подВайб, подогнатьПоЭталону, сценаЗерна, СВЕТ, ПОЛ };

if (require.main === module) {
  const арг = process.argv.slice(2);
  const знач = (имя, поум) => {
    const a = арг.find((s) => s.startsWith(`--${имя}=`));
    return a ? a.split('=').slice(1).join('=') : поум;
  };
  const файлы = арг.filter((a) => !a.startsWith('--'));
  if (!файлы.length) {
    console.log('node phonelook.cjs [--пресет=5c|11] [--сила=1] [--уход=тепло|холод] [--лесенка] вход.jpg [выход.jpg]');
    process.exit(1);
  }
  const пресет = знач('пресет', '11');
  const уход = знач('уход', 'тепло');
  if (арг.includes('--лесенка')) {
    const куда = знач('куда', '/tmp/phonelook_ladder');
    for (const ф of файлы) {
      for (const и of лесенка(ф, куда, { пресет, уход })) console.log(`сила ${и.сила}: ${и.файл}`);
    }
  } else {
    const [вх, вых] = файлы;
    const o = вых || вх.replace(/(\.[a-z]+)$/i, '_phone$1');
    const r = телефонный(вх, o, { пресет, сила: Number(знач('сила', 1)), уход });
    console.log(`готово: ${r.выход} (пресет ${r.пресет}, сила ${r.сила}, jpeg q${r.jpeg}, лицо ${r.лицоНайдено ? 'найдено' : 'не найдено'})`);
  }
}
