// ЕДИНОЕ СТАТИЧНОЕ ОКНО НЕЙРОНКИ (06.08, правило начальника: «хром не закрывается и не
// открывается, а статично работает»). Один Chrome с админ-профилем живёт постоянно с портом
// CDP 9666; скрипты подключаются к нему, работают в СВОЕЙ вкладке и закрывают только её.
// Сам браузер НИКОГДА не закрываем: done() отцепляется, окно остаётся.
// Если статичного окна нет (перезагрузка мака), поднимаем его сами и оставляем жить.
//
// ЧУЖИЕ ПРОЦЕССЫ НЕ ТРОГАЕМ НИКОГДА. Ни pkill по Chrome, ни pkill по Orbita: в этих окнах у
// начальника личные профили, и один такой pkill сносит его рабочий день. Мы умеем только
// подключиться и, если своего браузера нет, поднять свой.
//
// РАЗБОР ПАДЕЖА ВОЛНЫ 11.08 (/tmp/wave7.log: 153 попытки, 71 готов, 82 брака, и 66 из них не брак).
// 55 постов умерли строкой «статичный Chrome не поднялся на порту 9666», ещё 11 — тем же текстом на
// отцеплении. Диагноз «браузер отвалился» БЫЛ НЕВЕРНЫМ: в момент разбора Chrome жил больше суток
// (pid 87122, uptime 1д12ч) и на curl http://127.0.0.1:9666/json/version отвечал мгновенно.
// Замер connectOverCDP показал настоящую причину:
//   таймаут 4000 мс → ПРОВАЛ за 5012 мс («<ws connected>», дальше тишина)
//   таймаут 90000 мс → OK за 28815 мс, страниц 26
// То есть порт живой, вебсокет соединяется, а playwright на подключении цепляется КО ВСЕМ вкладкам
// браузера и ждёт их: 26 вкладок = 29 секунд при разрешённых четырёх. Дальше это лавина: старый
// ensureChrome делал 10 попыток по 4 с и падал через ~80 с (в логе ровно «через 1 мин 16-23 с» —
// это и есть подпись выработанных попыток, а не мёртвого порта).
// Откуда 26 вкладок: сторож onepost (25 мин / 9 мин без движения) убивает процесс через
// process.exit, done() при этом не выполняется, page.close() не зовётся, и вкладка остаётся жить в
// общем браузере навсегда. Счётчик /tmp/admintabs при этом чистый (файл слота снимается на exit),
// поэтому семафор вкладок утечки не видел: он считал ПРОЦЕССЫ, а течёт ВКЛАДКА.
// Поэтому здесь три вещи: подключение с честным таймаутом 90 с, подъём под файловым локом (четыре
// полосы больше не поднимут четыре браузера) и уборка сиротских вкладок.
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const { spawn } = require('node:child_process');

const PROFILE = process.env.ADMIN_PROFILE || path.join(os.homedir(), '.neironka-admin-profile');
const PORT = Number(process.env.ADMIN_CDP_PORT || 9666);
const CDP = `http://127.0.0.1:${PORT}`;
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

const ADMIN_URL = 'https://neironka.pro/admin/promo';

// Таймаут ПОДКЛЮЧЕНИЯ, а не порта: замер выше показал 29 с на 26 вкладках, 90 с это запас на случай
// толстого браузера. Порт при этом проверяется отдельным быстрым запросом (см. портОтвечает).
const CONNECT_MS = Number(process.env.ADMIN_CDP_CONNECT_MS || 90000);
// Сколько ждать появления порта после запуска Chrome. Холодный старт профиля на мака 5-15 с.
const PORT_WAIT_MS = Number(process.env.ADMIN_CDP_PORT_WAIT_MS || 90000);
const SPAWN_LOCK = '/tmp/adminchrome.spawn.lock';

/** Быстрая проверка «порт вообще отвечает». Дешёвая: это простой HTTP, без CDP-рукопожатия. */
async function портОтвечает(ms = 5000) {
  try {
    const r = await fetch(`${CDP}/json/version`, { signal: AbortSignal.timeout(ms) });
    return r.ok;
  } catch { return false; }
}

/**
 * Файловый лок на ПОДЪЁМ браузера.
 *
 * ЗАЧЕМ. Волна идёт в 3-4 полосы, каждый пост это отдельный процесс, и когда порт не отвечает, все
 * полосы одновременно решают поднять браузер. Второй и следующий Chrome на том же
 * --user-data-dir не поднимаются вообще (профиль занят первым) и молча уходят, а полосы считают
 * это провалом подъёма. Лок делает подъём единственным: остальные просто ждут порт.
 * Мёртвый лок (процесс умер, файл остался) снимаем по pid и по возрасту.
 */
async function взятьЛокПодъёма(waitMs = 150000) {
  const до = Date.now() + waitMs;
  for (;;) {
    try { fs.writeFileSync(SPAWN_LOCK, String(process.pid), { flag: 'wx' }); return true; }
    catch {
      let живой = false, старый = false;
      try {
        const pid = Number(fs.readFileSync(SPAWN_LOCK, 'utf8').trim() || 0);
        try { process.kill(pid, 0); живой = true; } catch {}
        старый = Date.now() - fs.statSync(SPAWN_LOCK).mtimeMs > 5 * 60000;
      } catch { /* лок исчез между проверками: пробуем взять снова */ }
      if (!живой || старый) { try { fs.unlinkSync(SPAWN_LOCK); } catch {} continue; }
    }
    if (Date.now() > до) return false;   // не дождались: подъём делает сосед, ждём порт снаружи
    await sleep(2000);
  }
}
function отдатьЛокПодъёма() {
  try { if (Number(fs.readFileSync(SPAWN_LOCK, 'utf8').trim()) === process.pid) fs.unlinkSync(SPAWN_LOCK); } catch {}
}

/** Где лежит Chrome. Своего браузера не качаем: работаем тем, что стоит у начальника. */
function бинарник() {
  return ['/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
    '/Applications/Chromium.app/Contents/MacOS/Chromium'].find((p) => fs.existsSync(p));
}

/**
 * Поднять служебный Chrome и дождаться порта. Никого не убивает.
 * HEADLESS (06.08, начальник: «открываются и мешают, не трогай хром»): служебный браузер живёт
 * фоном БЕЗ окна и БЕЗ иконки в доке. Личный Chrome начальника не трогаем вообще.
 */
function запуститьChrome() {
  const BIN = бинарник();
  if (!BIN) throw new Error('не нашёл Google Chrome ни в /Applications: поднимать нечем');
  const ch = spawn(BIN, [`--user-data-dir=${PROFILE}`, `--remote-debugging-port=${PORT}`,
    '--headless=new', '--no-first-run', '--no-default-browser-check', '--disable-session-crashed-bubble',
    ADMIN_URL], { detached: true, stdio: 'ignore' });
  ch.unref();
  return ch.pid;
}

/** Подъём под локом: если пока стояли в очереди порт уже ожил, второй браузер НЕ поднимаем. */
async function поднятьЕслиНужно() {
  const взял = await взятьЛокПодъёма();
  try {
    if (await портОтвечает()) return 'порт уже ожил, подъём не нужен';
    if (!взял) {   // лок у соседа: он и поднимает, наше дело дождаться порта
      const до = Date.now() + PORT_WAIT_MS;
      while (Date.now() < до) { await sleep(2000); if (await портОтвечает()) return 'поднял сосед'; }
      return 'сосед держит лок подъёма, а порт так и не ожил';
    }
    запуститьChrome();
    const до = Date.now() + PORT_WAIT_MS;
    while (Date.now() < до) {
      await sleep(2000);
      if (await портОтвечает()) return 'поднял сам';
    }
    return `порт не ожил за ${Math.round(PORT_WAIT_MS / 1000)} с после запуска`;
  } finally { if (взял) отдатьЛокПодъёма(); }
}

async function ensureChrome() {
  const { chromium } = require('playwright-core');
  const подключиться = () => chromium.connectOverCDP(CDP, { timeout: CONNECT_MS });
  let последняя = null;
  for (let круг = 1; круг <= 3; круг++) {
    // Сиротские вкладки убираем ДО подключения: именно они делают рукопожатие долгим, а через HTTP
    // это дешёво и не требует playwright.
    await прибратьСиротские().catch(() => {});
    if (await портОтвечает()) {
      // ПОРТ ОТВЕЧАЕТ — ЗНАЧИТ ПОДКЛЮЧАЕМСЯ, А НЕ ПОДНИМАЕМ ВТОРОЙ. Второй на том же профиле не
      // встанет всё равно, а попытка съедает минуту и превращает живой браузер в «брак поста».
      try { return await подключиться(); }
      catch (e) { последняя = e; await sleep(5000); continue; }
    }
    последняя = new Error(await поднятьЕслиНужно());
    try { return await подключиться(); }
    catch (e) { последняя = e; await sleep(5000); }
  }
  // Текст ошибки НЕ МЕНЯЕМ: по нему onepost.cjs узнаёт сбой инфраструктуры и возвращает исходник в
  // очередь вместо брака (код выхода 3), а логи прошлых волн ищутся этой же строкой.
  throw new Error(`статичный Chrome не поднялся на порту ${PORT}`
    + (последняя ? `: ${String(последняя.message).split('\n')[0].slice(0, 120)}` : ''));
}

// {page, done}: работа в своей вкладке; done() закрывает ТОЛЬКО вкладку и отцепляется.
// СЕМАФОР ВКЛАДОК (07.08). Служебный headless-хром один на всех, и когда в него полезли
// восемнадцать сборщиков одновременно (залп 8 + 5 шаблонов + 5 постов), часть страниц упала с
// «Failed to fetch»: браузер не выдержал столько активных вкладок с заливкой файлов. Поэтому
// вкладки выдаём по счёту, остальные ЖДУТ очереди. Лимит через файл, чтобы работал между
// процессами: у нас каждый пост это отдельный процесс, внутрипроцессный счётчик бесполезен.
const TABS_MAX = Number(process.env.ADMIN_TABS_MAX || 6);
const TABS_DIR = '/tmp/admintabs';
const СИРОТЫ = `${TABS_DIR}/orphans.json`;
// Сколько вкладка должна простоять НИЧЬЕЙ, прежде чем её закрыть.
// БЫЛО 15 СЕКУНД, И ЭТО СЪЕЛО ВОЛНУ 9 (11.08): 40 попыток из 40 упали с «Target page has been
// closed», потому что уборщик закрывал вкладки ЖИВЫХ сборок. Пятнадцать секунд закрывают только
// гонку «создал вкладку, ещё не записал id», но если id вкладки не прочитался (idВкладки вернул
// null), живая вкладка числится ничьей ВСЁ ВРЕМЯ СБОРКИ. А сборка одного поста идёт до 10 минут.
// Поэтому отсрочка теперь 20 минут: дольше самой долгой сборки, и утечки всё равно приберутся.
const ГРАЦИЯ_МС = Number(process.env.ADMIN_TAB_GRACE_MS || 20 * 60000);

function tabsBusy() {
  try {
    const fsx = require('node:fs');
    if (!fsx.existsSync(TABS_DIR)) return 0;
    let n = 0;
    for (const f of fsx.readdirSync(TABS_DIR)) {
      if (!/^\d+$/.test(f)) continue;   // orphans.json и прочая служебка это не слот
      const pid = Number(f);
      let alive = false;
      try { process.kill(pid, 0); alive = true; } catch {}
      // МЁРТВЫЙ СЛОТ ЗДЕСЬ НЕ УДАЛЯЕМ (13.08): в нём записаны id вкладок убитого процесса, и по
      // ним уборщик (прибратьСиротские) закрывает его вкладки сразу, без 20 минут грации. Файл
      // слота снимает сам уборщик, когда вкладок мёртвого владельца в браузере не осталось.
      // На счёт очереди мёртвый слот не влияет: считаем только живых.
      if (alive) n++;
    }
    return n;
  } catch { return 0; }
}
async function waitTabSlot() {
  const fsx = require('node:fs');
  fsx.mkdirSync(TABS_DIR, { recursive: true });
  const until = Date.now() + 25 * 60000;
  for (;;) {
    if (tabsBusy() < TABS_MAX) { записатьСлот([]); return; }
    if (Date.now() > until) throw new Error('очередь вкладок админ-браузера не освободилась за 25 мин');
    await new Promise((r) => setTimeout(r, 5000));
  }
}
function freeTabSlot() { try { require('node:fs').unlinkSync(`${TABS_DIR}/${process.pid}`); } catch {} }

// НА exit СЛОТ БОЛЬШЕ НЕ СНИМАЕМ (13.08). Раньше здесь стояло process.on('exit', freeTabSlot), и
// файл слота исчезал даже когда процесс убили (сторож зовёт process.exit, done() с закрытием
// вкладки не выполняется). Вкладка оставалась жить, а владельца было не опознать: уборщику
// доставалась «ничья» вкладка с грацией 20 минут. Сегодняшний счёт: 10 сирот после глушения волны,
// прибратьСиротские вернула {closed: 0, total: 10}, следующий процесс повис на очереди вкладок.
// Теперь слот при жизни снимает только done() ПОСЛЕ закрытия вкладки, а слот мёртвого процесса
// снимает уборщик, закрыв его вкладки по записанным id. Очередь не страдает: tabsBusy считает
// только живые процессы, мёртвый слот места не занимает.

/** Файл слота теперь хранит и СПИСОК ID НАШИХ ВКЛАДОК: по нему уборщик понимает, кто чей. */
function записатьСлот(targets, безымянных = 0) {
  try {
    fs.mkdirSync(TABS_DIR, { recursive: true });
    fs.writeFileSync(`${TABS_DIR}/${process.pid}`,
      JSON.stringify({ t: Date.now(), targets, безымянных }));
  } catch {}
}
function мойСлот() {
  try { return JSON.parse(fs.readFileSync(`${TABS_DIR}/${process.pid}`, 'utf8')); }
  catch { return { t: Date.now(), targets: [] }; }
}

/** Вкладки, за которые отвечает ЖИВОЙ процесс. Всё остальное в браузере это сироты. */
function хозяйскиеВкладки() {
  const свои = new Set();
  try {
    for (const f of fs.readdirSync(TABS_DIR)) {
      if (!/^\d+$/.test(f)) continue;
      try { process.kill(Number(f), 0); } catch { continue; }   // мёртвый слот не хозяин
      try {
        const з = JSON.parse(fs.readFileSync(`${TABS_DIR}/${f}`, 'utf8'));
        for (const id of (з.targets || [])) свои.add(String(id));
      } catch { /* старый формат файла (просто время): вкладок за ним не записано */ }
    }
  } catch { /* папки ещё нет */ }
  return свои;
}

/** Есть ли живой процесс, у которого вкладка не опознана: при таком уборку не делаем вообще. */
function естьБезымянные() {
  try {
    for (const f of fs.readdirSync(TABS_DIR)) {
      if (!/^\d+$/.test(f)) continue;
      try { process.kill(Number(f), 0); } catch { continue; }
      try {
        const з = JSON.parse(fs.readFileSync(`${TABS_DIR}/${f}`, 'utf8'));
        if ((з.безымянных || 0) > 0) return true;
      } catch { return true; }   // файл слота нечитаем: считаем, что хозяин есть, и не трогаем ничего
    }
  } catch {}
  return false;
}

/**
 * УБОРКА СИРОТСКИХ ВКЛАДОК. Это лечение самой причины падежа волны 7: вкладки протекают (сторож
 * убивает процесс через process.exit, done() не успевает закрыть страницу), и каждая лишняя вкладка
 * добавляет ~1 с к подключению playwright. На 26 вкладках подключение 29 с при разрешённых 4.
 *
 * Закрываем ТОЛЬКО через CDP-endpoint нашего служебного браузера и ТОЛЬКО ничьи вкладки, которые
 * числятся ничьими не первый раз (см. ГРАЦИЯ_МС). Никаких kill по процессам.
 */
async function прибратьСиротские() {
  if (!(await портОтвечает(3000))) return { closed: 0, total: 0 };
  let список = [];
  try {
    const r = await fetch(`${CDP}/json/list`, { signal: AbortSignal.timeout(20000) });
    список = (await r.json()).filter((t) => t.type === 'page');
  } catch { return { closed: 0, total: 0 }; }
  const свои = хозяйскиеВкладки();
  // ПОСЛЕДНЮЮ ВКЛАДКУ НЕ ЗАКРЫВАЕМ НИКОГДА, И ЭТО ПРОВЕРЕНО НА СЕБЕ (11.08).
  // Прибрав все 26 сиротских вкладок разом, я оставил браузер с нулём страниц. Результат: HTTP-ручки
  // (/json/version, /json/new) отвечали за 0.03 с, а connectOverCDP перестал подключаться ВООБЩЕ
  // (не отдал соединение и за 110 с при том, что на свежем браузере это 178 мс). Headless-Chrome без
  // страниц уходит в закрытие, и служебное окно приходится поднимать заново. Поэтому одну живую
  // вкладку всегда оставляем: браузер должен стоять статично, это правило начальника.
  const живых = список.length;
  let закрыто = 0;
  const закрытьВкладку = async (id) => {
    await fetch(`${CDP}/json/close/${id}`, { signal: AbortSignal.timeout(10000) });
    закрыто++;
  };

  // ═══ ВКЛАДКИ МЁРТВЫХ ВЛАДЕЛЬЦЕВ ЗАКРЫВАЕМ СРАЗУ, БЕЗ ГРАЦИИ (13.08) ═══════════════════════
  // Файл слота убитого процесса теперь остаётся лежать (см. tabsBusy и снятый обработчик exit), и
  // в нём записаны id его вкладок. Владелец опознан и мёртв: ждать нечего. Прецедент дня: после
  // глушения волны осталось 10 сирот, все ушли в 20-минутную грацию как «ничьи», уборка вернула
  // {closed: 0, total: 10}, и следующий процесс повис на очереди вкладок.
  const мёртвыеВкладки = new Set();
  const мёртвыеСлоты = [];
  try {
    for (const f of fs.readdirSync(TABS_DIR)) {
      if (!/^\d+$/.test(f)) continue;
      let жив = false; try { process.kill(Number(f), 0); жив = true; } catch {}
      if (жив) continue;
      мёртвыеСлоты.push(`${TABS_DIR}/${f}`);
      try {
        const з = JSON.parse(fs.readFileSync(`${TABS_DIR}/${f}`, 'utf8'));
        for (const id of (з.targets || [])) мёртвыеВкладки.add(String(id));
      } catch { /* слот старого формата: вкладок за ним не записано */ }
    }
  } catch { /* папки ещё нет */ }
  const закрытыеСейчас = new Set();
  for (const t of список) {
    const id = String(t.id);
    if (!мёртвыеВкладки.has(id) || свои.has(id)) continue;
    if (живых - закрыто <= 1) continue;   // последняя страница браузера, не трогаем
    try { await закрытьВкладку(id); закрытыеСейчас.add(id); } catch { /* закроем следующим заходом */ }
  }
  // Слот мёртвого владельца снимаем, только когда его вкладок в браузере не осталось: снять раньше
  // значит потерять список id, и недобитая вкладка уйдёт в 20-минутную грацию.
  const открытые = new Set(список.map((t) => String(t.id)));
  for (const ф of мёртвыеСлоты) {
    let цели = [];
    try { цели = (JSON.parse(fs.readFileSync(ф, 'utf8')).targets || []).map(String); } catch {}
    const осталось = цели.some((id) => открытые.has(id) && !закрытыеСейчас.has(id));
    if (!осталось) { try { fs.unlinkSync(ф); } catch {} }
  }

  // ═══ НИЧЬИ ВКЛАДКИ БЕЗ ЗАПИСАННОГО ВЛАДЕЛЬЦА: ТОЛЬКО ПО ГРАЦИИ ════════════════════════════
  // ЖИВОЙ ПРОЦЕСС С БЕЗЫМЯННОЙ ВКЛАДКОЙ ОТМЕНЯЕТ ЭТУ ЧАСТЬ ЦЕЛИКОМ. Иначе мы закрываем вкладку,
  // которую опознать не смогли, и сборка падает с «Target page has been closed» (волна 9, 40 из 40).
  // Вкладок мёртвых владельцев отмена не касается: они опознаны точно, живого задеть не могут.
  let журнал = {};
  try { журнал = JSON.parse(fs.readFileSync(СИРОТЫ, 'utf8')); } catch {}
  const сейчас = Date.now();
  const новый = {};
  const грацияОтменена = естьБезымянные();
  for (const t of список) {
    const id = String(t.id);
    if (свои.has(id) || мёртвыеВкладки.has(id) || закрытыеСейчас.has(id)) continue;
    const впервые = журнал[id] || сейчас;
    if (грацияОтменена) { новый[id] = впервые; continue; }
    if (сейчас - впервые < ГРАЦИЯ_МС) { новый[id] = впервые; continue; }
    if (живых - закрыто <= 1) { новый[id] = впервые; continue; }   // это последняя страница браузера
    try { await закрытьВкладку(id); } catch { новый[id] = впервые; }
  }
  try { fs.mkdirSync(TABS_DIR, { recursive: true }); fs.writeFileSync(СИРОТЫ, JSON.stringify(новый)); } catch {}
  return { closed: закрыто, total: список.length };
}

/** ID вкладки в терминах CDP: нужен, чтобы уборщик отличал наши вкладки от сиротских. */
async function idВкладки(ctx, page) {
  try {
    const cdp = await ctx.newCDPSession(page);
    const { targetInfo } = await cdp.send('Target.getTargetInfo');
    await cdp.detach().catch(() => {});
    return targetInfo && targetInfo.targetId ? String(targetInfo.targetId) : null;
  } catch { return null; }
}

async function openAdmin() {
  const browser = await ensureChrome();
  const ctx = browser.contexts()[0] || (await browser.newContext());
  await waitTabSlot();
  const page = await ctx.newPage();
  // Свою вкладку записываем в слот СРАЗУ: с этой секунды уборщик её не тронет.
  const мой = await idВкладки(ctx, page);
  // ЕСЛИ ID НЕ ПРОЧИТАЛСЯ, ЭТО НЕ ПОВОД ОТДАТЬ СВОЮ ВКЛАДКУ УБОРЩИКУ. Ставим в слоте признак
  // «есть вкладка без имени», и уборка при живом таком процессе не делает НИЧЕГО (см. прибратьСиротские).
  // Так волна 9 потеряла 40 сборок: id не прочитался, вкладка числилась ничьей, её закрыли.
  const s = мойСлот();
  if (мой) записатьСлот([...(s.targets || []), мой]);
  else записатьСлот(s.targets || [], (s.безымянных || 0) + 1);
  // НОВАЯ ВКЛАДКА ОТКРЫВАЕТСЯ НА about:blank, И ЭТО ЛОМАЛО ЗАЛИВКУ (правка 10.08).
  // Заливка кадров идёт из страницы ОТНОСИТЕЛЬНЫМ адресом (/api/admin/promo/upload), а с
  // about:blank такой путь не собирается в ссылку вообще: fetch падает с «Failed to parse URL»,
  // а наверх это приходит как невнятное «fetch failed». Так сгорела волна из 30 постов: четыре
  // поста дошли до конца, кадры оплатились, а сохранить их было некуда. Интернет, база и сайт
  // при этом были живы, поэтому причину было легко списать на сеть.
  // Поэтому вкладку СРАЗУ ставим на админ-страницу. Кто рисует свой HTML (ttkit, slidekit),
  // всё равно перезаписывает содержимое через setContent, так что им это не мешает.
  try { await page.goto(ADMIN_URL, { waitUntil: 'domcontentloaded', timeout: 30000 }); }
  catch { /* сайт мог не ответить: пусть решает вызывающий, у него свои таймауты */ }
  // ЗАКРЫВАЕМ ТОЛЬКО СВОЮ ВКЛАДКУ (07.08). Здесь стоял ещё и browser.close(), а для соединения
  // через CDP это ЗАКРЫТИЕ ОБЩЕГО БРАУЗЕРА, а не отцепление: в залпе из восьми постов первый
  // закончивший гасил Chrome, и остальные семь умирали молча, без строки в логе (девочки 26, 29,
  // 31 потерялись именно так). Отцепляемся через disconnect, окно остаётся жить для соседей.
  return { page, done: async () => {
    await page.close().catch(() => {});
    if (typeof browser.disconnect === 'function') await browser.disconnect().catch(() => {});
    freeTabSlot();
  } };
}

module.exports = { openAdmin, портОтвечает, запуститьChrome, поднятьЕслиНужно, прибратьСиротские, PORT, CDP };
