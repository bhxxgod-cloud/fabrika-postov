const QUIET_BG = 'ФОН ДОМАШНИЙ И ЖИЛОЙ, но НЕ ГЛАВНЫЙ: следы жизни (мягкий '
  // ПЕРЕЧИСЛЕНИЕ ИСТОЧНИКОВ ПЕРЕПИСАНО 11.08 ПО ЖИВОМУ БРАКУ. Здесь стояло «(лампа, окно, гирлянда)»,
  // и это оказался главный поставщик ЖЁЛТОГО фона, который начальник запретил дословно: «нельзя делать
  // желтый фон, это топ АИ маркер нанобананы». Проверено кадрами: на локации «вид на трассу сверху»
  // модель повесила на окно жёлтую гирлянду и залила ей весь кадр, хотя в самой локации гирлянды нет,
  // а свет назван холодным. То есть жёлтый приходил не из локации, а отсюда: из двух слов «лампа» и
  // «гирлянда», которые в данных модели значат тёплый жёлтый.
  // Теперь названы ХОЛОДНЫЕ источники (окно с городом, экран, цветная подсветка), а жёлтая заливка
  // запрещена прямо. Тёплая лампа приказом разрешена маленьким акцентом в глубине, и такая локация
  // говорит про неё сама, своим полем «свет».
  + 'текстиль), не в резкости. СВЕТ ОДИН И ХОЛОДНЫЙ (окно с городом, экран, цветная '
  + 'подсветка), жёлтой заливки НЕТ: экспозиция '
  + 'неровная, тени и тёмные углы, заполняющего света НЕТ. Акцент на лице, низ кадра свободен '
  + 'под надпись.';
const BG_MODES = { home: REAL_BG, city: CITY_BG, quiet: QUIET_BG };

/**
 * Пара локаций «яркая Москва на кадре 3, тихое место на кадре 4» по номеру ротора.
 *
 * РОТАЦИЯ СО СМЕЩЕНИЕМ, А НЕ ДВА ОСТАТКА (09.08 вечер, правка под объём). Раньше оба индекса брались
 * как rotor % длина, и ПАРА мест повторялась каждые НОК длин: на пяти городских и пяти тихих это
 * каждые пять постов. Начальник заказал пачку на 100-150 постов, значит повтор пары вылезет в ленте
 * обязательно. Теперь у тихой локации к ротору прибавляется номер круга по городскому пулу, и пара
 * не повторяется весь цикл (число заставок × число домашних), а каждая локация по отдельности всё
 * равно идёт по кругу и подряд себя не повторяет.
 *
 * ШАГ СМЕЩЕНИЯ ТЕПЕРЬ СЧИТАЕТСЯ, А НЕ РАВЕН ЕДИНИЦЕ (11.08). Прежняя формула прибавляла ровно один
 * круг, и полный перебор пар получался ТОЛЬКО когда числа локаций удачно взаимно простые: при 11
 * заставках и 6 домашних местах пары начинали повторяться, и audit() падал на ровном месте. То есть
 * размеры пулов были молча связаны друг с другом, и любой, кто выключит одну локацию (а я 11.08
 * выключил четыре: три метро и такси), ронял модуль целиком и не понимал, почему. Теперь шаг
 * подбирается взаимно простым с числом домашних мест, и пулы можно чистить и пополнять свободно.
 *
 * @param {number} rotor сквозной номер (вызывающий хранит его в rotors.json, как для обложек)
 * @returns {{loc3:string, loc4:string, bg3:'city', bg4:'quiet', slug3:string, slug4:string,
 *   name3:string, name4:string, light3:string, light4:string}}
 */
/** Наибольший общий делитель: нужен, чтобы подобрать шаг ротации взаимно простым с длиной пула. */
function нод(a, b) { return b ? нод(b, a % b) : a; }

// ═══ РАЗВЕДЕНИЕ ГОРОДСКОГО ПУЛА ПО ГРУППАМ (11.08) ══════════════════════════════════════════
// ЗАЧЕМ. Отдел качества посчитал по 30 живым постам: кадр 3 в 47 процентах постов это Москва-Сити.
// Причина не в ротации, а в СОСТАВЕ пула: у Сити десять подтипов (башни издалека, между башнями,
// набережная, мост, подсветка, зима, крыша…), и при честной ротации по слугам она честно и занимает
// половину пула. Ротор тут не виноват: он идёт по кругу ровно, просто круг на две трети из Сити.
// ЧТО СДЕЛАНО. Порядок обхода городского пула считается ОДИН раз на загрузке и раскладывает локации
// так, чтобы соседние посты не приходились на одну группу: берём по очереди из групп, начиная каждый
// раз с самой большой по остатку и не повторяя предыдущую. В ленте это читается сразу: Сити, улица,
// Сити, парк, Сити, двор, а не пять башен подряд.
// ЧЕГО ЭТИМ СДЕЛАТЬ НЕЛЬЗЯ, СКАЖУ ПРЯМО: доля группы в выборке этим не падает. Если Сити это семь
// локаций из двадцати одной, её доля равна 33 процентам при любом порядке обхода, и снизить её можно
// только пополнением пула другими местами (я пополнил его 11.08, было 11 локаций, стало больше) или
// прямым выключением подтипов Сити, а это решение начальника: Сити он назвал обязательной локацией.
// ДОЛЯ ОТДЕЛЬНОЙ ЛОКАЦИИ при таком обходе равна 1/N и требование «не больше 15 процентов» держит.

/** Группа локации: своя из файла, либо Москва-Сити по названию места, либо сама локация. */
function группаЛокации(l) {
  if (l.group) return String(l.group);
  if (/москва-сити/i.test(l.place)) return 'москва-сити';
  return l.slug;
}

/**
 * Порядок обхода пула, разведённый по группам: подряд не идут две локации одной группы, пока это
 * вообще возможно. Считается один раз на загрузке, поэтому ротор остаётся простым остатком.
 * @param {object[]} pool записи локаций
 * @returns {object[]} те же записи, переставленные
 */
function развестиПоГруппам(pool) {
  const группы = new Map();
  for (const l of pool) {
    const g = группаЛокации(l);
    if (!группы.has(g)) группы.set(g, []);
    группы.get(g).push(l);
  }
  const out = [];
  let прошлая = null;
  while (out.length < pool.length) {
    // Из групп с непустым остатком берём самую большую, но не ту, что была в прошлый раз. Если
    // выбора нет (осталась одна группа), берём её: это честнее, чем зацикливаться.
    const кандидаты = [...группы.entries()].filter(([g, arr]) => arr.length && g !== прошлая);
    const [g, arr] = (кандидаты.length ? кандидаты : [...группы.entries()].filter(([, a]) => a.length))
      .sort((a, b) => b[1].length - a[1].length)[0];
    out.push(arr.shift());
    прошлая = g;
  }
  return out;
}

/**
 * Шаг смещения по домашнему пулу: сколько прибавлять к индексу при каждом новом круге по городскому
 * пулу. Берём первое смещение, взаимно простое с длиной домашнего пула: только тогда за полный цикл
 * перебираются ВСЕ пары «заставка + дом», а не часть их.
 */
function шагРотации(n3, n4) {
  for (let k = 1; k <= n4; k++) if (нод((n3 + k) % n4 || n4, n4) === 1) return n3 + k;
  return n3 + 1;   // недостижимо при n4 ≥ 1, но пусть функция всегда возвращает число
}

// Порядки обхода считаем ОДИН раз: ротор остаётся простым остатком, а разведение по группам уже
// заложено в сам порядок. Домашний пул разводим тем же способом: у него группы это комната, кухня,
// прихожая, балкон, и три кухни подряд в ленте видно так же хорошо, как три башни.
// ПОРЯДКИ ОБХОДА СЧИТАЮТСЯ ДЛЯ КАЖДОГО ТИРА ОТДЕЛЬНО (11.08, приказ про Дубай и Питер). Фильтрация
// стоит ДО разведения по группам, а не после: если сначала разложить общий пул, а потом выбросить из
// него чужие по тиру локации, разведение рассыпается (в получившемся порядке две локации одной группы
// снова встают рядом), и падает проверка выборки в audit(). Пул на тир маленький, считается один раз
// на загрузке, поэтому лишней работы тут нет.
// ═══ КАДР 4 ТОЛЬКО ТЁМНЫЙ (13.08, приказ начальника по посту тату-розовая #1) ═══════════════
// Дословно: «фон АИ, книга на полу нереальная, гирлянда… тёмный фон + неон на 4 фото будет
// идеально». Это продолжение его же правила от 11.08 «лучший фон почти не виден»: тёплые жилые
// сцены (гирлянда над кроватью, книга на полу) модель рисует неправдоподобно, и они палят
// генерацию. Тёмные группы у нас уже отсмотрены и лежат в locations-extra: квартира-неон,
// спальня-затемнённая, квартира-высокий-этаж, вид-из-окна. Кадр 4 берём ТОЛЬКО из них.
// Рубильник отката: DARK4=0 возвращает полный домашний пул.
const ТЁМНЫЕ_ГРУППЫ_4 = new Set(['квартира-неон', 'спальня-затемнённая', 'квартира-высокий-этаж', 'вид-из-окна']);
const DARK4 = process.env.DARK4 !== '0';
const тёмнаяЛокация4 = (l) => !DARK4 || ТЁМНЫЕ_ГРУППЫ_4.has(l.group);

const ORDER_BY_TIER = {};
for (const tier of Object.keys(TIERS)) {
  ORDER_BY_TIER[tier] = {
    city: развестиПоГруппам(LOC.city.filter((l) => локацияПодТир(l, tier))),
    quiet: развестиПоГруппам(LOC.quiet.filter((l) => локацияПодТир(l, tier) && тёмнаяЛокация4(l))),
  };
  for (const [вид, pool] of Object.entries(ORDER_BY_TIER[tier])) {
    if (pool.length < 2) {
      throw new Error(`promptkit: у тира «${tier}» (${TIERS[tier]}) в пуле «${вид}» всего ${pool.length} `
        + 'локаций, ротация выродится в одно место на все посты. Проверь поля «образ» в файлах локаций');
    }
  }
}
// Старые имена остаются и указывают на ОБЫЧНЫЙ тир: это поведение по умолчанию (см. postTier), и
// соседние сборщики, которые про тир не знают, работают ровно как раньше плюс Питер.
const ORDER_CITY = ORDER_BY_TIER.plain.city;
const ORDER_QUIET = ORDER_BY_TIER.plain.quiet;

/**
 * Пара локаций «город на кадре 3, дом на кадре 4» по номеру ротора и ТИРУ ОБРАЗА.
 * @param {number} rotor сквозной номер (вызывающий хранит его в rotors.json, как для обложек)
 * @param {object} [o] тир: {tier:'lux'|'plain'} или {lux:true}. Молчание значит обычный образ,
 *        см. postTier: Дубай уходит только там, где дорогой образ НАЗВАН
 */
function pickCityPlaces(rotor = 0, o = {}) {
  const r = Math.abs(Math.trunc(Number(rotor) || 0));
  const tier = postTier(o);
  const { city: ORDER3, quiet: ORDER4 } = ORDER_BY_TIER[tier];
  const n3 = ORDER3.length, n4 = ORDER4.length;
  const a = ORDER3[r % n3];
  const круг = Math.floor(r / n3);
  const b = ORDER4[((r % n3) + круг * шагРотации(n3, n4)) % n4];
  // ГЕЙТ НА ЭТАПЕ ВЫБОРА, А НЕ ТОЛЬКО ПЕРЕД ЗАКАЗОМ (11.08, приказ после поста d01c49a5, где кадр 3
  // снова вышел в метро). Проверка на выходе промпта роняет сборку и спасает деньги, но роняет её
  // ПОЗДНО: пост уже в работе. Здесь запрещённое место просто не может быть выбрано, а если оно
  // как-то оказалось в пуле, мы узнаем об этом на первом же посте и с именем локации в ошибке.
  assertNoTransport(`выбор локации кадра 3 «${a.slug}»`, `${a.place} ${a.light}`);
  assertNoTransport(`выбор локации кадра 4 «${b.slug}»`, `${b.place} ${b.light}`);
  // Тир отдаём наружу: по логу поста должно быть видно, ПОЧЕМУ кадр 3 оказался в Дубае, а не «так
  // вышло». Разбор брака по логу без этого поля превращается в угадывание.
  return { loc3: a.place, loc4: b.place, bg3: 'city', bg4: 'quiet',
    slug3: a.slug, slug4: b.slug, name3: a.name, name4: b.name, light3: a.light, light4: b.light,
    tier, tierName: TIERS[tier] };
}

/**
 * Все тихие локации, кроме одной. Нужен ОТСТУПНОЙ ХОД сборщика: RenderGrid отклоняет заказ по
 * фильтру безопасности на некоторых бытовых местах (живой случай — ванная), и тогда пост спасает
 * не удаление локации из пула, а второй заход по другому тихому месту.
 * @param {string} skipSlug локация, которую модель уже отклонила
 * @param {object} [o] тир образа, как у pickCityPlaces. Домашние пулы у тиров сейчас одинаковые, но
 *        читаем тир и здесь: отступной ход это ровно то место, где привязка тихо теряется
 * @returns {{loc:string, slug:string, name:string, light:string}|null}
 */
function nextQuietPlace(skipSlug, o = {}) {
  const alt = ORDER_BY_TIER[postTier(o)].quiet.find((l) => l.slug !== skipSlug);
  if (!alt) return null;
  // Отступной ход это тоже ВЫБОР локации, значит и он проходит гейт: фолбэки и значения по умолчанию
  // ровно то место, где запрещённая локация тихо возвращается в заказ (приказ 11.08).
  assertNoTransport(`отступная локация кадра 4 «${alt.slug}»`, `${alt.place} ${alt.light}`);
  return { loc: alt.place, slug: alt.slug, name: alt.name, light: alt.light };
}

// КАЧЕСТВО СЪЁМКИ. Просьба начальника «качество фото делать как на 6-7 айфон, будет реальнее»:
// именно слабая камера и делает кадр правдоподобным, глянцевый HDR выдаёт генерацию.
// МЯГКАЯ МИКРОДЕТАЛЬ ДОБАВЛЕНА ПО ЗАМЕРУ (09.08 вечер): резкость в области глаз у наших рабочих
// кадров 37, у коммерции и у кадров под аватарку 137, перекрытие ноль. Это и есть след ретуши и
// апскейла. Просить «шум в тенях» мало: модель отдаёт зашумлённый, но макро-резкий кадр, то есть
// обработанный сток. Резкость надо запрещать прямо.
// СЖАТО 09.08 НОЧЬЮ под блок SELFIE. Оба замеренных требования на месте: старый айфон (узкий
// диапазон, шум, нерезкие края) и мягкая микродеталь (резкость у глаз 37 против 137 у ретуши).
// Пояснение «это снимок телефона, а не бьюти-съёмка» теперь говорит SELFIE прямее.
// СЖАТО 11.08 (было 153, стало 122, освободилось 31). «Края не идеально резкие» и «МИКРОДЕТАЛЬ
// МЯГКАЯ: без макро-резкости» это одно и то же требование про резкость, сказанное дважды; осталось
// второе, потому что именно оно замерено числом (резкость у глаз 37 против 137 у ретуши) и именно его
// проверяет аудит. Слово «ресниц» убрано: макро-резкость запрещается вся, а не только на ресницах.
const IPHONE = 'КАЧЕСТВО КАК НА СТАРЫЙ АЙФОН 6-7: узкий диапазон, шум в тенях, без глянцевого HDR. '
  + 'МИКРОДЕТАЛЬ МЯГКАЯ: без макро-резкости.';

/**
 * Две РАЗНЫЕ локации для кадров 3 и 4 по номеру ротора.
 * @param {number} rotor сквозной номер (вызывающий хранит его в rotors.json, как для обложек)
 * @returns {{loc3:string, loc4:string}}
 */
function pickPlaces(rotor = 0) {
  const n = PLACES.length;
  // Домашний пул тоже проходит гейт на выборе: он отступной, но живой (PLACE_POOL=home), и в нём
  // лежала строка про машину, то есть путь в заказ мимо файла локаций у него был свой.
  const i = ((Number(rotor) || 0) % n + n) % n;
  // Сдвиг на 3, а не на 1: соседние места в пуле похожи по смыслу (работа и учёба), и «другая
  // локация» должна читаться сразу.
  const j = (i + 3) % n;
  assertNoTransport('выбор домашней локации кадра 3', PLACES[i]);
  assertNoTransport('выбор домашней локации кадра 4', PLACES[j]);
  return { loc3: PLACES[i], loc4: PLACES[j] };
}

/**
 * Промпт кадра-образа.
 * @param {object} o
 * @param {string} o.template шаблон поста (спрашиваем у templates.cjs его тип и семью)
 * @param {3|4} o.step номер кадра: 3 это первый образ, 4 это финальный самый дорогой
 * @param {'light'|'dark'|'red'|'auto'} o.srcHair цвет волос на исходнике
 * @param {number} o.hairIdx какой целевой цвет взять (одинаковый для кадров 3 и 4 одного поста)
 * @param {string} o.scene необязательное уточнение места и фона
 * @param {'home'|'city'|'quiet'} [o.bgMode] какой блок фона поставить: домашний (по умолчанию,
 *        старое поведение), городской для кадра-заставки или приглушённый под фирменную плашку
 * @param {string} [o.light] описание света ЭТОЙ локации из locations-moscow.json (поле «свет»).
 *        Ставится вместо общих слов про свет: у такси ночью и у кухни вечером он разный, а общая
 *        фраза «неровный уличный свет» на кухне звучит как ошибка и модель её выправляет по-своему
 * @param {string} [o.hairAim] явно названная цель по цвету волос для РЕТРАЯ кадра 3. Пустая строка
 *        значит обычный заказ. См. hairRetryLine ниже
 * @returns {string} готовый промпт без заглушек
 */
function lookPrompt({ template, step = 3, srcHair = 'auto', hairIdx = 0, scene = '', place = '',
  bgMode = 'home', light = '', hairAim = '', hairLenIdx = 0, poseSeed = '' } = {}) {
  if (!LADDER[step]) throw new Error(`promptkit: нет ступени лестницы для кадра ${step}, есть: ${LADDER_STEPS.join(', ')}`);
  const rules = TPL.get(template);
  const intent = byFamily(LOOK_INTENT, template);
  // НОС МЕНЯЕТСЯ ТОЛЬКО У «ТВОЕГО НОСИКА» (15.08, решение владельца дословно: «должен [отличаться],
  // делаем его чуть уже чтобы можно было заметить — якобы стал меньше»).
  //
  // ЗАЧЕМ ИСКЛЮЧЕНИЕ. KEEP запрещает трогать нос, и для всех остальных шаблонов это правильно: там
  // разбирают губы, брови, цветотип, а лицо обязано остаться своим, иначе разбор теряет смысл. Но
  // у nose-verdict нос И ЕСТЬ предмет поста. Карточка выносит вердикт, а кадры 3-4 показывают её
  // же лицо — и если нос на них не изменился, пост обещает разбор и не показывает ничего.
  //
  // ПОЧЕМУ «ЧУТЬ УЖЕ», А НЕ ПРОСТО «ДРУГОЙ НОС». Замер маркетолога: формулировка «нос чуть меньше»
  // дала результат, которого не видно на глаз. Значит просить надо КОНКРЕТНО (спинка уже, крылья
  // собраннее) и обязательно оговаривать, что остальное лицо не трогается, — иначе модель, получив
  // разрешение на нос, перерисовывает лицо целиком и пост уходит в брак «другая девушка».
  const носТема = byFamily({ 'nose-verdict': true }, template) === true;
  const keep = rules.stylized ? KEEP_STYLIZED
    : (носТема
      // ЗДЕСЬ ТОЛЬКО СНИМАЕМ ЗАПРЕТ, А САМУ ЗАДАЧУ СТАВИМ В LOOK_INTENT (см. 'nose-verdict' там).
      // Первые две версии правки дописывали требование сюда, и обе разбили аудит: промпт этого
      // шаблона и без того упирается в потолок 3200 знаков. Место для задачи в промпте УЖЕ ЕСТЬ —
      // это слот замысла, куда для губ идёт «яркая помада», для стрижки «стрижка под форму лица».
      // Нос ничем не особеннее: он тема шаблона, значит его место там же, а не отдельной припиской.
      ? KEEP.replace('нос, губы', 'губы')
      : KEEP);
  // МЕСТО ОБЯЗАТЕЛЬНО НАЗЫВАЕМ. Раньше при пустом scene подставлялась общая фраза «спокойный фон»,
  // и именно она давала салонный кадр «на отзыв клиента». Теперь место приходит из пула локаций.
  const where = String(place || scene || '').trim();
  if (!where) throw new Error('promptkit: не передана локация кадра, а без неё модель рисует студию '
    + 'или салон. Возьми пару локаций у pickPlaces(rotor) и передай place');
  // Блок фона ОДИН, а не приписка к домашнему: приписка раздувала промпт, а требования «живой
  // беспорядок и следы на стене» и «фон приглушён, ничего яркого» прямо спорят друг с другом.
  const bg = BG_MODES[bgMode];
  if (!bg) throw new Error(`promptkit: неизвестный режим фона «${bgMode}», знаю: ${Object.keys(BG_MODES).join(', ')}`);
  // РАЗВЕДЕНИЕ ПОЗЫ РАЗРЕШЕНО ТОЛЬКО КАРТОЧНЫМ ШАБЛОНАМ, И ПРИЧИН ДВЕ, ОБЕ НЕ ПРО ВКУС.
  //   1) «три одинаковых положения лица» это болезнь именно карточного поста: там кадр 1 это сам
  //      исходник, а кадры 3 и 4 рисуются по нему этим промптом, то есть три раза подряд одна поза.
  //      У арта и тренда кадры 3 и 4 приходят не отсюда (телефон с артом и artFinalPrompt по самому
  //      арту), и разводить позу надо было бы там, другими словами;
  //   2) у арт-шаблонов промпт УЖЕ длиной 3154 знака при пороге 3200, и строка позы в него просто не
  //      влезает. Тихо её выбросить нельзя: тихо выброшенный параметр это самый дорогой баг этого
  //      проекта (референс так две недели уходил в несуществующее поле API). Поэтому здесь ошибка.
