// её обрезали ради длины промпта).
const POSE_MIX = [
  'ПОЗА: плечо вперёд, корпус боком.',
  'ПОЗА: голова наклонена к плечу.',
  'ПОЗА: глаза уведены в сторону.',
  'ПОЗА: рука поправляет прядь.',
  'ПОЗА: рука у ключицы.',
  'ПОЗА: лицо к камере через плечо.',
  'ПОЗА: шагает, корпус в движении.',
  'ПОЗА: рука у лица, пальцы у щеки.',
];

/**
 * Число из строки, FNV-1a. Своё, а не sha256 из crypto, ради одной вещи: раздача поз обязана быть
 * ОДИНАКОВОЙ у всех сборщиков и не зависеть ни от версии ноды, ни от порядка вызовов, а читаться
 * должна глазами при разборе поста.
 * @param {string} s любая строка-семя
 * @returns {number} беззнаковое 32-битное число
 */
function seedNum(s) {
  let h = 0x811c9dc5;
  const str = String(s || '');
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return h >>> 0;
}

/**
 * Правка позы для кадра. РАЗДАЁТСЯ ПО СЕМЕНИ ПОСТА, А НЕ СЛУЧАЙНО: у одного поста кадры 3 и 4
 * обязаны получить РАЗНЫЕ позы (иначе мы лечим «одинаковые лица» наполовину), а повторный прогон
 * того же поста, ретрай и пересборка через fix4 обязаны дать ТУ ЖЕ позу, иначе финал разъедется с
 * образом. Случайное число оба этих требования нарушает.
 *
 * ПОЧЕМУ КАДРУ 1 ПОЗА НЕ ВЫДАЁТСЯ. Кадр 1 это сам исходник, мы его не генерим и позу на нём не
 * выбираем. Развести кадры 1, 3 и 4 значит увести кадры 3 и 4 ОТ позы исходника и друг от друга, а
 * для этого достаточно двух разных правок на два генерируемых кадра.
 *
 * @param {string} seed семя поста (у onepost это sha256 исходника: одна картинка = один пост)
 * @param {3|4} step номер кадра
 * @returns {string} одна строка пула
 */
function poseTweak(seed, step = 3) {
  if (!POSE_MIX.length) throw new Error('promptkit: пул поз пуст, разводить кадры нечем');
  const h = seedNum(seed);
  const i3 = h % POSE_MIX.length;
  if (Number(step) === 3) return POSE_MIX[i3];
  // Кадру 4 индекс сдвигаем на 1..n-1, поэтому совпасть с кадром 3 он не может ПО ПОСТРОЕНИЮ, а не
  // по счастливой случайности: проверять совпадение потом и переспрашивать это лишняя развилка.
  const shift = 1 + (seedNum(`${seed}|4`) % (POSE_MIX.length - 1));
  return POSE_MIX[(i3 + shift) % POSE_MIX.length];
}

function keepFacePrompt({ srcHair = 'auto', hairIdx = 0, place = '', light = '' } = {}) {
  const where = String(place || '').trim();
  if (!where) throw new Error('promptkit: keepFacePrompt без локации: без места модель рисует студию');
  const lightLine = String(light || '').trim();
  // Промпт НАРОЧНО короткий (около 650 знаков против 3000 у боевого). Длина здесь не стиль, а
  // замеренное условие: те же требования, разбавленные боевым промптом, личность не удержали
  // (0.047-0.101), а короткий с привязкой к крупности удержал (0.716).
  // ГЕЙТ ТРАНСПОРТА ЗДЕСЬ ОСОБЕННО НУЖЕН, И ВОТ ПОЧЕМУ. Замер выше говорит, что спасательный промпт
  // держит лицо в ТЕСНОМ месте, и лучший результат из всех получился именно в тоннеле эскалатора
  // (0.443 против 0.157 на панораме крыши). То есть у этого промпта есть прямой соблазн взять метро
  // как «удачную» локацию: цифра красивая, кадр забракован начальником. Гейт закрывает этот путь
  // насовсем, а тесноту надо искать в домашних местах (прихожая, коридор, кухня у окна).
  return assertNoTransport('keepFacePrompt', 'ОТРЕДАКТИРУЙ ПРИЛОЖЕННОЕ ФОТО, это НЕ новая картинка. В кадре ТОТ ЖЕ человек: черты лица, '
    + 'глаза, нос, губы, овал и возраст ровно с фото, лицо не перерисовывать. КРУПНОСТЬ И РАКУРС ТЕ '
    + 'ЖЕ, ЧТО НА ФОТО: голова так же близко к камере, тот же поворот головы, та же посадка в кадре. '
    + `МЕНЯЮТСЯ ДВА: цвет волос становится ${hairTarget(srcHair, hairIdx)}, от корней до кончиков, и `
    + `фон — она в другом месте. МЕСТО: ${where}.`
    + (lightLine ? ` СВЕТ: ${lightLine}.` : '')
    // ЗАПРЕТ ОБЩЕГО ПЛАНА СТОИТ ЗДЕСЬ ПО ЗАМЕРУ, А НЕ ДЛЯ КРАСОТЫ: тот же промпт в локации «крыша,
    // панорама города» дал 0.157 (другой человек), а в тесном тоннеле эскалатора 0.443 (то же
    // лицо). Локация сама заказывает пересборку кадра, и её надо перебить словами.
    + ' ОБЩЕГО ПЛАНА И ПАНОРАМЫ НЕ СТРОИТЬ: место видно только за спиной, кадр остаётся крупным. '
    // ЗАПРЕТ ПОСТОРОННИХ ЛИЦ НУЖЕН И ЗДЕСЬ. Этот промпт не собирает banBlock (он нарочно короткий, см.
    // выше), значит общий запрет others сюда не доезжает, а «другое место» на фоне модель заполняет
    // прохожими и вторым человеком ровно так же, как в боевом кадре. Одна строка, чтобы фон за спиной
    // не привёл в кадр чужое лицо.
    + 'ОНА В КАДРЕ ОДНА: посторонних людей и лиц на фоне нет. '
    // ПОЗЫ ЗДЕСЬ НЕТ, И ЭТО РЕШЕНО ЗАМЕРОМ ДВАЖДЫ. 10.08 правки позы стояли ровно тут и уронили
    // сходство лица кадра 3 с 0.588 до 0.473 на девяти постах, два поста ушли в брак «другой
    // человек», правку откатили. 11.08 разобрана ПРИЧИНА: этот промпт держит лицо требованием «та
    // же крупность, тот же поворот головы, та же посадка в кадре» (с ним 0.716, без него
    // 0.047-0.101), и строка про новую позу прямо ему противоречит, а спор в промпте модель решает
    // в свою пользу и рисует кадр заново. Разведение позы живёт в ОСНОВНОМ промпте, где такого
    // требования нет: пул POSE_MIX и poseTweak выше, там же числа замера. Сюда его не возвращать.
    + 'Надписей, букв и логотипов в кадре нет. ГЛАВНОЕ: лицо ровно с приложенного фото.');
}

// ═══ 6б. НОВАЯ ОБЛОЖКА ТОЙ ЖЕ ДЕВУШКИ ═══════════════════════════════════════════════════════
// ЗАЧЕМ (14.08, приказ владельца дословно: «просто чтобы фото не уникализировать, а новое сделать»).
// Замер того же дня: 90 рилсов из 209 в пачке сделаны на ВОСЬМИ фотографиях. Одна карточка ушла на
// десяток аккаунтов, отличаясь только надписью хука — проверено и хешем (0-6 бит расхождения из 256
// при пороге ковергарда 48), и глазами. Правило «одно фото = один пост» это чинит, но упирается в
// то, что фоток у нас 13, а нужно сотни.
//
// ПОЧЕМУ НЕ ГОДИТСЯ БОЕВОЙ lookPrompt. Он ТРЕБУЕТ сменить цвет и длину волос («ОБЯЗАНО
// ИЗМЕНИТЬСЯ, иначе брак»), и это правильно для кадров 3 и 4: там нужен другой образ. Но обложка
// это лицо аккаунта. Если у девушки на обложке каждый раз новый цвет волос, то это не одна
// девушка, а десять разных, и вся легенда рассыпается.
//
// ЧТО МЕНЯЕТСЯ, А ЧТО НЕТ. Держим ВСЁ, по чему её узнают: лицо, цвет и длину волос, тон кожи,
// возраст, родинки и татуировки. Меняем место, позу, крупность, одежду и свет — то есть это
// ДРУГОЙ ДЕНЬ и другое селфи той же девушки. Такой кадр расходится с исходником на сотню бит
// (ковергард видит разные картинки), а лицо остаётся тем же (facesim видит одного человека).
//
// ПОЧЕМУ ПРОМПТ КОРОТКИЙ. Замер 11.08, записанный в keepFacePrompt выше: те же требования,
// разбавленные боевым промптом на 3000 знаков, личность НЕ удержали (сходство 0.047-0.101), а
// короткий с привязкой к крупности удержал (0.716). Здесь та же задача, поэтому та же длина.
// Разница с keepFacePrompt одна, но принципиальная: там волосы МЕНЯЮТСЯ, здесь остаются.
const ОБЛОЖКА_ДЕРЖИМ = 'ОТРЕДАКТИРУЙ ПРИЛОЖЕННОЕ ФОТО, это НЕ новая картинка и НЕ другая девушка. '
  + 'В кадре ТОТ ЖЕ человек: те же черты лица, тот же разрез и ЦВЕТ ГЛАЗ, тот же нос, та же форма '
  + 'губ, тот же овал, тот же тон кожи, тот же ВОЗРАСТ, те же родинки и татуировки. ЦВЕТ ВОЛОС И '
  + 'ДЛИНА ВОЛОС ОСТАЮТСЯ РОВНО КАК НА ФОТО: другой цвет волос это брак, это будет уже не она.';

/**
 * Промпт новой обложки: та же девушка, другой день и другое селфи.
 * @param {object} o
 * @param {string} o.place где снято (обязательно: без места модель рисует студию)
 * @param {string} [o.light] свет
 * @param {string} [o.pose] поза из POSE_MIX
 * @param {string} [o.clothes] одежда
 * @returns {string} готовый промпт
 */
function coverPrompt({ place = '', light = '', pose = '', clothes = '' } = {}) {
  const where = String(place || '').trim();
  if (!where) throw new Error('promptkit: coverPrompt без локации: без места модель рисует студию');
  return assertNoTransport('coverPrompt', ОБЛОЖКА_ДЕРЖИМ
    + ' МЕНЯЕТСЯ ТОЛЬКО ОБСТАНОВКА: это ДРУГОЙ ДЕНЬ и ДРУГОЕ СЕЛФИ той же девушки. Другое место, '
    + 'другая поза, другой поворот головы, другое выражение лица, другая крупность. Повтор '
    + 'приложенного кадра это брак: нам нужен именно новый снимок, а не та же картинка с правками.'
    + ` МЕСТО: ${where}.`
    + (String(light || '').trim() ? ` СВЕТ: ${String(light).trim()}.` : '')
    + (String(clothes || '').trim() ? ` ОДЕЖДА ДРУГАЯ: ${String(clothes).trim()}.` : '')
    + (String(pose || '').trim() ? ` ПОЗА: ${String(pose).trim()}.` : '')
    + ' ЭТО СЕЛФИ НА ФРОНТАЛЬНУЮ КАМЕРУ с вытянутой руки, 40-60 см от лица, чуть выше глаз. '
    + 'Лицо крупное, ЗАНИМАЕТ БОЛЬШУЮ ЧАСТЬ КАДРА, место видно только за спиной. ОБЩЕГО ПЛАНА И '
    + 'ПАНОРАМЫ НЕ СТРОИТЬ, в полный рост не снимать. ОНА В КАДРЕ ОДНА: посторонних людей и лиц на '
    + 'фоне нет. Руки с телефоном в кадре нет, это не зеркало. КАЧЕСТВО КАК СЕЛФИ НА ТЕЛЕФОН: '
    + 'лицо не пересвечено, тени есть, глянцевого студийного света НЕТ, кожа живая, поры видны. '
    + 'Надписей, букв, цифр и логотипов в кадре нет. Оголённости, белья и глубокого выреза нет. '
    + 'ГЛАВНОЕ: это та же девушка, что на приложенном фото, узнать её обязан любой.');
}

// ═══ 7a. ФИНАЛЬНЫЙ КАДР АРТ-ШАБЛОНОВ ════════════════════════════════════════════════════════
// ЗАЧЕМ ОТДЕЛЬНЫЙ ПРОМПТ. Финал у нас обязан быть ДОГЕНЕРИРОВАН, а не выкроен из третьего кадра
// (приказ начальника 09.08 дословно: «4 кадр должен был быть 2, а у нас 3 и 4 один кропленный
// кадр»). Для карточных шаблонов финал делается из чистого фото обычным lookPrompt. А для
// арт-шаблонов исходником финала служит САМ АРТ (второй кадр): тренд с волосами-сердечками, чб
// сквозь пальцы, двойная экспозиция. Гонять по арту lookPrompt нельзя: тот требует сменить цвет
// волос и сделать салонную укладку, то есть УНИЧТОЖИТ сам эффект шаблона, за который пост и
// смотрят. Поэтому здесь свой промпт: эффект держим дословно, меняем только ракурс и выражение.
const ART_FINAL_KEEP = 'ОТРЕДАКТИРУЙ ПРИЛОЖЕННЫЙ КАДР: это уже готовая обработка, её замысел и '
  + 'стиль трогать нельзя. В кадре ТОТ ЖЕ человек: те же черты лица, тот же разрез и ЦВЕТ ГЛАЗ, '
  + 'та же форма губ, тот же овал, тот же тон кожи, тот же ВОЗРАСТ. ТОТ ЖЕ ЦВЕТ И ТА ЖЕ ДЛИНА '
  + 'ВОЛОС, тот же эффект обработки, та же цветовая гамма, тот же свет и та же одежда.';
const ART_FINAL_CHANGE = 'МЕНЯЕТСЯ РОВНО ОДНО: это ДРУГОЙ СНИМОК ТОЙ ЖЕ СЪЁМКИ. Другой поворот '
  + 'головы в три четверти, другой взгляд и другое выражение лица, крупность чуть шире. '
  + 'Повтор приложенного кадра это брак: два одинаковых кадра в карусели никто не досматривает.';

// УСИЛЕННАЯ ВЕРСИЯ ДЛЯ СТАТИЧНЫХ СЦЕН (13.08, замер на двух постах подряд). У шаблонов «девушка в
// салоне машины / в кабине» фон занимает почти весь кадр и не меняется, поэтому «другой поворот
// головы» даёт расхождение с кадром 2 всего 16-55 бит dHash, и framegate валит пост как
// «кадр 4 похож на перекадрировку кадра 2» (пороги см. framegate T.cropDiff). Роллс 4a8c7573 и
// BMW 6dd3cfe8 легли именно так. Лечение: для этих шаблонов просим смену крупности И точки съёмки,
// тогда меняется сама композиция, а не только голова. На остальные арт-шаблоны не трогаем: у них
// перерисовка меняет кадр сама.
const ART_FINAL_STATIC_SET = new Set(['img-rolls-selfie', 'img-bmw-photo', 'img-pilot-girl', 'img-gelik-azs']);
const ART_FINAL_CHANGE_STATIC = 'МЕНЯЕТСЯ КОМПОЗИЦИЯ, НО НЕ МЕСТО: это ДРУГОЙ СНИМОК ТОЙ ЖЕ '
  + 'СЪЁМКИ, снятый с другой точки. Камера с другой стороны, крупность РЕЗКО другая: если исходник '
  + 'поясной, то тут крупный портрет от груди, и наоборот. Другая поза рук, другой поворот головы, '
  + 'другое выражение лица, за девушкой видна другая часть того же салона или кабины. '
  + 'Повтор композиции приложенного кадра это брак: два похожих кадра в карусели никто не досматривает.';

/**
 * Промпт финального кадра для АРТ-шаблонов: догенерация по второму кадру (по самому арту).
 * @param {object} o
 * @param {string} o.template шаблон поста
 * @returns {string} готовый промпт
 */
function artFinalPrompt({ template } = {}) {
  if (TPL.isCard(template)) {
    throw new Error(`promptkit: шаблон «${template}» карточный, его финал делается из ЧИСТОГО фото `
      + 'через lookPrompt, а не из карточки с инфографикой');
  }
  // Ступень качества LADDER[4] сюда НЕ ставим осознанно: она требует переставить свет и вывести
  // цвет, а это прямо противоречит «тот же свет и та же гамма» выше. Два противоречивых требования
  // в одном промпте модель решает в свою пользу и перерисовывает кадр целиком, теряя эффект.
  return assertNoTransport(`artFinalPrompt.${template}`, [
    ART_FINAL_KEEP,
    ART_FINAL_STATIC_SET.has(template) ? ART_FINAL_CHANGE_STATIC : ART_FINAL_CHANGE,
    banBlock(template),
    textRule(template, { card: false }),
    HUMAN,
  ].join(' '));
}

/**
 * Промпт карточки-инфографики (второй кадр карточных шаблонов).
 * Лицо на карточке тоже её, поэтому keep нужен и здесь, а вот смена волос нет: карточка это
 * разбор ИСХОДНОЙ внешности, до преображения.
 */
function cardPrompt({ template, title = '', scene = '' } = {}) {
  if (!TPL.isCard(template)) throw new Error(`promptkit: шаблон «${template}» не карточный, карточку ему не заказываем`);
  const head = title ? `Сделай карточку разбора с заголовком «${title}».` : 'Сделай карточку разбора внешности по приложенному фото.';
  // Гейт и здесь: у карточки фон приходит строкой scene, то есть тем же путём, каким транспорт
  // приезжал в кадры образа.
  return assertNoTransport(`cardPrompt.${template}`, [
    head,
    'Слева фото девушки с приложенного кадра, справа аккуратная инфографика разбора: '
    + 'короткие строки с подписями и оценками, чистая сетка, много воздуха, спокойная светлая '
    + 'палитра, тонкие линии.',
    KEEP,
    scene ? `ФОН: ${scene}.` : 'ФОН карточки однотонный светлый.',
    banBlock(template),
    textRule(template, { card: true }),
    HUMAN,
  ].join(' '));
}

// ═══ 8. АУДИТ ПРИ ЗАГРУЗКЕ ══════════════════════════════════════════════════════════════════
// Ищем заглушки в квадратных скобках и пустые вставки. Роняем модуль сразу: промпт с заглушкой
// уезжает в модель как текст и печатается буквами прямо на кадре, а увидим мы это только глазами
// и уже после списанной генерации.
const PLACEHOLDER = /\[[^\]\n]{1,80}\]|\{\{?[A-Za-zА-Яа-я_ ]{1,40}\}?\}|<[a-zA-Zа-яА-Я_ ]{1,40}>/;

function auditText(what, s) {
  if (typeof s !== 'string' || !s.trim()) throw new Error(`promptkit: пустой блок «${what}»`);
  const m = s.match(PLACEHOLDER);
  if (m) throw new Error(`promptkit: заглушка «${m[0]}» в блоке «${what}», промпты с заглушками запрещены`);
  if (/undefined|null|NaN/.test(s)) throw new Error(`promptkit: мусорная вставка в блоке «${what}»`);
}

/** Полная проверка: блоки, обязательные поля карточных шаблонов, все промпты всех шаблонов. */
function audit({ verbose = false } = {}) {
  auditText('KEEP', KEEP);
  auditText('KEEP_STYLIZED', KEEP_STYLIZED);
  auditText('SCOPE', SCOPE);
  auditText('HUMAN', HUMAN);
  auditText('TYPAGE', TYPAGE);
  auditText('GEOM', GEOM);
  auditText('SELFIE', SELFIE);
  auditText('APPEAL', APPEAL);
  // СЕЛФИ ПРОВЕРЯЕМ ПО ПРИЗНАКАМ, А НЕ ПО НАЛИЧИЮ СЛОВА «СЕЛФИ». Слово одно модель прочитает и
  // нарисует всё тот же портрет со стороны, «как бы селфи». Работают именно признаки, и каждый из
  // них назван начальником по забракованным кадрам, поэтому потеря любого это возврат брака.
  for (const need of ['ВЫТЯНУТОЙ РУКЕ', '40-60 см', 'ЧУТЬ ВЫШЕ глаз', 'КРУПНЕЕ фона',
    'искажение широкого угла', 'корпус развёрнут', 'Фон случайный', 'НЕ ИДЕАЛЬНЫЙ']) {
    if (!SELFIE.includes(need)) {
      throw new Error(`promptkit: в блоке селфи потерялось «${need}», без этого признака модель `
        + 'вернёт портрет со стороны: она рисует его по умолчанию');
    }
  }
  // Блок обязан САМ снимать спор с запретом телефона, иначе модель положит телефон в кадр (и это
  // вернёт нам кадр «до» вместо результата, ровно тот баг партнёрских промптов).
  if (!/телефона в кадре НЕТ/.test(SELFIE) || !/не зеркало/.test(SELFIE)) {
    throw new Error('promptkit: блок селфи не снимает спор с запретом телефона и зеркала: '
      + 'нужны прямые слова «телефона в кадре НЕТ» и «это не зеркало»');
  }
  // ТИПАЖ ОБЯЗАН БЫТЬ СТОРОЖЕМ, А НЕ ЗАДАНИЕМ. Слова «нарисуй», «сделай», «замени» рядом с типажом
  // превращают блок в разрешение переделать лицо, а это прямая подмена человека: ровно так провалилась
  // первая версия KEEP. Проверяем строкой, потому что переписать блок «покрасивее» соблазнительно.
  if (/нарисуй|сделай|замени|преврати/i.test(TYPAGE)) {
    throw new Error('promptkit: блок типажа стал приказом («нарисуй/сделай»), а он обязан только ЗАПРЕЩАТЬ уход в чужой типаж: '
      + 'иначе модель перерисует лицо с приложенного фото под описание');
  }
  // Геометрия обязана называть три замеренных вещи: лицо вверху, сцену под лицом, поворот головы.
  // Потеря любой из них возвращает кадр под аватарку, а это и есть главный брак пинтерест-пула.
  for (const need of ['ВЕРХНЕЙ части кадра', 'ПОЛОВИНУ кадра', 'ПОВЁРНУТА']) {
    if (!GEOM.includes(need)) throw new Error(`promptkit: в блоке геометрии потерялось «${need}»`);
  }
  // Спокойный грим глаз это второй по силе разделяющий признак (перекрытие ноль), и живёт он в
  // блоке обязательных изменений. Без него модель кладёт полный вечерний макияж.
  if (!/МАКИЯЖ СПОКОЙНЫЙ/.test(mustChangeBlock('dark', 0))) {
    throw new Error('promptkit: из блока изменений исчез спокойный макияж, кадр уедет в рекламу косметики');
  }
  // ═══ ВОЛОСЫ БЕЗ САЛОННОЙ УКЛАДКИ (11.08, брак «нереально пышные прически») ══════════════════
  // Проверяем ДВУМЯ сторонами, потому что одной стороной такое правило всегда возвращается назад:
  //   1) положительное требование обязано стоять в блоке изменений (иначе кадр 4 опять придёт с
  //      рекламной головой, а мы даже не поймём, когда его потеряли при очередном сжатии промпта);
  //   2) слова, которыми салонная укладка ЗАКАЗЫВАЕТСЯ, обязаны отсутствовать во всех блоках, куда
  //      их естественно дописать: сам блок изменений, замыслы образа и пул длин волос. Список слов
  //      взят из живого брака: объём у корней, пышность, блеск, локоны и салонная укладка.
  // ПРО ГРАНИЦУ СЛОВА: «уклад» без отрицания рядом ловится намеренно, поэтому проверяем сначала
  // наличие «БЕЗ УКЛАДКИ», а потом ищем заказ укладки в остатке строки.
  // «Без блеска» это наша правильная строка, а «блеск» без отрицания это заказ рекламы шампуня,
  // поэтому у блеска стоит проверка предыдущего слова (в JS это делает look-behind).
  const САЛОН_ВОЛОС = /объём\w*\s+(у|от)\s+корн|пышн|(?<!без )блеск|шелковист|локон|укладка салонн|салонная уклад|уложен/i;
  {
    const блок = mustChangeBlock('dark', 0, 0);
    if (!/ВОЛОСЫ БЕЗ УКЛАДКИ/.test(блок)) {
      throw new Error('promptkit: из блока изменений исчезло «ВОЛОСЫ БЕЗ УКЛАДКИ», и кадр 4 вернётся с '
        + 'рекламной пышной головой (прямой брак начальника 11.08: «нереально пышные прически, оно '
        + 'делает его нереалистичным»)');
    }
    const остаток = блок.replace('ВОЛОСЫ БЕЗ УКЛАДКИ', '');
    if (САЛОН_ВОЛОС.test(остаток)) {
      throw new Error('promptkit: в блоке изменений опять заказана салонная укладка («'
        + остаток.match(САЛОН_ВОЛОС)[0] + '»). Волосы у нас домашние: у корней плоско, прядь выбилась');
    }
    // Смена образа при этом обязана остаться: небрежность не отменяет приказ «меняются и цвет, и длина».
    if (!/ЦВЕТ ВОЛОС МЕНЯЕТСЯ/.test(блок) || !/ДЛИНА И ФОРМА ВОЛОС МЕНЯЮТСЯ/.test(блок)) {
      throw new Error('promptkit: небрежные волосы съели смену образа: в блоке изменений обязаны стоять '
        + 'И смена цвета, И смена длины волос (отдельный приказ начальника)');
    }
  }
  HAIR_LENGTHS.forEach((v, i) => {
    if (САЛОН_ВОЛОС.test(v)) {
      throw new Error(`promptkit: длина волос HAIR_LENGTHS[${i}] («${v}») называет салонную укладку, `
        + 'а пул длин отвечает только за силуэт: длину и форму, без объёма и блеска');
    }
  });
  for (const [k, v] of Object.entries(LOOK_INTENT)) {
    // Обложке журнала студийный замысел разрешён по построению (studioLook), остальным нет.
    if (k !== 'magazine-cover' && САЛОН_ВОЛОС.test(v)) {
      throw new Error(`promptkit: замысел образа LOOK_INTENT.${k} («${v}») заказывает салонные волосы, `
        + 'а это спорит с блоком изменений, и спор модель решает в пользу рекламы шампуня');
    }
  }
  // Мягкая микродеталь: замер резкости у глаз 37 против 137 у ретуши, перекрытие ноль.
  if (!/МИКРОДЕТАЛЬ МЯГКАЯ/.test(IPHONE)) {
    throw new Error('promptkit: из блока качества исчезла мягкая микродеталь, кадр придёт с макро-резкостью ретуши');
  }
  for (const st of LADDER_STEPS) auditText(`LADDER.${st}`, LADDER[st]);
  for (const st of LADDER_STEPS) auditText(`SHOT.${st}`, SHOT[st]);

  // ═══ САМОПРОВЕРКА ГЕЙТА ТРАНСПОРТА ══════════════════════════════════════════════════════════
  // Гейт это единственная защита от того пути, которым метро доезжало до оплаченного заказа (локация
  // строкой мимо пула), и поэтому он проверяется не «читается нормально», а примерами. Падежи здесь
  // не для полноты: /\bметро\b/ в JS не находит «в метро» вообще (после кириллицы \b не работает), и
  // именно на такой регулярке гейт был бы бесполезной галочкой.
  for (const дурное of ['в метро на платформе', 'на эскалаторе метро', 'у эскалатора', 'вышла из метро',
    'московский метрополитен', 'в салоне трамвая', 'в автобусе у окна', 'на заднем сиденье такси',
    'в лифте', 'в вагоне электрички', 'у турникетов', 'в подземке', 'на пассажирском сиденье']) {
    if (!transportHits(дурное).length) {
      throw new Error(`promptkit: гейт транспорта пропускает «${дурное}», а обязан рубить: `
        + 'проверь корни в TRANSPORT_BAN и границу слова (после кириллицы \\b не работает)');
    }
  }
  // И обратная сторона: гейт не имеет права рубить наши нормальные слова. «Лифтинг» это уход за
  // кожей и он законно встречается в бьюти-словаре, а «километр» и «квартира» просто похожи по
  // буквам. Ложное срабатывание тут дороже пропуска: оно роняет сборку живого поста.
  for (const хорошее of ['лифтинг кожи, ухоженный вид', 'сто километров пути, квартира в новостройке',
    'в своей комнате вечером, гирлянда над кроватью', 'на кухне утром у окна', 'в коридоре у вешалки']) {
    const hits = transportHits(хорошее);
    if (hits.length) {
      throw new Error(`promptkit: гейт транспорта ложно сработал на «${хорошее}» (нашёл `
        + hits.map((w) => `«${w}»`).join(', ') + '), а это разрешённые слова');
    }
  }
  // Локации теперь пул, а не две строки: проверяем каждую и то, что пара мест всегда разная.
  PLACES.forEach((pl, i) => {
    auditText(`PLACES[${i}]`, pl);
    // Локация не должна называть то, что запрещено в кадре: «на столе телефон» вместе с запретом
    // гаджетов это промпт, спорящий сам с собой, и модель решает спор в свою пользу.
    if (/телефон|гаджет|смартфон/i.test(pl)) throw new Error(`promptkit: локация «${pl}» называет телефон, а он запрещён в кадре`);
    // ГЕЙТ ТРАНСПОРТА И ПО СТАРОМУ ДОМАШНЕМУ ПУЛУ ТОЖЕ (11.08). Он отступной, но он живой: в нём
    // лежала строка «в машине на пассажирском сиденье», и через pickPlaces она уезжала в заказ мимо
    // всякого файла локаций. Проверять надо все пулы, а не только новые.
    assertNoTransport(`PLACES[${i}]`, pl);
    // МЕБЕЛЬНЫЕ ФОНЫ И ЗДЕСЬ (11.08). Пул отступной, но живой: через pickPlaces он уезжает в заказ
    // мимо файла локаций, и вешалка с одеждой лежала ровно тут.
    const мебель = pl.match(МЕБЕЛЬ_БАН);
    if (мебель) {
      throw new Error(`promptkit: домашняя локация PLACES[${i}] держит фоном мебель-хранение `
        + `(«${мебель[0]}»), а начальник её забраковал: «удаляй эьти шкафы и шухлядки». Лучший фон это `
        + 'фон, которого почти не видно');
    }
  });
  auditText('REAL_BG', REAL_BG);
  auditText('IPHONE', IPHONE);
  for (let r = 0; r < PLACES.length; r++) {
    const { loc3, loc4 } = pickPlaces(r);
    if (loc3 === loc4) throw new Error(`promptkit: при роторе ${r} локации кадров 3 и 4 совпали, а они обязаны отличаться`);
  }

  // ═══ НОВЫЕ ПУЛЫ ФОНОВ ═══════════════════════════════════════════════════════════════════════
  // Правила ниже проверяются ЧИСЛОМ и СТРОКОЙ, а не аккуратностью автора, потому что каждое из
  // них уже стоило нам оплаченных кадров: запрещённый предмет в локации, открыточный вид на
  // брендовом кадре, разбухший промпт, в котором тонет требование сохранить человека.
  for (const [name, pool] of [['CITY_PLACES', CITY_PLACES], ['QUIET_PLACES', QUIET_PLACES]]) {
    pool.forEach((pl, i) => {
      auditText(`${name}[${i}]`, pl);
      // Локация не имеет права называть то, что запрещено блоком BAN_PARTS: телефон, гаджеты,
      // зеркало и отражения в стекле. Иначе промпт спорит сам с собой (см. шапку QUIET_PLACES).
      if (/телефон|гаджет|смартфон|ноутбук|планшет/i.test(pl)) {
        throw new Error(`promptkit: локация «${pl}» называет гаджет, а гаджеты запрещены в кадре`);
      }
      if (/зеркал|отражени\w*\s+(в\s+)?(стекл|витрин)/i.test(pl)) {
        throw new Error(`promptkit: локация «${pl}» называет зеркало или отражение в стекле, а они запрещены в кадре`);
      }
    });
  }
  // Пулы не пересекаются: на этом держится «локации кадров 3 и 4 разные» без сдвигов и проверок.
  for (const pl of CITY_PLACES) {
    if (QUIET_PLACES.includes(pl)) throw new Error(`promptkit: локация «${pl}» лежит в обоих пулах, кадры 3 и 4 могут совпасть`);
  }
  // ОТКРЫТОЧНЫЕ ВИДЫ НА ЧЕТВЁРТОМ КАДРЕ ЗАПРЕЩЕНЫ (прямой запрет начальника: «условно Красная
  // площадь для него не нужна»). На четвёртом кадре стоит фирменная плашка, и достопримечательность
  // за спиной перетягивает и её, и лицо.
  // КАДР 4 ТОЛЬКО ДОМА, И ЭТО ПРОВЕРЯЕТСЯ СТРОКОЙ (09.08 ночью). Приказ начальника дословно: «должно
  // быть домашнее фото, где она сама себя фоткает», и отдельно про трамвай: «не используй трамваи,
  // они никогда не реалистичны». Файл локаций ведёт другой агент, и словами в шапке файла тут не
  // отделаться: под старым именем класса «тихая» в кадр 4 уже попадали такси, трамвай, лифт, кафе,
  // подъезд и двор, и оба раза начальник браковал именно кадр 4. Поэтому: домашняя комната обязана
  // быть НАЗВАНА, а выездные места и интерьеры транспорта запрещены прямым перечислением.
  // СПИСОК ДОМАШНИХ СЛОВ РАСШИРЕН 11.08 под пополнение пула кадра 4 (гостиная, подоконник, стол с
  // ноутбуком, кресло у окна и прочие домашние точки). Смысл проверки тот же: домашнее место обязано
  // быть НАЗВАНО словом, а не подразумеваться.
  // СЛОВО «ВАНН» ИЗ НЕГО УБРАНО И ПЕРЕЕХАЛО В ЗАПРЕТ НИЖЕ (приказ по посту нов61: «4 фото в
  // обоссанной ванне, убери некрасивые ванны из списка фонов»).
  const HOME_WORDS = /комнат|кухн|прихож|балкон|коридор|спальн|гостин|подоконник|кресл|диван|стол|кроват|окн/i;
  const AWAY_WORDS = /трамва|автобус|вагон|метро|лифт|такси|машин|кафе|ресторан|подъезд|двор|улиц|магазин|офис|аудитори/i;
  // ВАННАЯ, ДУШЕВАЯ И САНУЗЕЛ ЗАПРЕЩЕНЫ НА КАДРЕ 4 (11.08, пост нов61). Проверка стоит рядом с
  // выездными местами по той же причине: файл локаций ведёт другой агент, и обещания в его шапке
  // кадр 4 не защищают. Двумя словами про причину: «жилая» ванная это следы воды и затирка, то есть
  // грязь, а «чистая» это каталог из журнала. Ни то ни другое нам не годится.
  const BATH_WORDS = /ванн|душев|санузел|туалет|раковин|унитаз/i;
  for (const l of LOC.quiet) {
    if (!HOME_WORDS.test(l.place)) {
      throw new Error(`promptkit: локация кадра 4 «${l.slug}» не называет домашнюю комнату («${l.place}»), `
        + 'а кадр 4 обязан быть домашним селфи: комната, спальня, кухня, прихожая, коридор, балкон');
    }
    if (AWAY_WORDS.test(l.place)) {
      throw new Error(`promptkit: локация кадра 4 «${l.slug}» это выездное место или салон транспорта `
        + '(«' + l.place + '»). Начальник забраковал такие кадры 4 дважды, а трамвай запрещён насовсем');
    }
    if (BATH_WORDS.test(l.place)) {
      throw new Error(`promptkit: локация кадра 4 «${l.slug}» это ванная или санузел («${l.place}»), `
        + 'а они запрещены прямым приказом по посту нов61: «убери некрасивые ванны из списка фонов». '
        + 'Поставь ей класс «выключена» с причиной, а в кадр 4 возьми жилую комнату');
    }
  }
  const POSTCARD = /красная площадь|кремл|собор|храм|василия блаженного|большой театр|гум|зарядье|москва-сити|воробьёв|достопримечательн/i;
  QUIET_PLACES.forEach((pl, i) => {
    if (POSTCARD.test(pl)) throw new Error(`promptkit: QUIET_PLACES[${i}] это открыточный вид «${pl}», а четвёртый кадр фоном не перегружаем`);
  });
  // А вот кадр 3 наоборот обязан быть узнаваемым городом: пул, в котором нет ни одного приметного
  // места, превращает заставку в очередной домашний кадр.
  // СЛОВО «МЕТРО» ИЗ ЭТОЙ ПРОВЕРКИ УБРАНО 11.08: метро у нас запрещено, а признак узнаваемости города
  // держат Москва-Сити, центр, панорама и набережная.
  if (!CITY_PLACES.some((pl) => /москва-сити|центр|панорама города|набережн/i.test(pl))) {
    throw new Error('promptkit: в CITY_PLACES нет ни одного узнаваемого городского места, заставки не будет');
  }
  // ═══ РАСПРЕДЕЛЕНИЕ ЛОКАЦИЙ КАДРА 3 (11.08, приказ после отчёта отдела качества) ═════════════
  // Отдел качества посчитал по 30 живым постам: кадр 3 в 47 процентах постов это Москва-Сити, а
  // транспорт есть в 37 процентах. Оба числа это про ВЫБОРКУ, а не про отдельный промпт, поэтому и
  // проверяются выборкой: гоняем ротор на 50 постов вперёд и смотрим, что получилось.
  // ВЫБОРКУ ГОНЯЕМ ПО КАЖДОМУ ТИРУ ОТДЕЛЬНО (11.08, после привязки Дубая и Питера). Пул у тиров
  // разный, значит и доля локации в ленте у них разная: проверка по одному тиру ничего не говорит про
  // другой, а именно люкс-пул самый маленький, и в нём доля вылезает первой.
  for (const [tierAudit, ordersAudit] of Object.entries(ORDER_BY_TIER)) {
    const ORDER3 = ordersAudit.city;
    const N = 50;
    const счёт = new Map(), поГруппам = new Map();
    let рядом = 0;
    let прошлаяГруппа = null;
    for (let r = 0; r < N; r++) {
      const p = pickCityPlaces(r, { tier: tierAudit });
      счёт.set(p.slug3, (счёт.get(p.slug3) || 0) + 1);
      const l = ORDER3.find((x) => x.slug === p.slug3);
      const g = группаЛокации(l);
      поГруппам.set(g, (поГруппам.get(g) || 0) + 1);
      if (g === прошлаяГруппа) рядом++;
      прошлаяГруппа = g;
      // Транспорта в выборке быть не может вовсе: и локация, и свет уже прошли гейт на выборе.
      if (transportHits(`${p.loc3} ${p.light3}`).length || transportHits(`${p.loc4} ${p.light4}`).length) {
        throw new Error(`promptkit: в выборке из ${N} постов ротор ${r} отдал локацию с транспортом`);
      }
    }
    // ДОЛЯ ОДНОЙ ЛОКАЦИИ НЕ ВЫШЕ 15 ПРОЦЕНТОВ (прямое требование приказа). При ровном обходе это
    // 1/N пула, то есть требование это ещё и нижняя граница размера пула: меньше семи заставок
    // держать нельзя, иначе одна локация занимает больше 15 процентов ленты.
    for (const [slug, n] of счёт) {
      if (n / N > 0.15 + 1e-9) {
        throw new Error(`promptkit: локация «${slug}» занимает ${(n / N * 100).toFixed(0)}% выборки из `
          + `${N} постов, а больше 15% одной локации нельзя (приказ 11.08). В пуле заставок сейчас `
          + `${ORDER3.length}: пополни пул, чтобы доля упала`);
      }
    }
    // ДВЕ ЛОКАЦИИ ОДНОЙ ГРУППЫ ПОДРЯД сравниваем не с круглым числом, а с ТЕОРЕТИЧЕСКИМ МИНИМУМОМ,
    // и вот почему. Если самая большая группа занимает больше половины пула (у нас Москва-Сити это
    // семь локаций из одиннадцати), то развести её без повторов НЕВОЗМОЖНО ни при каком порядке: на
    // каждом круге останется как минимум 2m − n мест, где Сити встаёт рядом с Сити. Круглый порог
    // тут врал бы в обе стороны: на нынешнем составе он ругался бы на исправный код, а на пополненном
    // пуле пропускал бы настоящую поломку разведения. Поэтому считаем минимум и даём запас в один
    // стык на круг (стык на переходе через конец круга).
    const самаяБольшая = Math.max(...[...поГруппам.values()]);
    const мГруппы = Math.max(...(() => {
      const c = new Map();
      for (const l of ORDER3) { const g = группаЛокации(l); c.set(g, (c.get(g) || 0) + 1); }
      return [...c.values()];
    })());
    const минимумНаКруг = Math.max(0, 2 * мГруппы - ORDER3.length);
    const кругов = Math.ceil(N / ORDER3.length);
    const порог = кругов * (минимумНаКруг + 1);
    if (рядом > порог) {
      throw new Error(`promptkit: в выборке из ${N} постов ${рядом} раз подряд идёт одна группа локаций, `
        + `а теоретический предел при этом составе пула ${порог} (самая большая группа ${мГруппы} из `
        + `${ORDER3.length}). Значит разведение по группам сломано, смотри развестиПоГруппам`);
    }
    if (verbose) {
      const доля = (n) => `${(n / N * 100).toFixed(0)}%`;
      console.log(`promptkit: тир «${tierAudit}» (${TIERS[tierAudit]}), выборка ${N} постов, заставок в пуле ${ORDER3.length}, `
        + `самая частая локация ${доля(Math.max(...счёт.values()))}, самая частая группа `
        + `${доля(самаяБольшая)}, стыков одной группы ${рядом} при пределе ${порог}`);
    }
  }

  // ═══ ПУЛ ИЗ ФАЙЛА: ПРОВЕРЯЕМ ВСЁ, ЧТО УЕДЕТ В ЗАКАЗ ════════════════════════════════════════
  // Файл чужой (его ведёт агент по локациям), значит доверять ему нельзя тем сильнее. Проверяем не
  // только строку места, но и строку СВЕТА: с 09.08 вечера она тоже попадает в промпт, и запрещённое
  // слово в ней сработает точно так же, как в самой локации.
  for (const [cls, pool] of [['заставка', LOC.city], ['дома', LOC.quiet]]) {
    for (const l of pool) {
      auditText(`локация.${l.slug}.промпт`, l.place);
      if (l.light) auditText(`локация.${l.slug}.свет`, l.light);
      const both = `${l.place} ${l.light}`;
      if (/телефон|гаджет|смартфон|ноутбук|планшет/i.test(both)) {
        throw new Error(`promptkit: локация «${l.slug}» (${cls}) называет гаджет, а гаджеты запрещены блоком BAN_PARTS`);
      }
      if (/зеркал|отражени\w*\s+(в\s+)?(стекл|витрин)/i.test(both)) {
        throw new Error(`promptkit: локация «${l.slug}» (${cls}) называет зеркало или отражение в стекле, они запрещены в кадре`);
      }
    }
  }
  // ═══ ОГОЛЁННОСТЬ: СЛОВА ЖИВУТ ТОЛЬКО В ЗАПРЕТАХ (11.08, приказ «настолько это перебор») ══════
  // Проверяется двумя сторонами, как жёлтый свет и мебель:
  //   1) в ЗАПРЕТАХ перечисление обязано быть (его потребовал начальник прямо);
  //   2) ни в одном ПОЛОЖИТЕЛЬНОМ блоке (подача, вызов, замысел образа, изменения, одежда) слов
  //      оголённости быть не может: там они читаются как заказ, а не как запрет.
  // Слова «рот приоткрыт» в списке НЕТ намеренно: так описано УДИВЛЕНИЕ на кадре результата (приказ
  // про «ваууу блииннн»), и запрет тут срубил бы исправный блок. Запрещён приём соблазна, а он назван
  // в запретах словами «мокрые губы».
  const ОГОЛЁННОСТЬ = /глубокий вырез|оголён|обнажён|нижнее бель|топлес|прогиб|мокрые губы|акцент на тел|короткий верх|голый живот|декольте/i;
  {
    for (const need of ['глубокий вырез', 'короткий верх', 'оголённое тело', 'бельё']) {
      if (!BAN_PARTS.bare.includes(need)) {
        throw new Error(`promptkit: из запретов исчезло «${need}». Начальник потребовал назвать `
          + 'оголённость прямо (приказ 11.08), потому что за откровенный кадр режут охват и '
          + 'ограничивают аккаунт, а это деньги, а не вкус');
      }
    }
    // DARE обязан держать положительное определение вызова: без него слово «вызывающе» из головы
    // заказчика вернётся к модели в её собственном понимании, то есть в оголённость.
    for (const need of ['ПРЯМО В КАМЕРУ', 'БЕЗ УЛЫБКИ', 'Подбородок поднят']) {
      if (!DARE.includes(need)) throw new Error(`promptkit: из блока вызова исчезло «${need}»`);
    }
    const положительные = { APPEAL, DARE, TYPAGE, GEOM, SELFIE, EMOTION, HUMAN,
      mustChange: mustChangeBlock('dark', 0, 0, 'свитер оверсайз'), ...LOOK_INTENT };
    for (const [имя, текст] of Object.entries(положительные)) {
      // «БЕЗ ОГОЛЁННОСТИ» это наша правильная формулировка (так открывается блок вызова), поэтому
      // отрицание снимаем перед поиском: иначе гейт срубает сам заголовок требования.
      const м = String(текст).replace(/без оголённости/i, '').match(ОГОЛЁННОСТЬ);
      if (м) {
