/**
 * Значение из карты, ключованной по СЕМЬЕ шаблона (family из templates.cjs).
 * Почему не textPool: тот ищет по НАЗВАНИЯМ шаблонов, а наши карты ключуются по семьям, чтобы
 * старый и новый шаблон одного тренда (img-heart-hair и hearts-trend) получали одно значение
 * автоматически. При ключах-семьях textPool всегда падал бы в '*', что и поймал аудит.
 */
function byFamily(map, template) {
  const fam = TPL.get(template).family;
  return (fam && map[fam]) || map['*'];
}

/** Белый список надписей карточки. Для некарточных шаблонов пустой массив: надписей нет вовсе. */
function cardTextWhitelist(template) {
  if (!TPL.isCard(template)) return [];
  return byFamily(CARD_WHITELIST, template);
}

/** Строка про надписи: либо белый список для карточки, либо полный запрет для кадра-образа. */
function textRule(template, { card = false } = {}) {
  if (!card) {
    // «Текст наносим мы сами» убрано 11.08 под бюджет длины: это пояснение ДЛЯ НАС (правило
    // начальника «надписи только рендером»), модели оно ничего не запрещает, а сам запрет стоит
    // прописными и дословно, как его и проверяет аудит. Освободилось 23 знака в каждом промпте.
    return 'НАДПИСЕЙ НА КАДРЕ НЕТ.';
  }
  const wl = cardTextWhitelist(template);
  return 'НАДПИСИ НА КАРТОЧКЕ ТОЛЬКО РУССКИЕ и только по смыслу разбора. Разрешённые подписи и '
    + 'заголовки: ' + wl.join(', ') + '. Ничего кроме них не писать: ни английских заголовков, '
    + 'ни выдуманных названий брендов, ни случайных букв и символов. Орфография правильная.';
}

