// на карточке быть не должно.
const CARD_WHITELIST = {
  'beauty-guide': ['разбор', 'внешность', 'форма лица', 'глаза', 'брови', 'губы', 'кожа', 'волосы',
    'стиль', 'что идёт', 'что не идёт', 'рекомендации', 'до', 'после'],
  'face-report': ['оценка', 'внешность', 'из 10', 'симметрия', 'кожа', 'глаза', 'губы', 'нос',
    'брови', 'итог', 'сильные стороны'],
  'makeup-colortype': ['цветотип', 'палитра', 'тон', 'румяна', 'тени', 'помада', 'твои цвета',
