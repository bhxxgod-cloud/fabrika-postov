// на набережной и пальто на своей кухне это брак «не реально выходит», за который уже прилетало.
// Поэтому пул выбирается по РЕЖИМУ ФОНА, тем же, которым выбирается блок фона.
// ЧЕГО В ПУЛАХ НЕТ: вечерней одежды, блёсток, корсетов, кожи, «глянца» и всего, что читается как
// реклама или как взрослая съёмка. Причины те же, по которым их нет в APPEAL: фильтр безопасности
// RenderGrid отклоняет заказ целиком, если рядом стоят подросток и откровенность, а глянец возвращает
// нам кадр «коммерция», забракованный начальником. Одежда закрытая, это сказано в самом блоке.
const CLOTHES = {
  // «ДЖИНСОВКА И ТОП» ЗАМЕНЕНА НА ФУТБОЛКУ (11.08, приказ про перебор с оголённостью). Слово «топ»
  // модель читает как кроп-топ, а короткий верх теперь прямо запрещён (BAN_PARTS.bare). Пул не мой,
  // но правка ровно по приказу и на один предмет: остальные четыре строки не тронуты.
  city: ['свитер оверсайз', 'рубашка навыпуск', 'пальто и футболка', 'джинсовка и футболка', 'худи и куртка'],
  home: ['домашняя футболка', 'худи', 'майка и рубашка', 'спортивный костюм', 'свитер крупной вязки'],
};
// Режим фона quiet это домашний кадр 4, режим home старый домашний пул: одежда у обоих домашняя.
const CLOTHES_POOL = { city: 'city', quiet: 'home', home: 'home' };

/**
 * Одежда для кадра. Раздача ТА ЖЕ, что у поз: по семени поста, со сдвигом индекса для кадра 4,
 * поэтому кадры 3 и 4 не могут совпасть по построению даже когда оба берут один пул (это бывает:
 * PLACE_POOL=home ставит домашний фон обоим кадрам).
 * СЕМЯ ТО ЖЕ, ЧТО У ПОЗЫ, НО СОЛЬ ДРУГАЯ: с одинаковым семенем и одинаковой длиной пулов одежда
 * повторяла бы позу один в один (поза A всегда со свитером), и мы получили бы пять пар вместо
 * двадцати пяти.
 * @param {string} seed семя поста (у onepost это sha256 исходника)
 * @param {3|4} step номер кадра
 * @param {'city'|'quiet'|'home'} bgMode режим фона этого кадра
 * @returns {string} название одежды из пула
 */
function clothesFor(seed, step = 3, bgMode = 'home') {
  const имя = CLOTHES_POOL[bgMode];
  if (!имя) throw new Error(`promptkit: неизвестный режим фона «${bgMode}» для выбора одежды`);
  const пул = CLOTHES[имя];
  const h = seedNum(`одежда|${seed}`);
  const i3 = h % пул.length;
  if (Number(step) === 3) return пул[i3];
  const сдвиг = 1 + (seedNum(`одежда|${seed}|4`) % (пул.length - 1));
  return пул[(i3 + сдвиг) % пул.length];
}

/** Блок «что обязано измениться». Цвет волос тут первым пунктом, и это осознанно. */
function mustChangeBlock(srcHair = 'auto', idx = 0, lenIdx = 0, clothes = '') {
