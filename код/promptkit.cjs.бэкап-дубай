    // именно поэтому, и волосы после этого стали слушаться. Первый пост по новой логике показал, что
    // в этой самой сильной позиции не хватает второго требования: кадры вышли с нужной геометрией,
    // нужным типажом и нужным цветом волос, но с ДРУГИМ лицом. Теперь в конце стоят оба требования,
    // и лицо стоит первым: цвет волос модель и так исполняет, а личность это то, что теряется.
    hairAim
      ? hairRetryLine(hairAim)
      : `ГЛАВНОЕ: лицо ровно с приложенного фото, а цвет волос новый, ${hairTarget(srcHair, hairIdx)}.`,
  ].filter(Boolean).join(' ');
  // ГЕЙТ СТОИТ НА ВЫХОДЕ, А НЕ НА ВХОДЕ, И ЭТО ВАЖНО. Локация приезжает сюда не только из пула: её
  // передают строкой (place, scene) соседние сборщики, и проверять надо ИТОГОВЫЙ текст, который
  // уедет в оплаченный заказ. Проверка стоит после сборки ещё и потому, что транспорт может влезть
  // не только локацией, но и описанием света или замыслом шаблона.
  // СТРОКА ПОЗЫ УСТУПАЕТ ДЛИНЕ, А НЕ НАОБОРОТ (правка 11.08). Поза это разнообразие карусели, а
  // порог 3200 знаков это предохранитель личности, и когда они не помещаются вместе, уступать обязана
  // поза. Локации и свет к ним правит другой агент в своём файле, и разница в пару десятков знаков
  // там это обычное дело, а падать на оплаченном заказе или на загрузке фабрики из-за красивой позы
  // нельзя. Снятие НЕ тихое: пишем в лог, иначе через месяц никто не поймёт, почему позы разошлись
  // на одних локациях и совпали на других (тихо выброшенный параметр это самый дорогой баг проекта).
  const поза = poseSeed ? poseTweak(poseSeed, step) : '';
  if (поза && готовый.length > 3200) {
    const без = готовый.replace(` ${поза}`, '');
    // СНАЧАЛА ПРОБУЕМ ПОЗУ КОРОЧЕ, И ТОЛЬКО ПОТОМ СНИМАЕМ СОВСЕМ. Замер по всем локациям: с самой
    // длинной строкой пула промпт не влезает в 20 случаях из 774, и все двадцать это КАДР 4 на
    // шести домашних локациях (своя комната, прихожая, балкон, стол с косметикой, кухня). Снять там
    // позу целиком значит вернуть ровно ту болезнь, из-за которой правка и делалась: кадр 4 опять
    // повторит позу исходника. Короткая строка из того же пула в эти 20 случаев влезает.
    // Позу ДРУГОГО кадра этого поста исключаем: разойтись кадры 3 и 4 обязаны и здесь.
    const чужая = poseTweak(poseSeed, Number(step) === 3 ? 4 : 3);
    const короче = POSE_MIX.filter((s) => s !== поза && s !== чужая)
      .sort((a, b) => a.length - b.length)
      .find((s) => без.length + 1 + s.length <= 3200);
    if (короче) {
      console.log(`  ⚠ promptkit: поза «${поза}» не влезла в кадр ${step} (${готовый.length} знаков при `
        + `пороге 3200), беру короткую из того же пула: «${короче}»`);
      const i = без.lastIndexOf('ГЛАВНОЕ:');
      return assertNoTransport(`lookPrompt.${template}.кадр${step}`,
        `${без.slice(0, i)}${короче} ${без.slice(i)}`);
    }
    console.log(`  ⚠ promptkit: ни одна строка позы не влезла в кадр ${step} (без позы ${без.length} `
      + 'знаков при пороге 3200): кадр пойдёт без разведения позы, локация слишком длинная');
    return assertNoTransport(`lookPrompt.${template}.кадр${step}`, без);
  }
  return assertNoTransport(`lookPrompt.${template}.кадр${step}`, готовый);
}

