};
// Семьи шаблонов, где часть запретов снимается по замыслу. Каждое исключение отдельной строкой
// и с причиной: молчаливое исключение через месяц читается как баг.
const HANDS_OK = new Set([
  'bw-fingers',      // весь тренд про пальцы у лица, руки тут это сам шаблон
]);

/** Строка запретов под конкретный шаблон. Снимаем ровно те запреты, что противоречат замыслу. */
function banBlock(template) {
  const drop = new Set();
  // ЗДЕСЬ БЫЛО СНЯТИЕ ЗАПРЕТА «руки у лица» для семьи bw-fingers. Оно ушло вместе с самим запретом
  // (см. BAN_PARTS: запрет спорил с замеренным пулом поз). Набор HANDS_OK остался и НУЖЕН: по нему
  // lookPrompt решает, ставить ли блок SELFIE, а он говорит «руки в кадре нет» и трендам про пальцы
  // у лица противоречит по-настоящему.
  // У шаблонов, где студия и есть замысел (обложка журнала, чб редакционный портрет, «твой лучший
  // размер»), запрет студии снимаем: иначе промпт спорит сам с собой. Признак берём из контракта
  // (studioLook), а не по названию шаблона.
  // У студийных по замыслу шаблонов снимаем ещё и запрет съёмки со стороны: обложка журнала и чб
  // редакционный портрет это ПО ЗАМЫСЛУ работа фотографа, и селфи там было бы браком. Ровно поэтому
  // же им не ставится блок SELFIE (см. lookPrompt).
  if (TPL.isStudioLook(template)) { drop.add('studio'); drop.add('catalog'); drop.add('outside'); }
  const items = Object.entries(BAN_PARTS).filter(([k]) => !drop.has(k)).map(([, v]) => v);
  let s = 'ЗАПРЕЩЕНО В КАДРЕ: ' + items.join(', ') + '.';
  if (drop.has('hands')) {
    s += ' Руки разрешены только как замысел шаблона (пальцы у лица), предметов в них нет.';
  }
  return s;
}

// ═══ 4б. ГЕЙТ ТРАНСПОРТА: ЗАКАЗ С МЕТРО НЕ УХОДИТ ВООБЩЕ ════════════════════════════════════
// ЗАЧЕМ ГЕЙТ, ЕСЛИ ЛОКАЦИИ УЖЕ ВЫЧИЩЕНЫ. Потому что вычищенный список это обещание, а гейт это
// проверка. Начальник забраковал пост нов49 («некрасивое метро, модные девочки не ездят в метро в
// рф») в тот момент, когда транспорт формально считался выключенным, и разбор показал ТРИ разных
// пути, по которым метро всё равно доезжало до оплаченного заказа:
//   1) три живые локации в пуле кадра 3 (платформа, эскалатор, станция) стояли классом «заставка»,
//      то есть выключены НЕ были, хотя в шапке файла локаций написано, что транспорт выключен;
//   2) слово «метро» стояло в самом запрете BAN_PARTS.transport, то есть уезжало в каждый промпт;
//   3) локацию можно передать в lookPrompt строкой мимо всякого пула (параметры place и scene), и
//      так делают соседние сборщики: onepost, fix4, refit4, addframe4.
// Первые два пути закрыты правкой списков, а третий словами не закрывается никогда: любой агент,
// который завтра допишет свою локацию строкой, обойдёт любой список. Поэтому проверка стоит НА
// ВЫХОДЕ, в самих сборщиках промптов: собранный промпт прогоняется по чёрному списку, и при
// совпадении промпт не возвращается, а бросается ошибка. Заказ не уходит, деньги не списываются.
//
// ЧЕГО В ЧЁРНОМ СПИСКЕ НЕТ И ПОЧЕМУ. Слов «транспорт», «кабина», «сиденье» здесь нет намеренно:
// ими описан САМ ЗАПРЕТ (BAN_PARTS.transport), а гейт смотрит промпт целиком, вместе с блоком
// запретов. Занеси сюда слово из своего же запрета, и гейт начнёт рубить каждый промпт. Поэтому
// в списке только НАЗВАНИЯ конкретного транспорта и его мест, а запрет говорит классом.
//
// ПРО ПАДЕЖИ И ПРО \b (грабля проекта, записана в памяти). В JS \b работает по латинице и цифрам,
// после кириллицы его нет: /\bметро\b/ не найдёт «в метро», зато /\bметро/ найдёт «километро».
// Поэтому левую границу слова ставим сами классом [^а-яёa-z], а хвост слова добираем [а-яё]*, и
// падежи с производными («в метро», «метрополитен», «у эскалатора», «на эскалаторах») ловятся
// одним корнем. Для слов, у которых есть НАШ, разрешённый омоним, стоит поле «кроме».
const TRANSPORT_BAN = [
  { корень: 'метро', зачем: 'прямой запрет начальника по посту нов49' },
  { корень: 'подземк', зачем: 'то же метро другим словом' },
  { корень: 'эскалатор', зачем: 'тоннель эскалатора это метро, он же тянет кадр в подземку' },
  { корень: 'трамва', зачем: '«не используй трамваи, они никогда не реалистичны»' },
  { корень: 'троллейбус', зачем: 'тот же салон с поручнями' },
  { корень: 'автобус', зачем: 'тот же салон с поручнями' },
  { корень: 'маршрутк', зачем: 'тот же салон, ещё и теснее' },
  { корень: 'электричк', зачем: 'вагон с рядами сидений, модель разваливается' },
  { корень: 'вагон', зачем: 'вагон это ряды окон и поручней, читается как ИИ' },
  { корень: 'такси', зачем: 'выключено 11.08: тёмный салон машины модель рисует как ИИ' },
  { корень: 'автомобил', зачем: 'салон машины это та же тесная кабина' },
  { корень: 'пассажирск', зачем: '«на пассажирском сиденье» это салон машины' },
  { корень: 'перрон', зачем: 'платформа станции' },
  { корень: 'турникет', зачем: 'турникеты стоят в метро и в лобби бизнес-центра' },
  // «Лифтинг» это разрешённое слово из бьюти-словаря (подтягивающий уход), и путать его с лифтом
  // нельзя: иначе гейт срубит нормальный промпт про уход за кожей.
  { корень: 'лифт', кроме: /^лифтинг/i, зачем: 'тесная кабина лифта выключена по браку' },
];

/**
 * Найденные в тексте слова транспорта. Отдельно от проверки, чтобы можно было и посмотреть, и
 * проверить, и написать тест, не ловя исключение.
 * @param {string} text любой текст: промпт, строка локации, описание света
 * @returns {string[]} найденные слова как они стоят в тексте, в нижнем регистре, без повторов
 */
function transportHits(text) {
  const s = String(text || '');
  const out = [];
  for (const { корень, кроме } of TRANSPORT_BAN) {
    // Левая граница слова руками ([^а-яёa-z]), потому что \b после кириллицы не работает.
    const re = new RegExp(`(?:^|[^а-яёa-z])(${корень}[а-яё]*)`, 'gi');
    let m;
    while ((m = re.exec(s))) {
      const слово = m[1];
      if (кроме && кроме.test(слово)) continue;
      out.push(слово.toLowerCase());
    }
  }
  return [...new Set(out)];
}

/**
 * ГЕЙТ. Роняем сборку промпта, а не «чистим» текст молча: молчаливая чистка оставила бы кадр без
 * локации вовсе, а без локации модель рисует салон красоты (это уже проверено на живых заказах).
 * @param {string} что имя промпта для лога: по нему видно, какой сборщик принёс транспорт
 * @param {string} text собранный промпт
 * @returns {string} тот же текст, если он чист
 */
function assertNoTransport(что, text) {
  const hits = transportHits(text);
  if (hits.length) {
    throw new Error(`promptkit: ГЕЙТ ТРАНСПОРТА не пустил заказ «${что}»: в промпте стоят слова `
      + hits.map((w) => `«${w}»`).join(', ')
      + '. Метро, трамвай, автобус, такси и лифт запрещены прямым приказом начальника по посту нов49 '
      + '(«некрасивое метро, модные девочки не ездят в метро в рф»), а тесные салоны модель рисует '
      + 'как ИИ. Заказ НЕ отправлен, деньги не списаны. Замени локацию на место из пула '
      + '(pickCityPlaces или nextQuietPlace) и собери промпт заново.');
  }
  return text;
}

