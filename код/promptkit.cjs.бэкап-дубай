// tmp_blast6.cjs, где по этому же полю посты ищутся в базе). Поэтому тир не новая сущность, а
// чтение существующего поля: postTier({lux:true}) это 'lux', всё остальное 'plain'.
// ПОЧЕМУ ПО УМОЛЧАНИЮ «ОБЫЧНАЯ». Потому что цена ошибок разная. Обычная девочка на фоне Питера это
// ровно то, что заказано; ультра дорогая девочка на фоне Питера это просто не самый выигрышный фон.
// А вот Дубай под обычной девочкой это ложь в ленте, за которую бракуют пост. Значит молчание
// вызывающего обязано читаться как «обычная», и Дубай уходит только там, где дорогой образ НАЗВАН.
// КАК ЕГО НАЗВАТЬ, ЕСЛИ СБОРЩИК ПРАВИТЬ НЕЛЬЗЯ. Два входа, оба явные: параметр (tier или lux) у
// pickCityPlaces и переменная окружения POST_TIER=lux. Второй вход нужен, потому что onepost.cjs
// сейчас держит другой агент, и трогать его я не имею права: люкс-пачка запускается с POST_TIER=lux
// и получает Дубай без единой правки в сборщике.
const TIERS = { lux: 'дорогая', plain: 'обычная' };
const TIER_ANY = 'любая';

/**
 * Тир поста: 'lux' для ультра дорогого образа, 'plain' для обычного.
 * @param {object} [o]
 * @param {boolean} [o.lux] метка люкс-поста (ровно то поле, что уже лежит в meta.lux)
 * @param {'lux'|'plain'} [o.tier] прямое указание тира, сильнее метки lux
 * @returns {'lux'|'plain'}
 */
function postTier({ lux = false, tier = '' } = {}) {
  const явный = String(tier || '').trim().toLowerCase();
  if (явный) {
    if (!TIERS[явный]) {
      throw new Error(`promptkit: неизвестный тир образа «${tier}», знаю ровно два: ${Object.keys(TIERS).join(', ')} `
        + '(lux это ультра дорогая девочка и Дубай, plain это обычная и Питер)');
    }
    return явный;
  }
  if (lux) return 'lux';
  const изСреды = String(process.env.POST_TIER || '').trim().toLowerCase();
  if (изСреды) {
    if (!TIERS[изСреды]) {
      throw new Error(`promptkit: в окружении POST_TIER=«${process.env.POST_TIER}», а тир бывает только `
        + Object.keys(TIERS).join(' или '));
    }
    return изСреды;
  }
  return 'plain';
}

/**
 * Годится ли локация этому тиру. Локация «любая» годится всем, «дорогая» только люксу, «обычная»
 * только обычным. Молчание в файле это «любая»: весь московский пул так и читается, поэтому
 * старое поведение не меняется ни на один кадр.
 */
function локацияПодТир(l, tier) {
  if (l.tier === TIER_ANY) return true;
  // ДОРОГИЕ ЛОКАЦИИ ИДУТ ВСЕМ (15.08, приказ владельца: «люкс пометку юзаем для всех»; неделю
  // спрашивал «где Дубай», а его было 0 из 360 обложек, потому что ни один вызывающий тир не
  // передавал и по умолчанию все девочки были «обычные»). Дубай теперь у любой девочки, Питер
  // остаётся только у обычной, как и был.
  if (l.tier === TIERS.lux) return true;
  return l.tier === TIERS[tier];
}

/**
 * Пулы локаций из файлов. Разбираем СТРОГО: битая или неполная запись роняет модуль на загрузке, а
 * не подставляет заглушку. Локация это то, что уезжает в оплаченный заказ, поэтому «как-нибудь»
 * тут дороже, чем падение.
 * @returns {{city:object[], quiet:object[]}} записи вида {slug, name, place, light, group, tier, file}
 */
function loadLocations() {
  const rows = [];
  const ВЫКЛЮЧЕНО = new Map();
  for (const файл of [LOC_FILE, LOC_FILE_EXTRA]) {
    // Второй файл может ещё не существовать у того, кто выкатил только промпткит: это НЕ авария,
    // это просто пул без Дубая и Питера. А вот битый json это авария, и она роняет модуль.
    if (файл === LOC_FILE_EXTRA && !fs.existsSync(файл)) continue;
    let raw;
    try { raw = JSON.parse(fs.readFileSync(файл, 'utf8')); }
    catch (e) { throw new Error(`promptkit: не читается пул локаций ${файл}: ${e.message}`); }
    // Выключения чужих локаций объявляются полем «_выключить» с причиной у каждого слуга.
    for (const [slug, почему] of Object.entries(raw._выключить || {})) {
      if (!String(почему || '').trim()) {
        throw new Error(`promptkit: в ${path.basename(файл)} локация «${slug}» выключена без причины. `
          + 'Молчаливое выключение через месяц читается как баг: напиши в поле «_выключить» причину '
          + 'словами начальника или замером');
      }
      ВЫКЛЮЧЕНО.set(slug, String(почему).trim());
    }
    const свои = Object.entries(raw.locations || {});
    if (!свои.length) throw new Error(`promptkit: в ${файл} нет ни одной локации`);
    for (const [slug, v] of свои) rows.push([slug, v, path.basename(файл)]);
  }
  // Выключение слуга, которого нет ни в одном файле, это опечатка, и она опаснее, чем кажется:
  // агент уверен, что мебельный фон выключен, а он живой и уезжает в заказы.
  const всеСлуги = new Set(rows.map(([slug]) => slug));
  for (const slug of ВЫКЛЮЧЕНО.keys()) {
    if (!всеСлуги.has(slug)) {
      throw new Error(`promptkit: в списке «_выключить» стоит локация «${slug}», которой нет ни в одном `
        + 'файле локаций. Скорее всего опечатка в слуге, и настоящая локация всё ещё уезжает в заказы');
    }
  }
  const видели = new Map();
  const out = { city: [], quiet: [] };
  for (const [slug, v, файл] of rows) {
    if (видели.has(slug)) {
      throw new Error(`promptkit: локация «${slug}» описана дважды: в ${видели.get(slug)} и в ${файл}. `
        + 'Слуг это ключ раздачи и имя в логе, два разных места под одним именем дадут перепутанный '
        + 'свет и потерянный референс. Переименуй одну из них');
    }
    видели.set(slug, файл);
    // ВЫКЛЮЧЕННЫЕ ЛОКАЦИИ ПРОПУСКАЕМ (09.08 ночью). Понадобился третий класс, потому что забракованную
    // по кадрам локацию надо убирать из заказов, но не выбрасывать из файла: за каждой стоят
