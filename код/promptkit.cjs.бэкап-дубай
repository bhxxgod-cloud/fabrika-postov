/** Название целевой длины по индексу. Индекс один и тот же для кадров 3 и 4 одного поста. */
function hairLen(idx = 0) {
  const n = HAIR_LENGTHS.length;
  return HAIR_LENGTHS[(((Number(idx) || 0) % n) + n) % n];
}

/**
 * Индекс длины по хэшу поста. Ровно та же раздача, что у обложек и хештегов: строка (id поста, тег
 * сборки, персона) складывается по кодам символов. Пул длин из семи вариантов, пул цветов из двух,
 * семь и два взаимно простые, поэтому пара «цвет + длина» не повторяется 14 постов подряд.
 * @param {string} seed любая строка, стабильная для поста (id, tag)
 */
function hairLenByHash(seed) {
  const s = String(seed || '');
  if (!s) throw new Error('promptkit: hairLenByHash без ключа поста: длина волос обязана быть стабильной '
    + 'для кадров 3 и 4 одного поста, иначе девочка перестрижётся между кадрами');
  const сумма = Array.from(s).reduce((a, ch) => a + ch.codePointAt(0), 0);
  return сумма % HAIR_LENGTHS.length;
}

// ═══ 2a-2. ОДЕЖДА РАЗНАЯ НА КАЖДОМ КАДРЕ (ПРИКАЗ НАЧАЛЬНИКА 11.08) ══════════════════════════
// ДОСЛОВНО: «2 фото, важно, одна и та же поза, одна и та же одежда… 1) одежда отличается от всех фото
// для всех трендов где есть тело и одежда 2) поза отличается на каждом фото».
// ПОЧЕМУ ОДЕЖДА ПОВТОРЯЛАСЬ. В пункте 4 блока «обязано измениться» стояло общее «ОДЕЖДА: опрятный
// верх», то есть требование БЫТЬ опрятной, а не БЫТЬ ДРУГОЙ. На такой запрос модель одевает девочку в
// то же, что видит на референсе, и оба кадра выходят в одном свитере: карусель читается как одна
// фотография с разным фоном, ровно как это назвал начальник.
