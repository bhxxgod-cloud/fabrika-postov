        throw new Error(`promptkit: в промпте ${t}/4 не сказано, что кадр снят ДОМА`);
      }
      if (p.indexOf(APPEAL) < 0) throw new Error(`promptkit: в промпте ${t}/${st} нет блока подачи, кадр не будет красивее первого`);
      // ПОСЛЕДНЯЯ СТРОКА ОБЯЗАНА ГОВОРИТЬ ПРО ЛИЦО. Это не стилистика: на посте 69e59f0d в самой
      // сильной позиции промпта стоял только цвет волос, и кадры вернулись с другим человеком.
      if (!/ГЛАВНОЕ: лицо ровно с приложенного фото/.test(p)) {
        throw new Error(`promptkit: в промпте ${t}/${st} последняя строка не держит лицо: именно там теряется личность`);
      }
      // ДЛИНА. Порог поднят 2400 → 2900 → 3200, и это третий раз, поэтому надо сказать прямо, чем он
      // обоснован. Правило «чем длиннее промпт, тем слабее держится референс» записано у нас как
      // вывод из провала первой версии на 2800 знаках, но тот провал имел ДРУГУЮ, доказанную причину:
      // референс уходил в несуществующее поле API и до модели не доходил вообще (разбор в шапке
      // rgen.cjs). То есть связь «длина ломает личность» у нас НЕ измерена ни разу, это осторожность.
      // Сегодняшний подъём вынужденный: начальник добавил четыре обязательных блока (типаж,
      // геометрия, подача, свет локации), и уложить их в 2900 можно было только выбросив чей-то
      // приказ. Вместо этого сжаты формулировки (перечисления вместо пояснений, свет локации вместо
      // общих слов про свет), а порог поднят до 3200 с запасом ровно на текущий худший случай.
      // ЧТО ЭТО ЗНАЧИТ НА ПРАКТИКЕ: если на контактном листе поедет ЛИЧНОСТЬ (в кадре другая
      // девушка), первым подозреваемым надо считать именно длину и резать промпт, а не подкручивать
      // формулировки. Порог держим как есть, вверх больше не двигаем без замера.
      if (p.length > 3200) throw new Error(`promptkit: промпт ${t}/${st} разбух до ${p.length} знаков, требование сохранить человека в нём тонет`);
      if (!/МЕСТО:/.test(p)) throw new Error(`promptkit: в промпте ${t}/${st} нет локации, модель нарисует салон`);
      if (!/КАК НА СТАРЫЙ АЙФОН/.test(p)) throw new Error(`promptkit: в промпте ${t}/${st} нет требования качества старого айфона`);
      if (!/салон красоты/.test(p) && !TPL.isStudioLook(t)) throw new Error(`promptkit: в промпте ${t}/${st} нет запрета салона`);
      n++;
    }
    // ГОРОДСКОЙ И ПРИГЛУШЁННЫЙ РЕЖИМЫ ФОНА проверяем на САМОЙ ДЛИННОЙ локации своего пула ВМЕСТЕ С
    // САМЫМ ДЛИННЫМ ОПИСАНИЕМ СВЕТА: именно длина и топит требование сохранить человека. Считать надо
    // худший случай, иначе порог «проходит» на коротких локациях и падает на живом заказе.
    const longest = (pool, f) => pool.slice().sort((a, b) => f(b).length - f(a).length)[0];
    for (const [st, bgMode, pool] of [[3, 'city', LOC.city], [4, 'quiet', LOC.quiet]]) {
      const place = longest(pool, (l) => l.place).place;
      const light = longest(pool, (l) => l.light).light;
      const p = lookPrompt({ template: t, step: st, srcHair: 'dark', hairIdx: 1, place, light, bgMode });
      auditText(`lookPrompt.${t}.${st}.${bgMode}`, p);
      if (p.length > 3200) throw new Error(`promptkit: промпт ${t}/${st} с фоном «${bgMode}» разбух до ${p.length} знаков`);
      if (p.indexOf(BG_MODES[bgMode]) < 0) throw new Error(`promptkit: в промпте ${t}/${st} не встал блок фона «${bgMode}»`);
      if (p.indexOf(REAL_BG) >= 0) throw new Error(`promptkit: в промпте ${t}/${st} остался домашний блок фона вместе с «${bgMode}», они спорят друг с другом`);
      if (!/ЦВЕТ ВОЛОС МЕНЯЕТСЯ/.test(p)) throw new Error(`promptkit: в промпте ${t}/${st}/${bgMode} нет смены цвета волос`);
      if (!/НАДПИСЕЙ НА КАДРЕ НЕТ/.test(p)) throw new Error(`promptkit: в промпте ${t}/${st}/${bgMode} нет запрета надписей`);
      if (p.indexOf('СВЕТ:') < 0) throw new Error(`promptkit: в промпте ${t}/${st}/${bgMode} не встал свет локации`);
      n++;
      // РЕТРАЙ КАДРА 3 проверяем как отдельный промпт: он длиннее обычного (в конце названа цель по
      // цвету прописными буквами), и если бы он выходил за порог, это вылезло бы уже на оплаченном
      // втором заказе, то есть в самый неподходящий момент.
      if (st === 3) {
        const pr = lookPrompt({ template: t, step: st, srcHair: 'dark', hairIdx: 1, place, light, bgMode,
          hairAim: hairTarget('dark', 1) });
        auditText(`lookPrompt.retry.${t}`, pr);
        if (pr.length > 3200) throw new Error(`promptkit: промпт РЕТРАЯ ${t}/3 разбух до ${pr.length} знаков`);
        if (!/ВТОРАЯ ПОПЫТКА/.test(pr)) throw new Error(`promptkit: в промпте ретрая ${t}/3 нет явного указания на вторую попытку`);
        n++;
      }
      // ПРОМПТ СО СТРОКОЙ ПОЗЫ ПРОВЕРЯЕМ ОТДЕЛЬНО И НА САМОЙ ДЛИННОЙ ПОЗЕ ПУЛА. Строка позы съедает
      // почти весь остаток до порога 3200 (худший живой случай около 3130), а локации и свет к ним
      // правит другой агент в своём файле. Если пул или локация подрастут, это обязано вылезти
      // ЗДЕСЬ, на загрузке, а не на оплаченном заказе. Запас требуем не нулевой: ровно в порог это
      // мина под следующую правку локаций.
      if (TPL.isCard(t)) {
        const самаяДлиннаяПоза = longest(POSE_MIX.map((s) => ({ s })), (x) => x.s).s;
        const pp = lookPrompt({ template: t, step: st, srcHair: 'dark', hairIdx: 1, place, light, bgMode,
          poseSeed: 'аудит длины' });
        auditText(`lookPrompt.поза.${t}.${st}`, pp);
        // ЗДЕСЬ СЧИТАЕТСЯ ХУДШИЙ СЛУЧАЙ: самая длинная локация, самый длинный свет, самая длинная
        // поза. Если даже он влезает, поза не снимется НИ НА ОДНОМ живом заказе, и разнообразие
        // карусели гарантировано. Это НЕ падение фабрики: превышение лечится снятием позы в
        // lookPrompt, поэтому здесь только громкая запись в лог, а посты продолжают собираться.
        const сПозой = p.length + самаяДлиннаяПоза.length + 1;
        if (сПозой > 3200) {
          console.log(`  ⚠ promptkit: на самой длинной локации шаблона ${t} кадр ${st} со строкой позы `
            + `даёт ${сПозой} знаков при пороге 3200: на таких локациях поза снимется, и кадры 3 и 4 `
            + `там опять совпадут по позе. Лечится укорочением POSE_MIX (сейчас самая длинная `
            + `${самаяДлиннаяПоза.length} знаков) или самой локации`);
        }
        // Присутствие позы требуем только там, где она в принципе влезает: иначе аудит спорил бы с
        // собственным правилом «поза уступает длине» и падал на самой длинной локации.
        const самаяКороткаяПоза = Math.min(...POSE_MIX.map((s) => s.length));
        if (p.length + 1 + самаяКороткаяПоза <= 3200 && POSE_MIX.every((s) => pp.indexOf(s) < 0)) {
          throw new Error(`promptkit: в промпт ${t}/${st} с семенем позы не встала ни одна строка пула, `
            + `хотя запас по длине есть (${p.length} знаков без позы)`);
        }
        n++;
      } else {
        // У арта и тренда позу разводить ЗАПРЕЩЕНО (причины у lookPrompt), и запрет проверяем, а не
        // подразумеваем: иначе через месяц кто-то передаст сюда семя, промпт молча перевалит порог
        // длины, и разбираться будут уже с браком в ленте.
        let ругнулся = false;
        try { lookPrompt({ template: t, step: st, srcHair: 'dark', hairIdx: 1, place, light, bgMode, poseSeed: 'x' }); }
        catch { ругнулся = true; }
        if (!ругнулся) throw new Error(`promptkit: шаблон ${t} принял семя позы, а не должен: его промпт не имеет запаса по длине`);
        n++;
      }
    }
    // ФИНАЛ АРТ-ШАБЛОНА (09.08). Проверяем ровно то, из-за чего его нельзя делать общим lookPrompt:
    // цвет волос обязан остаться (у арта смена цвета убила бы сам эффект), а кадр обязан быть
    // ДРУГИМ снимком, иначе финал это опять кроп предыдущего кадра.
    if (!TPL.isCard(t)) {
      const ap = artFinalPrompt({ template: t });
      auditText(`artFinalPrompt.${t}`, ap);
      if (/ЦВЕТ ВОЛОС МЕНЯЕТСЯ/.test(ap)) throw new Error(`promptkit: в финале арта ${t} появилась смена цвета волос, она убьёт эффект шаблона`);
      if (!/ТОТ ЖЕ ЦВЕТ И ТА ЖЕ ДЛИНА ВОЛОС/.test(ap)) throw new Error(`promptkit: в финале арта ${t} потерялся замок цвета волос`);
      if (!/ДРУГОЙ СНИМОК ТОЙ ЖЕ СЪЁМКИ/.test(ap)) throw new Error(`promptkit: в финале арта ${t} нет требования другого снимка, финал выйдет дублем`);
      if (!/НАДПИСЕЙ НА КАДРЕ НЕТ/.test(ap)) throw new Error(`promptkit: в финале арта ${t} нет запрета надписей`);
      n++;
    }
    if (TPL.isCard(t)) {
      const wl = cardTextWhitelist(t);
      if (!Array.isArray(wl) || !wl.length) throw new Error(`promptkit: у карточного шаблона ${t} пустой белый список надписей`);
      // У каждого карточного шаблона свой замысел и свой белый список. Падение в общий '*' это
      // не «мягкая деградация», а тихая потеря смысла: ровно так вёл себя первый вариант этого
      // модуля, когда карты по семьям читались функцией, ищущей по названиям шаблонов.
      if (byFamily(LOOK_INTENT, t) === LOOK_INTENT['*']) {
        throw new Error(`promptkit: у карточного шаблона ${t} замысел образа упал в общий, опиши его семью «${TPL.get(t).family}» в LOOK_INTENT`);
      }
      if (wl === CARD_WHITELIST['*']) {
        throw new Error(`promptkit: у карточного шаблона ${t} белый список надписей упал в общий, опиши семью «${TPL.get(t).family}» в CARD_WHITELIST`);
      }
      const cp = cardPrompt({ template: t });
      auditText(`cardPrompt.${t}`, cp);
      n++;
    }
  }
  // ═══ РАЗДАЧА ПОЗ: КАДРЫ 3 И 4 ОБЯЗАНЫ РАЗОЙТИСЬ НА ЛЮБОМ СЕМЕНИ ════════════════════════════
  // Проверяем не «обычно разные», а РОВНО ВСЕ семена из выборки: вся польза правки в том, что два
  // генерируемых кадра поста не повторяют позу друг друга, и один совпавший пост это ровно тот
  // брак, из-за которого начальник и написал «3 одинаковых положения лица».
  {
    if (POSE_MIX.length < 3) throw new Error('promptkit: в пуле поз меньше трёх строк, кадрам 3 и 4 нечем разойтись');
    for (const s of POSE_MIX) {
      // 35 знаков это не круглое число, а бюджет: худший карточный промпт 3165 знаков при пороге
      // 3200. Строка длиннее начнёт вылетать по длине на живых локациях, и вместо разведения позы мы
      // получим предупреждения в логе на каждом втором посте.
      if (s.length > 35) throw new Error(`promptkit: строка позы «${s.slice(0, 30)}…» длиной ${s.length}, а держим до 35: длиннее не влезает в промпт рядом с самой длинной локацией`);
      if (!s.startsWith('ПОЗА: ')) throw new Error(`promptkit: строка позы «${s.slice(0, 30)}…» не начинается с «ПОЗА: », её не найти в разборе кадра`);
    }
    if (new Set(POSE_MIX).size !== POSE_MIX.length) throw new Error('promptkit: в пуле поз есть повтор');
    const виден = new Set();
    for (let i = 0; i < 500; i++) {
      const seed = `аудит-семя-${i}`;
      const a = poseTweak(seed, 3);
      const b = poseTweak(seed, 4);
      if (a === b) throw new Error(`promptkit: на семени «${seed}» кадры 3 и 4 получили одну и ту же позу «${a}»`);
      if (poseTweak(seed, 3) !== a) throw new Error(`promptkit: раздача поз не повторяема, на семени «${seed}» второй вызов дал другое`);
      виден.add(a); виден.add(b);
    }
    // Пул обязан РАБОТАТЬ ВЕСЬ. Строка, которая не выпадает никогда, это мёртвый код, который через
    // месяц никто не проверит глазами, а числа замера рядом будут говорить, что она проверена.
    if (виден.size !== POSE_MIX.length) {
      throw new Error(`promptkit: раздача поз выдаёт только ${виден.size} строк из ${POSE_MIX.length}, остальные мёртвые`);
    }
    n++;
  }
  // ═══ РАЗДАЧА ОДЕЖДЫ: ТЕ ЖЕ ТРЕБОВАНИЯ, ЧТО У ПОЗ (приказ 11.08) ════════════════════════════
  {
    for (const [имя, пул] of Object.entries(CLOTHES)) {
      if (пул.length < 3) throw new Error(`promptkit: в пуле одежды «${имя}» меньше трёх строк, кадрам 3 и 4 нечем разойтись`);
      if (new Set(пул).size !== пул.length) throw new Error(`promptkit: в пуле одежды «${имя}» есть повтор`);
      for (const s of пул) {
        // 26 знаков это бюджет: строка встаёт в пункт 4 вместо прежнего «опрятный верх» (13 знаков),
        // то есть каждая лишняя буква съедает общий запас промпта, тот же, что и у позы.
        if (s.length > 26) throw new Error(`promptkit: одежда «${s}» длиной ${s.length}, а держим до 26`);
        // ЗАПРЕТ ВЕЧЕРНЕГО И РЕКЛАМНОГО ПРОВЕРЯЕМ КОДОМ, А НЕ ПАМЯТЬЮ: через месяц в пул допишут
        // «шёлковое платье», фильтр безопасности отклонит заказ на подростке, и виноват будет пул.
        if (/вечерн|платье|коктейль|корсет|блёстк|кожан|глянц|реклам|прозрачн|купальн|бельё/i.test(s)) {
          throw new Error(`promptkit: одежда «${s}» читается как вечерняя или рекламная, в пул такое нельзя: `
            + 'фильтр безопасности отклоняет заказ на подростке, а глянец возвращает кадр «коммерция»');
        }
      }
    }
    // Кадры 3 и 4 обязаны разойтись даже когда оба берут ОДИН пул: так бывает при PLACE_POOL=home.
    const виднаОдежда = new Set();
    for (let i = 0; i < 500; i++) {
      const seed = `аудит-одежда-${i}`;
      for (const bg of ['city', 'quiet', 'home']) {
        const a = clothesFor(seed, 3, bg);
        const b = clothesFor(seed, 4, bg);
        if (a === b) throw new Error(`promptkit: на семени «${seed}» и фоне «${bg}» кадры 3 и 4 получили одну одежду «${a}»`);
        виднаОдежда.add(a); виднаОдежда.add(b);
      }
      // Одежда НЕ обязана совпадать с позой по индексу: иначе поза A всегда шла бы с одним свитером,
      // и вместо 40 сочетаний мы получили бы 8. Проверяем, что соль работает.
      if (i === 0 && CLOTHES.city.indexOf(clothesFor(seed, 3, 'city')) === POSE_MIX.indexOf(poseTweak(seed, 3))
        && CLOTHES.home.indexOf(clothesFor(seed, 4, 'quiet')) === POSE_MIX.indexOf(poseTweak(seed, 4))) {
        throw new Error('promptkit: индексы одежды и позы совпали на обоих кадрах, соль в clothesFor не работает');
      }
    }
    const всего = CLOTHES.city.length + CLOTHES.home.length;
    if (виднаОдежда.size !== всего) {
      throw new Error(`promptkit: раздача одежды выдаёт ${виднаОдежда.size} строк из ${всего}, остальные мёртвые`);
    }
    // Одежда обязана ДОЙТИ ДО ПРОМПТА: с семенем в промпте стоит название из пула, без семени старое
    // общее «опрятный верх». Проверяем оба пути, иначе тихая потеря параметра.
    const с = lookPrompt({ template: 'img-beauty-guide', step: 3, srcHair: 'dark', hairIdx: 1,
      place: 'в кафе за столиком, на столе чашка', light: 'тёплые лампы', bgMode: 'city', poseSeed: 'проверка' });
    if (!CLOTHES.city.some((s) => с.indexOf(s) >= 0)) throw new Error('promptkit: одежда из пула не встала в промпт кадра 3');
    const без = lookPrompt({ template: 'img-beauty-guide', step: 3, srcHair: 'dark', hairIdx: 1,
      place: 'в кафе за столиком, на столе чашка', light: 'тёплые лампы', bgMode: 'city' });
    if (без.indexOf('опрятный верх') < 0) throw new Error('promptkit: без семени пропало старое поведение одежды');
    n++;
  }
  if (verbose) console.log(`promptkit: аудит пройден, проверено ${n} промптов по ${TPL.list().length} шаблонам`);
  return n;
}

// Проверка идёт НА ЗАГРУЗКЕ: сломанный промпт должен убивать процесс до заказа генерации.
audit();

module.exports = {
  KEEP, KEEP_STYLIZED, SCOPE, HUMAN, LADDER, SHOT, BAN_PARTS, HAIR_TARGETS, CARD_WHITELIST, LOOK_INTENT,
  TYPAGE, GEOM, SELFIE, APPEAL, DARE,
  // Эмоция удивления и номер кадра результата наружу: проверкам поста надо уметь сказать, на каком
  // кадре эмоция ЖДЁТСЯ, не пересобирая промпт.
  EMOTION, resultFrame,
  HAIR_LENGTHS, hairLen, hairLenByHash,
  // Пул поз и раздача наружу: гейт и разбор поста должны уметь сказать, КАКАЯ поза заказывалась
  // кадру, не пересобирая промпт целиком.
  POSE_MIX, poseTweak, seedNum,
  hairSwapLine, hairTarget, hairRetryLine, mustChangeBlock, banBlock, cardTextWhitelist, textRule, byFamily,
  PLACES, pickPlaces,
  // Гейт транспорта наружу: соседним сборщикам (onepost, fix4, refit4, addframe4) он нужен, если они
  // собирают промпт сами, а не через lookPrompt. Через lookPrompt он стоит уже внутри.
  TRANSPORT_BAN, transportHits, assertNoTransport,
  CITY_PLACES, QUIET_PLACES, CITY_BG, QUIET_BG, REAL_BG, BG_MODES, pickCityPlaces, nextQuietPlace,
  LOCATIONS: LOC, LOC_FILE,
  lookPrompt, keepFacePrompt, coverPrompt, cardPrompt, artFinalPrompt, audit,
};

// Запуск напрямую печатает промпт: `node promptkit.cjs img-beauty-guide 3 light`
if (require.main === module) {
  const t = process.argv[2] || 'img-beauty-guide';
  const st = Number(process.argv[3]) || 3;
  const hair = process.argv[4] || 'auto';
  audit({ verbose: true });
  console.log(`\n=== ${t}, кадр ${st}, волосы на исходнике «${hair}» ===\n`);
  console.log(lookPrompt({ template: t, step: st, srcHair: hair, place: pickPlaces(0).loc3 }));
}
